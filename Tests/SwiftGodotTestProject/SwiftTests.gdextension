[configuration]
entry_symbol = "swift_entry_point"
compatibility_minimum = 4.6

[libraries]
macos.debug = "res://bin/libSwiftGodotTestExtension.dylib"
macos.release = "res://bin/libSwiftGodotTestExtension.dylib"

[dependencies]
macos.debug = {"res://bin/libSwiftGodot.dylib": "", "res://bin/libSwiftGodotRuntime.dylib": ""}
macos.release = {"res://bin/libSwiftGodot.dylib": "", "res://bin/libSwiftGodotRuntime.dylib": ""}
