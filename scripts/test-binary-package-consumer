#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 || ! -f "$1/Package.swift" ]]; then
    echo "Usage: scripts/test-binary-package-consumer BINARY_PACKAGE_DIR" >&2
    exit 1
fi

binary_package_dir=$(cd "$1" && pwd)
if [[ -n ${SWIFT_GODOT_BINARY_CONSUMER_WORK_DIR:-} ]]; then
    work_dir=$SWIFT_GODOT_BINARY_CONSUMER_WORK_DIR
    mkdir -p "$work_dir"
else
    work_dir=$(mktemp -d)
    trap 'rm -rf "$work_dir"' EXIT
fi

# A stalled SwiftPM transport or dependency build must not look like a slow but
# healthy build, so every phase runs under a watchdog that fails fast and dumps
# the active toolchain processes plus the tail of that phase's verbose log. The
# bound is configurable so a measured hosted-run default can replace a guess.
phase_timeout_seconds=${SWIFT_GODOT_BINARY_CONSUMER_PHASE_TIMEOUT_SECONDS:-600}
if [[ ! $phase_timeout_seconds =~ ^[0-9]+$ || $phase_timeout_seconds -lt 1 ]]; then
    echo "SWIFT_GODOT_BINARY_CONSUMER_PHASE_TIMEOUT_SECONDS must be a positive integer" >&2
    exit 1
fi

# SwiftPM prefetches remote binary artifacts during resolution by default. The
# prefetch is what has been observed to stall on GitHub-hosted macOS runners,
# so the consumer validation can toggle it off and defer artifact transfer to
# the build phase instead. Set SWIFT_GODOT_BINARY_CONSUMER_DISABLE_PREFETCHING
# to a non-empty value to exercise that path.
if [[ -n ${SWIFT_GODOT_BINARY_CONSUMER_DISABLE_PREFETCHING:-} ]]; then
    prefetch_flag=--disable-prefetching
else
    prefetch_flag=--enable-prefetching
fi

rm -rf "$work_dir/Sources/BinaryConsumerProbe"
mkdir -p "$work_dir/Sources/BinaryConsumerProbe"
cat > "$work_dir/Package.swift" <<EOF
// swift-tools-version: 6.2
import PackageDescription

let package = Package(
    name: "BinaryConsumerProbe",
    platforms: [.macOS(.v14)],
    products: [
        .library(name: "BinaryConsumerProbe", type: .dynamic, targets: ["BinaryConsumerProbe"]),
    ],
    dependencies: [
        .package(name: "SwiftGodotBinary", path: "$binary_package_dir"),
    ],
    targets: [
        .target(
            name: "BinaryConsumerProbe",
            dependencies: [
                .product(name: "SwiftGodot", package: "SwiftGodotBinary"),
            ]
        ),
    ]
)
EOF

cat > "$work_dir/Sources/BinaryConsumerProbe/Probe.swift" <<'EOF'
import SwiftGodot

@Godot
public final class BinaryMacroProbe: Node {}

public enum BinaryConsumerProbe {
    public static let importedType = String(describing: Node.self)
}
EOF

# Prefix every line of verbose toolchain output with a UTC timestamp so a
# blocked phase can be attributed to downloading XCFrameworks, compiling
# swift-syntax, compiling the macro target, or compiling/linking the consumer.
timestamped() {
    while IFS= read -r line || [[ -n $line ]]; do
        printf '%s  %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$line"
    done
}

dump_process_state() {
    local phase=$1
    echo "--- active Swift toolchain processes during $phase ---" >&2
    # pgrep cannot report ppid/etime, so dump the process table and filter it.
    # shellcheck disable=SC2009
    ps -axo pid,ppid,etime,command 2>/dev/null | grep -Ei '[s]wift|[s]wiftc|[c]lang|[g]it|[c]url' >&2 || true
}

# Runs one validation phase in the background, streaming timestamped verbose
# output to both the job log and a capture file. If the phase exceeds
# phase_timeout_seconds the watchdog dumps the toolchain process table and the
# captured log tail and returns 124 so the failure names the blocked phase.
run_phase() {
    local phase=$1
    shift
    local log_file="$work_dir/phase-$phase.log"

    echo "PHASE BEGIN $phase: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    (
        set -o pipefail
        "$@" 2>&1 | timestamped | tee "$log_file"
        exit "${PIPESTATUS[0]}"
    ) &
    local pid=$!

    local elapsed=0
    local interval=5
    while kill -0 "$pid" 2>/dev/null; do
        sleep "$interval"
        elapsed=$((elapsed + interval))
        if [[ $elapsed -ge $phase_timeout_seconds ]]; then
            echo "PHASE TIMEOUT $phase after ${elapsed}s: $(date -u +%Y-%m-%dT%H:%M:%SZ)" >&2
            dump_process_state "$phase"
            echo "--- $phase log tail ---" >&2
            tail -n 200 "$log_file" >&2 || true
            kill "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            return 124
        fi
    done

    local status=0
    wait "$pid" || status=$?

    echo "PHASE END $phase: $(date -u +%Y-%m-%dT%H:%M:%SZ) (exit $status)"
    if [[ $status -ne 0 ]]; then
        echo "--- $phase log tail ---" >&2
        tail -n 200 "$log_file" >&2 || true
    fi
    return "$status"
}

echo "Resolving and building the remote binary package with a fresh SwiftPM cache..."
run_phase "resolve" \
    swift package resolve \
    --package-path "$work_dir" \
    --cache-path "$work_dir/cache" \
    --scratch-path "$work_dir/.build" \
    "$prefetch_flag" \
    --verbose

run_phase "build" \
    swift build \
    --package-path "$work_dir" \
    --product BinaryConsumerProbe \
    --configuration debug \
    --jobs 4 \
    --cache-path "$work_dir/cache" \
    --scratch-path "$work_dir/.build" \
    "$prefetch_flag" \
    --verbose

if otool -L "$work_dir/.build/debug/libBinaryConsumerProbe.dylib" | grep -q 'GDExtensionC'; then
    echo "GDExtensionC must remain a static build-only dependency" >&2
    exit 1
fi

echo "binary package consumer test passed"
