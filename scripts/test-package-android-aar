#!/usr/bin/env bash
set -euo pipefail

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

repo_root=$(cd "$(dirname "$0")/.." && pwd)
work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT

jni_root="$work_dir/jni"
output="$work_dir/output"
unpacked="$work_dir/unpacked"
ndk_root=${ANDROID_NDK_ROOT:-"$HOME/Library/Android/sdk/ndk/27.3.13750724"}
export ANDROID_NDK_ROOT="$ndk_root"
toolchain=$(dirname "$(find "$ndk_root/toolchains/llvm/prebuilt" -path '*/bin/llvm-readelf' -print -quit)")
[[ -d "$toolchain" ]] || fail "Android NDK toolchain not found"

cat > "$work_dir/swiftgodot.c" <<'EOF'
int swiftgodot_fixture(void) { return 42; }
EOF
cat > "$work_dir/embed.c" <<'EOF'
void swift_godot_embed_entry_point(void) {}
EOF

for target_abi in aarch64-linux-android28:arm64-v8a x86_64-linux-android28:x86_64; do
    target=${target_abi%%:*}
    abi=${target_abi##*:}
    mkdir -p "$jni_root/$abi"
    "$toolchain/${target}-clang" -shared -fPIC "$work_dir/swiftgodot.c" \
        -Wl,-soname,libSwiftGodot.so -o "$jni_root/$abi/libSwiftGodot.so"
    "$toolchain/${target}-clang" -shared -fPIC "$work_dir/embed.c" \
        -Wl,-soname,libSwiftGodotEmbed.so -o "$jni_root/$abi/libSwiftGodotEmbed.so"
done

wrong_abi="$work_dir/wrong-abi"
cp -R "$jni_root" "$wrong_abi"
cp "$jni_root/arm64-v8a/libSwiftGodot.so" "$wrong_abi/x86_64/libSwiftGodot.so"
if "$repo_root/scripts/package-android-aar" "$wrong_abi" "$work_dir/wrong-output" >"$work_dir/wrong.log" 2>&1; then
    fail "packager accepted a mismatched x86_64 library"
fi
rg -qi 'x86_64.*(architecture|machine)' "$work_dir/wrong.log" || fail "wrong-ABI diagnostic missing"

"$repo_root/scripts/package-android-aar" "$jni_root" "$output"
aar="$output/SwiftGodot-release.aar"
[[ -f "$aar" ]] || fail "release AAR missing"

mkdir -p "$unpacked"
unzip -q "$aar" -d "$unpacked"

[[ -f "$unpacked/AndroidManifest.xml" ]] || fail "AndroidManifest.xml missing"
[[ -f "$unpacked/classes.jar" ]] || fail "classes.jar missing"
[[ -f "$unpacked/jni/arm64-v8a/libSwiftGodot.so" ]] || fail "arm64-v8a SwiftGodot missing"
[[ -f "$unpacked/jni/arm64-v8a/libSwiftGodotEmbed.so" ]] || fail "arm64-v8a embed missing"
[[ -f "$unpacked/jni/x86_64/libSwiftGodot.so" ]] || fail "x86_64 SwiftGodot missing"
[[ -f "$unpacked/jni/x86_64/libSwiftGodotEmbed.so" ]] || fail "x86_64 embed missing"
[[ -f "$unpacked/assets/addons/SwiftGodot/SwiftGodotEmbed.gdextension" ]] ||
    fail "SwiftGodotEmbed.gdextension asset missing"

rg -q 'org[.]godotengine[.]plugin[.]v2[.]SwiftGodot' "$unpacked/AndroidManifest.xml" ||
    fail "Godot v2 plugin metadata missing"
unzip -l "$unpacked/classes.jar" | rg -q \
    'games/cafecito/swiftgodot/SwiftGodotPlugin[.]class' ||
    fail "compiled Kotlin initializer missing"
rg -q 'android_aar_plugin[[:space:]]*=[[:space:]]*true' \
    "$unpacked/assets/addons/SwiftGodot/SwiftGodotEmbed.gdextension" ||
    fail "gdextension does not identify an Android AAR plugin"

"$repo_root/scripts/validate-android-aar" "$aar"

second_output="$work_dir/second-output"
"$repo_root/scripts/package-android-aar" "$jni_root" "$second_output" >/dev/null
cmp "$aar" "$second_output/SwiftGodot-release.aar" || fail "AAR output is not reproducible"

bad_aar="$work_dir/wrong-architecture.aar"
cp "$jni_root/arm64-v8a/libSwiftGodot.so" "$unpacked/jni/x86_64/libSwiftGodot.so"
(cd "$unpacked" && zip -qr "$bad_aar" .)
if "$repo_root/scripts/validate-android-aar" "$bad_aar" >"$work_dir/bad-aar.log" 2>&1; then
    fail "AAR validator accepted a mismatched packaged x86_64 library"
fi
rg -qi 'x86_64.*(architecture|machine)' "$work_dir/bad-aar.log" || fail "packaged wrong-ABI diagnostic missing"

if [[ -d "$repo_root/Android/SwiftGodotPlugin/plugin/src/main/jniLibs" ]]; then
    fail "packager left generated JNI inputs in the source tree"
fi

echo "Android AAR packaging tests passed"
