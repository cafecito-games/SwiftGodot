#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: scripts/build-distribution-products

Environment:
  SWIFT_GODOT_DESTINATION              Required xcodebuild destination.
  SWIFT_GODOT_DERIVED_DATA            Required DerivedData path for distribution products.
  SWIFT_GODOT_ARCHIVE_PATH            Optional xcodebuild archive path.
  SWIFT_GODOT_GENERATION_DERIVED_DATA Optional DerivedData path for the generator build.
  SWIFT_GODOT_GENERATION_DESTINATION  Optional destination for the generator build.
  SWIFT_GODOT_RELEASE_PACKAGE_DIR     Optional temp package directory.
EOF
}

destination=${SWIFT_GODOT_DESTINATION:-}
derived_data=${SWIFT_GODOT_DERIVED_DATA:-}

if [[ -z "$destination" || -z "$derived_data" ]]; then
    usage
    exit 1
fi

archive_path=${SWIFT_GODOT_ARCHIVE_PATH:-"$derived_data/archive"}
generation_destination=${SWIFT_GODOT_GENERATION_DESTINATION:-"$destination"}
generation_derived_data=${SWIFT_GODOT_GENERATION_DERIVED_DATA:-"${derived_data}-generation"}
release_package=${SWIFT_GODOT_RELEASE_PACKAGE_DIR:-"${RUNNER_TEMP:-$(pwd)/.build}/swiftgodot-distribution-package"}

echo "Distribution destination: $destination"
echo "Distribution DerivedData: $derived_data"
echo "Generation destination: $generation_destination"
echo "Generation DerivedData: $generation_derived_data"
echo "Temporary package: $release_package"

mkdir -p "$generation_derived_data" "$derived_data" "$archive_path"

echo "Phase 1: generating SwiftGodot sources..."
xcodebuild \
    -quiet \
    -scheme SwiftGodot \
    -destination "$generation_destination" \
    -derivedDataPath "$generation_derived_data" \
    -archivePath "$archive_path"

plugin_intermediates="$generation_derived_data/Build/Intermediates.noindex/BuildToolPluginIntermediates"
runtime_gen_src=$(find "$plugin_intermediates" -type d \
    -path "*/SwiftGodotRuntime/CodeGeneratorPlugin/GeneratedSources/SwiftGodotRuntime" 2>/dev/null | head -1)
swiftgodot_gen_src=$(find "$plugin_intermediates" -type d \
    -path "*/SwiftGodot/CodeGeneratorPlugin/GeneratedSources/SwiftGodot" 2>/dev/null | head -1)

if [[ -z "$runtime_gen_src" || -z "$swiftgodot_gen_src" ]]; then
    echo "Error: Could not find CodeGeneratorPlugin output under $plugin_intermediates"
    exit 1
fi

echo "Staging temporary distribution package..."
rm -rf "$release_package"
mkdir -p "$release_package/Sources"
cp Package.distribution.swift "$release_package/Package.swift"
rsync -a --delete Sources/GDExtension "$release_package/Sources/"
rsync -a --delete --exclude "_generated" Sources/SwiftGodotRuntime "$release_package/Sources/"
rsync -a --delete --exclude "_generated" Sources/SwiftGodot "$release_package/Sources/"

mkdir -p "$release_package/Sources/SwiftGodotRuntime/_generated"
mkdir -p "$release_package/Sources/SwiftGodot/_generated"

# SwiftGodotRuntime: copy both generated/ and generated-builtin/ output files.
find "$runtime_gen_src" -name "*.swift" -exec cp {} "$release_package/Sources/SwiftGodotRuntime/_generated/" \;

# SwiftGodot: copy generated/ only. Builtins are compiled by SwiftGodotRuntime.
find "$swiftgodot_gen_src/generated" -name "*.swift" -exec cp {} "$release_package/Sources/SwiftGodot/_generated/" \;

echo "Phase 2: building distribution products..."
(
    cd "$release_package"
    xcodebuild \
        -quiet \
        -scheme SwiftGodot \
        -destination "$destination" \
        -derivedDataPath "$derived_data" \
        -archivePath "$archive_path" \
        BUILD_LIBRARY_FOR_DISTRIBUTION=YES
    xcodebuild \
        -quiet \
        -scheme SwiftGodotRuntime \
        -destination "$destination" \
        -derivedDataPath "$derived_data" \
        -archivePath "$archive_path" \
        BUILD_LIBRARY_FOR_DISTRIBUTION=YES
)
