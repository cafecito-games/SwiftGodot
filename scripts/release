#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: scripts/release TAG RELEASE_NOTES_FILE COMMIT"
    echo
    echo "Environment:"
    echo "  SWIFT_GODOT_SOURCE_REPO       GitHub source repo. Default: cafecito-games/SwiftGodot"
    echo "  SWIFT_GODOT_BINARY_REPO       GitHub binary package repo. Default: cafecito-games/SwiftGodotBinary"
    echo "  SWIFT_GODOT_BINARY_REPO_DIR   Local binary repo checkout. Default: ../SwiftGodotBinary"
    echo "  SWIFT_GODOT_BINARY_BRANCH     Binary repo branch. Default: main"
    echo "  SWIFT_GODOT_OUTPUT_DIR        Build output directory. Default: \$HOME/sg-builds"
    echo "  SWIFT_GODOT_CONFIGURATION     Distribution build configuration. Default: Release"
    echo "  SWIFT_GODOT_DERIVED_DATA      DerivedData directory to build into or package from"
    echo "  SWIFT_GODOT_SKIP_BUILD        Package prebuilt DerivedData instead of running xcodebuild"
    echo "  SWIFT_GODOT_NODEPLOY          Build the xcframework but skip GitHub release publishing"
    echo "  SWIFT_GODOT_INCLUDE_MACOS_X86 Also build a macOS x86_64 (Intel) slice"
}

if [[ $# -ne 3 ]]; then
    usage
    exit 1
fi

tag=$1
release_notes=$2
commit=$3

source_repo=${SWIFT_GODOT_SOURCE_REPO:-cafecito-games/SwiftGodot}
binary_repo=${SWIFT_GODOT_BINARY_REPO:-cafecito-games/SwiftGodotBinary}
binary_repo_dir=${SWIFT_GODOT_BINARY_REPO_DIR:-../SwiftGodotBinary}
binary_branch=${SWIFT_GODOT_BINARY_BRANCH:-main}
output_dir=${SWIFT_GODOT_OUTPUT_DIR:-$HOME/sg-builds}
configuration=${SWIFT_GODOT_CONFIGURATION:-Release}
include_macos_x86=${SWIFT_GODOT_INCLUDE_MACOS_X86:-}

if [[ ! -f "$release_notes" ]]; then
    echo "Expected a release notes file: $release_notes"
    exit 1
fi

if [[ ! -x scripts/build-distribution-products || ! -x scripts/make-swiftgodot-framework || ! -x scripts/build-macro-artifactbundle || ! -x scripts/package-godot-addon ]]; then
    echo "Expected this to run from the SwiftGodot directory"
    exit 1
fi

git rev-parse --verify "$commit^{commit}" >/dev/null

if [[ -z "${SWIFT_GODOT_NODEPLOY:-}" ]]; then
    if [[ ! -d "$binary_repo_dir/.git" ]]; then
        echo "Expected a checkout of $binary_repo at $binary_repo_dir"
        echo "Clone it with: git clone git@github.com:$binary_repo.git $binary_repo_dir"
        exit 1
    fi

    (
        cd "$binary_repo_dir"
        if ! git diff --quiet || ! git diff --cached --quiet; then
            echo "Binary repo has uncommitted changes: $binary_repo_dir"
            exit 1
        fi

        if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
            git checkout -B "$binary_branch"
        elif [[ "$(git branch --show-current)" != "$binary_branch" ]]; then
            git checkout "$binary_branch"
        fi
    )

    if git rev-parse --verify "$tag" >/dev/null 2>&1; then
        echo "Source tag already exists locally: $tag"
    else
        git tag "$tag" "$commit"
    fi
fi

arch=$(uname -m)
build_dir="$output_dir/$$-build"
derived_data=${SWIFT_GODOT_DERIVED_DATA:-$build_dir/derived}
derived_data=${derived_data%/}
archive_path="$build_dir/archive"

mkdir -p "$derived_data"
mkdir -p "$archive_path"

echo "Building in: $build_dir"
echo "DerivedData: $derived_data"
echo "ArchiveData: $archive_path"
echo "Configuration: $configuration"
echo "Commit: $commit"
echo "Source repo: $source_repo"
echo "Binary repo: $binary_repo"
start=$(date)

if [[ -z "${SWIFT_GODOT_SKIP_BUILD:-}" ]]; then
    prepared_release_package="$build_dir/distribution-prepared"

    echo "Preparing generated-source distribution package..."
    SWIFT_GODOT_DESTINATION="platform=macOS,arch=$arch" \
    SWIFT_GODOT_DERIVED_DATA="$build_dir/prepared-derived" \
    SWIFT_GODOT_CONFIGURATION="$configuration" \
    SWIFT_GODOT_GENERATION_DERIVED_DATA="$build_dir/prepared-generation" \
    SWIFT_GODOT_RELEASE_PACKAGE_DIR="$prepared_release_package" \
    SWIFT_GODOT_ARCHIVE_PATH="$archive_path" \
    SWIFT_GODOT_STAGE_ONLY=1 \
        scripts/build-distribution-products > "$build_dir/stage-package.log"

    build_distribution_products() {
        local destination=$1
        local product_derived_data=$2
        local generation_derived_data=$3
        local release_package=$4
        local log_file=$5

        echo "Building distribution products for: $destination"
        SWIFT_GODOT_DESTINATION="$destination" \
        SWIFT_GODOT_DERIVED_DATA="$product_derived_data" \
        SWIFT_GODOT_CONFIGURATION="$configuration" \
        SWIFT_GODOT_PREPARED_PACKAGE_DIR="$prepared_release_package" \
        SWIFT_GODOT_GENERATION_DERIVED_DATA="$generation_derived_data" \
        SWIFT_GODOT_RELEASE_PACKAGE_DIR="$release_package" \
        SWIFT_GODOT_ARCHIVE_PATH="$archive_path" \
        SWIFT_GODOT_ARCHS="${SWIFT_GODOT_ARCHS:-}" \
            scripts/build-distribution-products > "$log_file"
    }

    build_distribution_products \
        "platform=macOS,arch=arm64" \
        "$derived_data" \
        "$build_dir/generated-arm64" \
        "$build_dir/distribution-arm64" \
        "$build_dir/arm64.log"

    if [[ -n "$include_macos_x86" ]]; then
        build_distribution_products \
            "platform=macOS,arch=x86_64" \
            "${derived_data}_x86" \
            "$build_dir/generated-x86_64" \
            "$build_dir/distribution-x86_64" \
            "$build_dir/x86_64.log"
    fi

    build_distribution_products \
        "generic/platform=iOS" \
        "$derived_data" \
        "$build_dir/generated-ios" \
        "$build_dir/distribution-ios" \
        "$build_dir/ios_arm64.log"

    SWIFT_GODOT_ARCHS="arm64" build_distribution_products \
        "generic/platform=iOS Simulator" \
        "$derived_data" \
        "$build_dir/generated-ios-simulator" \
        "$build_dir/distribution-ios-simulator" \
        "$build_dir/ios_simulator_arm64.log"
else
    echo "Using prebuilt DerivedData from: $derived_data"
    require_prebuilt_artifact() {
        if [[ ! -e "$1" ]]; then
            echo "Missing prebuilt release artifact: $1"
            exit 1
        fi
    }

    require_prebuilt_artifact "$derived_data/Build/Products/$configuration/PackageFrameworks/SwiftGodot.framework"
    require_prebuilt_artifact "$derived_data/Build/Products/$configuration/SwiftGodot.swiftmodule"
    require_prebuilt_artifact "$derived_data/Build/Intermediates.noindex/GeneratedModuleMaps/SwiftGodot.modulemap"
    require_prebuilt_artifact "$derived_data/Build/Intermediates.noindex/GeneratedModuleMaps/SwiftGodot-Swift.h"
    if [[ -n "$include_macos_x86" ]]; then
        require_prebuilt_artifact "${derived_data}_x86/Build/Products/$configuration/PackageFrameworks/SwiftGodot.framework"
        require_prebuilt_artifact "${derived_data}_x86/Build/Products/$configuration/SwiftGodot.swiftmodule"
        require_prebuilt_artifact "${derived_data}_x86/Build/Intermediates.noindex/GeneratedModuleMaps/SwiftGodot.modulemap"
        require_prebuilt_artifact "${derived_data}_x86/Build/Intermediates.noindex/GeneratedModuleMaps/SwiftGodot-Swift.h"
    fi
    require_prebuilt_artifact "$derived_data/Build/Products/$configuration-iphoneos/PackageFrameworks/SwiftGodot.framework"
    require_prebuilt_artifact "$derived_data/Build/Products/$configuration-iphoneos/SwiftGodot.swiftmodule"
    require_prebuilt_artifact "$derived_data/Build/Intermediates.noindex/GeneratedModuleMaps-iphoneos/SwiftGodot.modulemap"
    require_prebuilt_artifact "$derived_data/Build/Intermediates.noindex/GeneratedModuleMaps-iphoneos/SwiftGodot-Swift.h"
    require_prebuilt_artifact "$derived_data/Build/Products/$configuration-iphonesimulator/PackageFrameworks/SwiftGodot.framework"
    require_prebuilt_artifact "$derived_data/Build/Products/$configuration-iphonesimulator/SwiftGodot.swiftmodule"
    require_prebuilt_artifact "$derived_data/Build/Intermediates.noindex/GeneratedModuleMaps-iphonesimulator/SwiftGodot.modulemap"
    require_prebuilt_artifact "$derived_data/Build/Intermediates.noindex/GeneratedModuleMaps-iphonesimulator/SwiftGodot-Swift.h"
fi

SWIFT_GODOT_CONFIGURATION="$configuration" scripts/make-swiftgodot-framework "$derived_data/" "$output_dir/SwiftGodot.xcframework"
addon_zip_path="$output_dir/SwiftGodot-$tag.zip"
scripts/package-godot-addon "$tag" "$output_dir/SwiftGodot.xcframework" "$output_dir" >/dev/null

if [[ -n "${SWIFT_GODOT_NODEPLOY:-}" ]]; then
    echo "Skipping deployment stage."
    exit
fi

zip_path="$output_dir/SwiftGodot.xcframework.zip"
(cd "$output_dir"; ditto -c -k --sequesterRsrc --keepParent SwiftGodot.xcframework SwiftGodot.xcframework.zip)
asset_url="https://github.com/$source_repo/releases/download/$tag/SwiftGodot.xcframework.zip"
swiftgodot_checksum=$(swift package compute-checksum "$zip_path")

scripts/build-macro-artifactbundle "$output_dir" "$tag"
macro_zip_path="$output_dir/SwiftGodotMacros.artifactbundle.zip"
macro_asset_url="https://github.com/$source_repo/releases/download/$tag/SwiftGodotMacros.artifactbundle.zip"
macro_checksum=$(swift package compute-checksum "$macro_zip_path")

gh release create "$tag" "$zip_path" "$macro_zip_path" "$addon_zip_path" -R "$source_repo" -F "$release_notes" --target "$commit"

gdextension_target_dir="$binary_repo_dir/Sources/GDExtension"
rm -rf "$gdextension_target_dir"
mkdir -p "$gdextension_target_dir/include"
cp Sources/GDExtension/GDExtension.h "$gdextension_target_dir/GDExtension.h"
cp Sources/GDExtension/GDExtensionSupport.c "$gdextension_target_dir/GDExtensionSupport.c"
cp Sources/GDExtension/include/GDExtensionSupport.h "$gdextension_target_dir/include/GDExtensionSupport.h"
cp Sources/GDExtension/include/gdextension_interface.h "$gdextension_target_dir/include/gdextension_interface.h"

# Drop any previously vendored SwiftGodotMacroLibrary sources; we now ship a
# prebuilt compiler plugin via SwiftGodotMacros.artifactbundle.zip.
rm -rf "$binary_repo_dir/Sources/SwiftGodotMacroLibrary"

# Write binaries.json so consumers can download artifacts with `gh release download`
# and place them under Binaries/ where the path-based Package.swift expects them.
cat > "$binary_repo_dir/binaries.json" <<EOF
{
  "version": "$tag",
  "sourceRepo": "$source_repo",
  "artifacts": [
    {
      "name": "SwiftGodot",
      "file": "SwiftGodot.xcframework.zip",
      "url": "$asset_url",
      "checksum": "$swiftgodot_checksum",
      "localPath": "Binaries/SwiftGodot.xcframework"
    },
    {
      "name": "SwiftGodotMacroLibrary",
      "file": "SwiftGodotMacros.artifactbundle.zip",
      "url": "$macro_asset_url",
      "checksum": "$macro_checksum",
      "localPath": "Binaries/SwiftGodotMacros.artifactbundle"
    }
  ]
}
EOF

# Ensure Binaries/ (where extracted artifacts live) is not tracked in git.
if ! grep -qxF 'Binaries/' "$binary_repo_dir/.gitignore" 2>/dev/null; then
    echo 'Binaries/' >> "$binary_repo_dir/.gitignore"
fi

cat > "$binary_repo_dir/Package.swift" <<EOF
// swift-tools-version:6.2
// The swift-tools-version declares the minimum version of Swift required to build this package.

import PackageDescription

let package = Package(
    name: "SwiftGodot",
    platforms: [
        .macOS(.v14),
        .iOS(.v17),
    ],
    products: [
        .library(
            name: "SwiftGodot",
            targets: ["SwiftGodot", "GDExtensionC", "SwiftGodotMacroLibrary"]),
    ],
    targets: [
        .binaryTarget(
            name: "SwiftGodot",
            path: "Binaries/SwiftGodot.xcframework"),
        .binaryTarget(
            name: "SwiftGodotMacroLibrary",
            path: "Binaries/SwiftGodotMacros.artifactbundle"),
        .target(
            name: "GDExtensionC",
            path: "Sources/GDExtension"),
        .testTarget(name: "SwiftGodotTests", dependencies: ["SwiftGodot", "GDExtensionC"]),
    ]
)
EOF

(
    cd "$binary_repo_dir"
    git add Package.swift Sources/GDExtension binaries.json .gitignore
    if [[ -d Sources/SwiftGodotMacroLibrary ]] || git ls-files --error-unmatch Sources/SwiftGodotMacroLibrary >/dev/null 2>&1; then
        git rm -rf --ignore-unmatch Sources/SwiftGodotMacroLibrary
    fi
    git commit -m "Update to $tag"
    git tag "$tag"
    git push -u origin "$binary_branch"
    git push origin "$tag"
)

echo "Started at: $start"
echo "Ended at: $(date)"
