#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: scripts/release TAG RELEASE_NOTES_FILE COMMIT"
    echo
    echo "Environment:"
    echo "  SWIFT_GODOT_SOURCE_REPO       GitHub source repo. Default: cafecito-games/SwiftGodot"
    echo "  SWIFT_GODOT_BINARY_REPO       GitHub binary package repo. Default: cafecito-games/SwiftGodotBinary"
    echo "  SWIFT_GODOT_BINARY_REPO_DIR   Local binary repo checkout. Default: ../SwiftGodotBinary"
    echo "  SWIFT_GODOT_BINARY_BRANCH     Binary repo branch. Default: main"
    echo "  SWIFT_GODOT_OUTPUT_DIR        Build output directory. Default: \$HOME/sg-builds"
    echo "  SWIFT_GODOT_DERIVED_DATA      DerivedData directory to build into or package from"
    echo "  SWIFT_GODOT_SKIP_BUILD        Package prebuilt DerivedData instead of running xcodebuild"
    echo "  SWIFT_GODOT_NODEPLOY          Build the xcframework but skip GitHub release publishing"
}

if [[ $# -ne 3 ]]; then
    usage
    exit 1
fi

tag=$1
release_notes=$2
commit=$3

source_repo=${SWIFT_GODOT_SOURCE_REPO:-cafecito-games/SwiftGodot}
binary_repo=${SWIFT_GODOT_BINARY_REPO:-cafecito-games/SwiftGodotBinary}
binary_repo_dir=${SWIFT_GODOT_BINARY_REPO_DIR:-../SwiftGodotBinary}
binary_branch=${SWIFT_GODOT_BINARY_BRANCH:-main}
output_dir=${SWIFT_GODOT_OUTPUT_DIR:-$HOME/sg-builds}

if [[ ! -f "$release_notes" ]]; then
    echo "Expected a release notes file: $release_notes"
    exit 1
fi

if [[ ! -x scripts/build-distribution-products || ! -x scripts/make-swiftgodot-framework ]]; then
    echo "Expected this to run from the SwiftGodot directory"
    exit 1
fi

git rev-parse --verify "$commit^{commit}" >/dev/null

case "$tag" in
    v*)
        echo "We are no longer using vXXX for releases; use 0.xx.yy instead."
        exit 1
        ;;
esac

if [[ -z "${SWIFT_GODOT_NODEPLOY:-}" ]]; then
    if [[ ! -d "$binary_repo_dir/.git" ]]; then
        echo "Expected a checkout of $binary_repo at $binary_repo_dir"
        echo "Clone it with: git clone git@github.com:$binary_repo.git $binary_repo_dir"
        exit 1
    fi

    (
        cd "$binary_repo_dir"
        if ! git diff --quiet || ! git diff --cached --quiet; then
            echo "Binary repo has uncommitted changes: $binary_repo_dir"
            exit 1
        fi

        if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
            git checkout -B "$binary_branch"
        elif [[ "$(git branch --show-current)" != "$binary_branch" ]]; then
            git checkout "$binary_branch"
        fi
    )

    if git rev-parse --verify "$tag" >/dev/null 2>&1; then
        echo "Source tag already exists locally: $tag"
    else
        git tag "$tag" "$commit"
    fi
fi

arch=$(uname -m)
build_dir="$output_dir/$$-build"
derived_data=${SWIFT_GODOT_DERIVED_DATA:-$build_dir/derived}
derived_data=${derived_data%/}
archive_path="$build_dir/archive"

mkdir -p "$derived_data"
mkdir -p "$archive_path"

echo "Building in: $build_dir"
echo "DerivedData: $derived_data"
echo "ArchiveData: $archive_path"
echo "Commit: $commit"
echo "Source repo: $source_repo"
echo "Binary repo: $binary_repo"
start=$(date)

if [[ -z "${SWIFT_GODOT_SKIP_BUILD:-}" ]]; then
    build_distribution_products() {
        local destination=$1
        local product_derived_data=$2
        local generation_derived_data=$3
        local release_package=$4
        local log_file=$5

        echo "Building distribution products for: $destination"
        SWIFT_GODOT_DESTINATION="$destination" \
        SWIFT_GODOT_DERIVED_DATA="$product_derived_data" \
        SWIFT_GODOT_GENERATION_DERIVED_DATA="$generation_derived_data" \
        SWIFT_GODOT_RELEASE_PACKAGE_DIR="$release_package" \
        SWIFT_GODOT_ARCHIVE_PATH="$archive_path" \
            scripts/build-distribution-products > "$log_file"
    }

    build_distribution_products \
        "platform=macOS,arch=x86_64" \
        "$derived_data" \
        "$build_dir/generated-x86_64" \
        "$build_dir/distribution-x86_64" \
        "$build_dir/x86_64.log"

    if [[ "$arch" = "arm64" ]]; then
        build_distribution_products \
            "platform=macOS,arch=arm64" \
            "${derived_data}_arm" \
            "$build_dir/generated-arm64" \
            "$build_dir/distribution-arm64" \
            "$build_dir/arm64.log"
    fi

    build_distribution_products \
        "generic/platform=iOS" \
        "$derived_data" \
        "$build_dir/generated-ios" \
        "$build_dir/distribution-ios" \
        "$build_dir/ios_arm64.log"
else
    echo "Using prebuilt DerivedData from: $derived_data"
    require_prebuilt_artifact() {
        if [[ ! -e "$1" ]]; then
            echo "Missing prebuilt release artifact: $1"
            exit 1
        fi
    }

    require_prebuilt_artifact "$derived_data/Build/Products/Debug/PackageFrameworks/SwiftGodot.framework"
    require_prebuilt_artifact "$derived_data/Build/Products/Debug/PackageFrameworks/SwiftGodotRuntime.framework"
    require_prebuilt_artifact "$derived_data/Build/Products/Debug/SwiftGodot.swiftmodule"
    require_prebuilt_artifact "$derived_data/Build/Products/Debug/SwiftGodotRuntime.swiftmodule"
    require_prebuilt_artifact "$derived_data/Build/Intermediates.noindex/GeneratedModuleMaps/SwiftGodot.modulemap"
    require_prebuilt_artifact "$derived_data/Build/Intermediates.noindex/GeneratedModuleMaps/SwiftGodot-Swift.h"
    require_prebuilt_artifact "$derived_data/Build/Intermediates.noindex/GeneratedModuleMaps/SwiftGodotRuntime.modulemap"
    require_prebuilt_artifact "$derived_data/Build/Intermediates.noindex/GeneratedModuleMaps/SwiftGodotRuntime-Swift.h"
    if [[ "$arch" = "arm64" ]]; then
        require_prebuilt_artifact "${derived_data}_arm/Build/Products/Debug/PackageFrameworks/SwiftGodot.framework"
        require_prebuilt_artifact "${derived_data}_arm/Build/Products/Debug/PackageFrameworks/SwiftGodotRuntime.framework"
        require_prebuilt_artifact "${derived_data}_arm/Build/Products/Debug/SwiftGodot.swiftmodule"
        require_prebuilt_artifact "${derived_data}_arm/Build/Products/Debug/SwiftGodotRuntime.swiftmodule"
        require_prebuilt_artifact "${derived_data}_arm/Build/Intermediates.noindex/GeneratedModuleMaps/SwiftGodot.modulemap"
        require_prebuilt_artifact "${derived_data}_arm/Build/Intermediates.noindex/GeneratedModuleMaps/SwiftGodot-Swift.h"
        require_prebuilt_artifact "${derived_data}_arm/Build/Intermediates.noindex/GeneratedModuleMaps/SwiftGodotRuntime.modulemap"
        require_prebuilt_artifact "${derived_data}_arm/Build/Intermediates.noindex/GeneratedModuleMaps/SwiftGodotRuntime-Swift.h"
    fi
    require_prebuilt_artifact "$derived_data/Build/Products/Debug-iphoneos/PackageFrameworks/SwiftGodot.framework"
    require_prebuilt_artifact "$derived_data/Build/Products/Debug-iphoneos/PackageFrameworks/SwiftGodotRuntime.framework"
    require_prebuilt_artifact "$derived_data/Build/Products/Debug-iphoneos/SwiftGodot.swiftmodule"
    require_prebuilt_artifact "$derived_data/Build/Products/Debug-iphoneos/SwiftGodotRuntime.swiftmodule"
    require_prebuilt_artifact "$derived_data/Build/Intermediates.noindex/GeneratedModuleMaps-iphoneos/SwiftGodot.modulemap"
    require_prebuilt_artifact "$derived_data/Build/Intermediates.noindex/GeneratedModuleMaps-iphoneos/SwiftGodot-Swift.h"
    require_prebuilt_artifact "$derived_data/Build/Intermediates.noindex/GeneratedModuleMaps-iphoneos/SwiftGodotRuntime.modulemap"
    require_prebuilt_artifact "$derived_data/Build/Intermediates.noindex/GeneratedModuleMaps-iphoneos/SwiftGodotRuntime-Swift.h"
fi

scripts/make-swiftgodot-framework "$derived_data/" "$output_dir/SwiftGodot.xcframework"

if [[ -n "${SWIFT_GODOT_NODEPLOY:-}" ]]; then
    echo "Skipping deployment stage."
    exit
fi

zip_path="$output_dir/SwiftGodot.xcframework.zip"
(cd "$output_dir"; ditto -c -k --sequesterRsrc --keepParent SwiftGodot.xcframework SwiftGodot.xcframework.zip)
checksum=$(swift package compute-checksum "$zip_path")
asset_url="https://github.com/$source_repo/releases/download/$tag/SwiftGodot.xcframework.zip"

runtime_zip_path="$output_dir/SwiftGodotRuntime.xcframework.zip"
(cd "$output_dir"; ditto -c -k --sequesterRsrc --keepParent SwiftGodotRuntime.xcframework SwiftGodotRuntime.xcframework.zip)
runtime_checksum=$(swift package compute-checksum "$runtime_zip_path")
runtime_asset_url="https://github.com/$source_repo/releases/download/$tag/SwiftGodotRuntime.xcframework.zip"

gh release create "$tag" "$zip_path" "$runtime_zip_path" -R "$source_repo" -F "$release_notes" --target "$commit"

gdextension_target_dir="$binary_repo_dir/Sources/GDExtension"
rm -rf "$gdextension_target_dir"
mkdir -p "$gdextension_target_dir/include"
cp Sources/GDExtension/GDExtension.h "$gdextension_target_dir/GDExtension.h"
cp Sources/GDExtension/GDExtensionSupport.c "$gdextension_target_dir/GDExtensionSupport.c"
cp Sources/GDExtension/include/GDExtensionSupport.h "$gdextension_target_dir/include/GDExtensionSupport.h"
cp Sources/GDExtension/include/gdextension_interface.h "$gdextension_target_dir/include/gdextension_interface.h"

macro_target_dir="$binary_repo_dir/Sources/SwiftGodotMacroLibrary"
rm -rf "$macro_target_dir"
mkdir -p "$macro_target_dir"
cp Sources/SwiftGodotMacroLibrary/*.swift "$macro_target_dir/"

cat > "$binary_repo_dir/Package.swift" <<EOF
// swift-tools-version:6.2
// The swift-tools-version declares the minimum version of Swift required to build this package.

import CompilerPluginSupport
import PackageDescription

let package = Package(
    name: "SwiftGodot",
    platforms: [
        .macOS(.v14),
        .iOS(.v17),
    ],
    products: [
        .library(
            name: "SwiftGodot",
            targets: ["SwiftGodot", "SwiftGodotRuntime", "GDExtension"]),
        .library(
            name: "SwiftGodotMacros",
            targets: ["SwiftGodotMacroLibrary"]),
    ],
    dependencies: [
        .package(url: "https://github.com/swiftlang/swift-syntax", from: "600.0.1"),
    ],
    targets: [
        .binaryTarget(
            name: "SwiftGodot",
            url: "$asset_url",
            checksum: "$checksum"),
        .binaryTarget(
            name: "SwiftGodotRuntime",
            url: "$runtime_asset_url",
            checksum: "$runtime_checksum"),
        .target(
            name: "GDExtension",
            path: "Sources/GDExtension"),
        .macro(
            name: "SwiftGodotMacroLibrary",
            dependencies: [
                .product(name: "SwiftSyntaxMacros", package: "swift-syntax"),
                .product(name: "SwiftSyntax", package: "swift-syntax"),
                .product(name: "SwiftCompilerPlugin", package: "swift-syntax"),
                .product(name: "SwiftDiagnostics", package: "swift-syntax"),
                .product(name: "SwiftParserDiagnostics", package: "swift-syntax"),
                .product(name: "SwiftParser", package: "swift-syntax"),
                .product(name: "SwiftBasicFormat", package: "swift-syntax"),
            ],
            path: "Sources/SwiftGodotMacroLibrary",
            swiftSettings: [.swiftLanguageMode(.v5)]),
        .testTarget(name: "SwiftGodotTests", dependencies: ["SwiftGodot", "SwiftGodotRuntime", "GDExtension", "SwiftGodotMacroLibrary"]),
    ]
)
EOF

(
    cd "$binary_repo_dir"
    git add Package.swift Sources/GDExtension Sources/SwiftGodotMacroLibrary
    git commit -m "Update to $tag"
    git tag "$tag"
    git push -u origin "$binary_branch"
    git push origin "$tag"
)

echo "Started at: $start"
echo "Ended at: $(date)"
