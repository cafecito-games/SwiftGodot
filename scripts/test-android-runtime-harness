#!/usr/bin/env bash
set -euo pipefail

fail() { echo "FAIL: $*" >&2; exit 1; }
repo_root=$(cd "$(dirname "$0")/.." && pwd)
runtime="$repo_root/scripts/test-android-runtime"
[[ -x "$runtime" ]] || fail "runtime harness missing"

work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT
fake_bin="$work_dir/bin"
mkdir -p "$fake_bin"

cat > "$fake_bin/godot" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[[ -z "${GODOT_FAIL:-}" ]] || exit 9
project=
install_template=0
for ((index = 1; index <= $#; index++)); do
    if [[ "${!index}" == "--path" ]]; then
        next=$((index + 1))
        project=${!next}
    elif [[ "${!index}" == "--install-android-build-template" ]]; then
        install_template=1
    fi
done
while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--export-debug" ]]; then
        [[ "$install_template" == 1 ]] || exit 8
        [[ -n "$project" ]] || exit 7
        mkdir -p "$project/android/build"
        apk=$3
        root=$(mktemp -d)
        trap 'rm -rf "$root"' EXIT
        for abi in arm64-v8a x86_64; do
            mkdir -p "$root/lib/$abi"
            for library in libSwiftGodot.so libSwiftGodotEmbed.so libAndroidTestExtension.so; do
                printf fake > "$root/lib/$abi/$library"
            done
        done
        mkdir -p "$(dirname "$apk")"
        (cd "$root" && zip -qr "$apk" .)
        exit 0
    fi
    shift
done
EOF
chmod +x "$fake_bin/godot"

cat > "$fake_bin/adb" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$*" == *"shell pidof games.cafecito.swiftgodot.runtime_test"* ]]; then
    [[ -n "${ADB_STAYS_RUNNING:-}" ]] && echo 1234 && exit 0
    exit 1
fi
if [[ "$*" == *"logcat -d"* ]]; then
    case "${ADB_SCENARIO:-success}" in
        success) echo "SWIFTGODOT_ANDROID_OK:x86_64:42" ;;
        fail) echo "SWIFTGODOT_ANDROID_FAIL: probe failed" ;;
        dlopen) echo "dlopen failed: library not found" ;;
        gdextension) echo "GDExtension initialization error" ;;
        timeout) : ;;
    esac
fi
EOF
chmod +x "$fake_bin/adb"

run_case() {
    local scenario=$1
    shift
    env SWIFT_GODOT_RUNTIME_SKIP_SETUP=1 \
        SWIFT_GODOT_GODOT_COMMAND="$fake_bin/godot" \
        SWIFT_GODOT_ADB_COMMAND="$fake_bin/adb" \
        SWIFT_GODOT_ANDROID_RUNTIME_WORK_DIR="$work_dir/run-$scenario" \
        SWIFT_GODOT_ANDROID_TIMEOUT=1 \
        SWIFT_GODOT_ANDROID_EXIT_TIMEOUT=1 \
        ADB_SCENARIO="$scenario" "$@" "$runtime" x86_64
}

run_case success >/dev/null || fail "success marker should pass"
for scenario in fail dlopen gdextension timeout; do
    if run_case "$scenario" >/dev/null 2>&1; then
        fail "$scenario scenario should fail"
    fi
done
if run_case success GODOT_FAIL=1 >/dev/null 2>&1; then
    fail "nonzero Godot export should fail"
fi
if run_case success ADB_STAYS_RUNNING=1 >/dev/null 2>&1; then
    fail "a test application that remains running should fail"
fi

rg -q 'v4\.7\.2-20260902\.2' "$runtime" || fail "custom Godot release pin missing"
rg -q '1e6bca23f4278466f9b1ab159ce869ab5a877884122a1faec6d5353c3d7744d2' "$runtime" || fail "Android template checksum missing"
rg -q 'd5c760b89da2ef01e9e19153f5fae969c058dd9f1e78d0e1a3881923e1a77b38' "$runtime" || fail "editor checksum missing"
rg -q '5ef9ae1efd521967e803935885e53fd8e620e02a2b8db6aeba3108b92dcd7238' "$runtime" || fail "Linux editor checksum missing"
rg -q '4\.7\.2\.stable\.cafecito_6b0b715d9\.ed1daf0bf' "$runtime" || fail "custom Godot version identity missing"
rg -q '120' "$runtime" || fail "bounded runtime timeout missing"
rg -q -- '--install-android-build-template' "$runtime" || fail "Gradle build template installation missing"

# The generated editor plugin is real GDScript: an unquoted heredoc would pass
# a "\t" escape through verbatim and Godot would refuse to parse the file.
plugin_dir="$work_dir/generated-addon"
mkdir -p "$plugin_dir"
sed -n '/^write_export_plugin/,/^}/p' "$runtime" > "$work_dir/write-export-plugin.sh"
# shellcheck disable=SC1091
. "$work_dir/write-export-plugin.sh"
write_export_plugin "$plugin_dir" SwiftGodot-release.aar SwiftGodot

generated="$plugin_dir/export_plugin.gd"
[[ -f "$generated" ]] || fail "generated export plugin missing"
if grep -q '[\]' "$generated"; then
    fail "generated export plugin contains a literal backslash instead of indentation"
fi
grep -Eq '^[[:space:]]+export_plugin = AndroidExportPlugin\.new\(\)$' "$generated" ||
    fail "generated export plugin body is not indented"
grep -Fq 'res://addons/SwiftGodot/bin/SwiftGodot-release.aar' "$generated" ||
    fail "generated export plugin does not contribute the AAR"
[[ -f "$plugin_dir/plugin.cfg" ]] || fail "generated plugin.cfg missing"

# The SwiftGodot AAR declares minSdk 28, so the export preset must raise
# Godot's default of 24 or the manifest merger rejects the build.
rg -q '^gradle_build/min_sdk="28"$' \
    "$repo_root/Tests/AndroidTestProject/export_presets.cfg" ||
    fail "the Android test project must export with a minimum SDK of 28"

# Godot refuses to export an Android preset unless the project opts into
# ETC2/ASTC VRAM compression.
rg -q '^textures/vram_compression/import_etc2_astc=true$' \
    "$repo_root/Tests/AndroidTestProject/project.godot" ||
    fail "the Android test project must enable ETC2/ASTC texture compression"

rg -q 'godot_template_version=4\.7\.2\.stable$' "$runtime" ||
    fail "export templates must resolve by Godot's short version"
rg -q 'android_source\.zip' "$runtime" ||
    fail "the harness must verify the Android export template landed"

echo "Android runtime harness tests passed"
