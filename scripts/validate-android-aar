#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "Usage: scripts/validate-android-aar AAR" >&2
    exit 2
fi

script_dir=$(cd "$(dirname "$0")" && pwd)
aar=$1
die() { echo "Error: $*" >&2; exit 1; }

[[ -f "$aar" ]] || die "AAR does not exist: $aar"
work_dir=$(mktemp -d)
cleanup() { rm -rf "$work_dir"; }
trap cleanup EXIT

entries=$(unzip -Z1 "$aar") || die "unable to list AAR: $aar"
duplicates=$(printf '%s\n' "$entries" | sort | uniq -d)
[[ -z "$duplicates" ]] || die "AAR contains duplicate archive paths: $duplicates"

for required in \
    AndroidManifest.xml \
    classes.jar \
    assets/addons/SwiftGodot/SwiftGodotEmbed.gdextension \
    jni/arm64-v8a/libSwiftGodot.so \
    jni/arm64-v8a/libSwiftGodotEmbed.so \
    jni/x86_64/libSwiftGodot.so \
    jni/x86_64/libSwiftGodotEmbed.so; do
    count=$(printf '%s\n' "$entries" | awk -v required="$required" '$0 == required { count++ } END { print count + 0 }')
    [[ "$count" == 1 ]] || die "AAR must contain exactly one $required; found $count"
done

while IFS= read -r abi; do
    case "$abi" in
        arm64-v8a|x86_64) ;;
        *) die "AAR contains unexpected ABI: $abi" ;;
    esac
done < <(printf '%s\n' "$entries" | sed -n 's#^jni/\([^/]*\)/.*[.]so$#\1#p' | sort -u)

unzip -q "$aar" -d "$work_dir/unpacked"
manifest="$work_dir/unpacked/AndroidManifest.xml"
gdextension="$work_dir/unpacked/assets/addons/SwiftGodot/SwiftGodotEmbed.gdextension"
rg -q 'org[.]godotengine[.]plugin[.]v2[.]SwiftGodot' "$manifest" || die "Godot v2 plugin metadata missing"
unzip -l "$work_dir/unpacked/classes.jar" | rg -q 'games/cafecito/swiftgodot/SwiftGodotPlugin[.]class' ||
    die "SwiftGodotPlugin initializer missing from classes.jar"
rg -q 'android_aar_plugin[[:space:]]*=[[:space:]]*true' "$gdextension" ||
    die "packaged GDExtension is not marked as an Android AAR plugin"
rg -q 'entry_symbol[[:space:]]*=[[:space:]]*"swift_godot_embed_entry_point"' "$gdextension" ||
    die "packaged GDExtension entry symbol is incorrect"

"$script_dir/validate-android-elf" "$work_dir/unpacked/jni"
echo "Android AAR validation passed: $aar"
