#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: scripts/make-swiftgodot-framework ROOT OUTPUT

ROOT is the DerivedData directory where Xcode generated the build products.
OUTPUT is the SwiftGodot xcframework path to write, and must end in .xcframework.
SwiftGodotRuntime.xcframework is written alongside OUTPUT.
EOF
}

if [[ $# -ne 2 ]]; then
    usage
    exit 1
fi

derived_data=${1%/}
output=${2%/}

case "$output" in
    *.xcframework)
        echo "generating $output"
        ;;
    *)
        echo "the target must end in .xcframework"
        exit 1
        ;;
esac

bd_mac="$derived_data/Build/Products/Debug"
bd_mac_arm="${derived_data}_arm/Build/Products/Debug"
bd_ios="$derived_data/Build/Products/Debug-iphoneos"
runtime_output="$(dirname "$output")/SwiftGodotRuntime.xcframework"

require_path() {
    if [[ ! -e "$1" ]]; then
        echo "Missing required release artifact: $1"
        exit 1
    fi
}

generated_metadata_file() {
    local metadata_root=$1
    local platform_suffix=$2
    local file_name=$3
    local intermediates="$metadata_root/Build/Intermediates.noindex"
    local candidate

    if [[ -n "$platform_suffix" ]]; then
        candidate="$intermediates/GeneratedModuleMaps-$platform_suffix/$file_name"
        if [[ -f "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return
        fi
    fi

    candidate="$intermediates/GeneratedModuleMaps/$file_name"
    if [[ -f "$candidate" ]]; then
        printf '%s\n' "$candidate"
        return
    fi

    candidate=$(find "$intermediates" -type f -path "*/GeneratedModuleMaps*/$file_name" 2>/dev/null | head -1)
    if [[ -n "$candidate" ]]; then
        printf '%s\n' "$candidate"
        return
    fi

    echo "Missing Xcode-generated metadata file: $file_name under $intermediates"
    exit 1
}

create_framework_layout() {
    local framework=$1

    mkdir -p "$framework/Versions/Current/Headers"
    mkdir -p "$framework/Versions/Current/Modules"
    ln -sfn Versions/Current/Headers "$framework/Headers"
    ln -sfn Versions/Current/Modules "$framework/Modules"
}

copy_module_metadata() {
    local module=$1
    local framework=$2
    local product_dir=$3
    local metadata_root=$4
    local platform_suffix=$5
    local headers_dir="$framework/Versions/Current/Headers"
    local modules_dir="$framework/Versions/Current/Modules"
    local modulemap
    local swift_header

    require_path "$product_dir/$module.swiftmodule"
    create_framework_layout "$framework"

    modulemap=$(generated_metadata_file "$metadata_root" "$platform_suffix" "$module.modulemap")
    swift_header=$(generated_metadata_file "$metadata_root" "$platform_suffix" "$module-Swift.h")

    cp "$modulemap" "$modules_dir/module.modulemap"
    cp "$swift_header" "$headers_dir/$module-Swift.h"
    rsync -a "$product_dir/$module.swiftmodule" "$modules_dir/"
}

install_swiftgodot_metadata() {
    local framework=$1
    local product_dir=$2
    local metadata_root=$3
    local platform_suffix=$4
    local slice_dir
    local modules_dir="$framework/Versions/Current/Modules"

    copy_module_metadata "SwiftGodot" "$framework" "$product_dir" "$metadata_root" "$platform_suffix"

    # SwiftGodot imports SwiftGodotRuntime. Keep the dependency module beside it,
    # matching the existing binary package layout while using Xcode's module output.
    require_path "$product_dir/SwiftGodotRuntime.swiftmodule"
    rsync -a "$product_dir/SwiftGodotRuntime.swiftmodule" "$modules_dir/"

    slice_dir=$(dirname "$framework")
    rsync -a "$product_dir/SwiftGodotRuntime.swiftmodule" "$slice_dir/"
}

install_runtime_metadata() {
    local framework=$1
    local product_dir=$2
    local metadata_root=$3
    local platform_suffix=$4

    copy_module_metadata "SwiftGodotRuntime" "$framework" "$product_dir" "$metadata_root" "$platform_suffix"
}

slice_metadata_source() {
    local slice=$1

    case "$slice" in
        ios-*)
            printf '%s|%s|iphoneos\n' "$bd_ios" "$derived_data"
            ;;
        macos-*arm64*x86_64*|macos-*x86_64*arm64*)
            echo "Unexpected universal macOS xcframework slice: $slice"
            exit 1
            ;;
        macos-*x86_64*)
            printf '%s|%s|\n' "$bd_mac" "$derived_data"
            ;;
        macos-*arm64*)
            if [[ -d "$bd_mac_arm" ]]; then
                printf '%s|%s|\n' "$bd_mac_arm" "${derived_data}_arm"
            else
                printf '%s|%s|\n' "$bd_mac" "$derived_data"
            fi
            ;;
        *)
            echo "Unsupported xcframework slice: $slice"
            exit 1
            ;;
    esac
}

rm -rf "$output" "$runtime_output"

swiftgodot_args=()
runtime_args=()

require_path "$bd_mac/PackageFrameworks/SwiftGodot.framework"
require_path "$bd_mac/PackageFrameworks/SwiftGodotRuntime.framework"
require_path "$bd_ios/PackageFrameworks/SwiftGodot.framework"
require_path "$bd_ios/PackageFrameworks/SwiftGodotRuntime.framework"

swiftgodot_args+=(-framework "$bd_mac/PackageFrameworks/SwiftGodot.framework")
runtime_args+=(-framework "$bd_mac/PackageFrameworks/SwiftGodotRuntime.framework")
if [[ -d "$bd_mac_arm/PackageFrameworks/SwiftGodot.framework" ]]; then
    swiftgodot_args+=(-framework "$bd_mac_arm/PackageFrameworks/SwiftGodot.framework")
fi
if [[ -d "$bd_mac_arm/PackageFrameworks/SwiftGodotRuntime.framework" ]]; then
    runtime_args+=(-framework "$bd_mac_arm/PackageFrameworks/SwiftGodotRuntime.framework")
fi
swiftgodot_args+=(-framework "$bd_ios/PackageFrameworks/SwiftGodot.framework")
runtime_args+=(-framework "$bd_ios/PackageFrameworks/SwiftGodotRuntime.framework")

xcodebuild -quiet -create-xcframework "${swiftgodot_args[@]}" -output "$output"
xcodebuild -quiet -create-xcframework "${runtime_args[@]}" -output "$runtime_output"

while IFS= read -r framework; do
    slice=$(basename "$(dirname "$framework")")
    IFS='|' read -r product_dir metadata_root platform_suffix <<< "$(slice_metadata_source "$slice")"
    install_swiftgodot_metadata "$framework" "$product_dir" "$metadata_root" "$platform_suffix"
done < <(find "$output" -mindepth 2 -maxdepth 2 -type d -name "SwiftGodot.framework" | sort)

while IFS= read -r framework; do
    slice=$(basename "$(dirname "$framework")")
    IFS='|' read -r product_dir metadata_root platform_suffix <<< "$(slice_metadata_source "$slice")"
    install_runtime_metadata "$framework" "$product_dir" "$metadata_root" "$platform_suffix"
done < <(find "$runtime_output" -mindepth 2 -maxdepth 2 -type d -name "SwiftGodotRuntime.framework" | sort)
