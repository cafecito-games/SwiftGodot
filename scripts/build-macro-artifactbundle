#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: scripts/build-macro-artifactbundle <output_dir> <version>

Builds SwiftGodotMacroLibrary as a universal macOS (arm64 + x86_64)
compiler-plugin executable and packages it as a SwiftPM artifact bundle
named SwiftGodotMacros.artifactbundle.zip in <output_dir>.

The result is consumed downstream via:

  .binaryTarget(
      name: "SwiftGodotMacroLibrary",
      url: ".../SwiftGodotMacros.artifactbundle.zip",
      checksum: "..."
  )

so the binary distribution ships a prebuilt macro plugin without forcing
consumers to compile swift-syntax.

Implementation note: rather than building the .macro target in the main
package (which can't be selected with --target and would build the plugin
for the host arch only), this script materializes a throwaway wrapper
package that exposes the same sources as an .executableTarget. The macro
sources already contain a manual `@main struct ...: CompilerPlugin` entry
point, so the resulting executable is a valid macro plugin and can be
built universal in one pass with `swift build --arch arm64 --arch x86_64`.
EOF
}

if [[ $# -ne 2 ]]; then
    usage >&2
    exit 1
fi

output_dir=$1
version=$2

mkdir -p "$output_dir"

if [[ "$(uname)" != "Darwin" ]]; then
    echo "This script must run on macOS (needs lipo + Apple Swift toolchain)." >&2
    exit 1
fi

repo_root=$(pwd)
macro_sources="$repo_root/Sources/SwiftGodotMacroLibrary"

if [[ ! -d "$macro_sources" ]]; then
    echo "Could not find macro sources at $macro_sources" >&2
    echo "Run this script from the SwiftGodot repository root." >&2
    exit 1
fi

scratch=".build-macro-artifact"
rm -rf "$scratch"
mkdir -p "$scratch/MacroBuilder/Sources"

# Symlink the real macro sources into the wrapper package so SwiftPM can
# resolve them through the default Sources/<TargetName> path.
ln -s "$macro_sources" "$scratch/MacroBuilder/Sources/SwiftGodotMacroLibrary"

cat > "$scratch/MacroBuilder/Package.swift" <<'EOF'
// swift-tools-version: 6.0
import PackageDescription

let package = Package(
    name: "MacroBuilder",
    platforms: [.macOS(.v14)],
    products: [
        .executable(
            name: "SwiftGodotMacroLibrary",
            targets: ["SwiftGodotMacroLibrary"]
        ),
    ],
    dependencies: [
        .package(url: "https://github.com/swiftlang/swift-syntax", from: "600.0.1"),
    ],
    targets: [
        .executableTarget(
            name: "SwiftGodotMacroLibrary",
            dependencies: [
                .product(name: "SwiftSyntaxMacros", package: "swift-syntax"),
                .product(name: "SwiftSyntax", package: "swift-syntax"),
                .product(name: "SwiftCompilerPlugin", package: "swift-syntax"),
                .product(name: "SwiftDiagnostics", package: "swift-syntax"),
                .product(name: "SwiftParserDiagnostics", package: "swift-syntax"),
                .product(name: "SwiftParser", package: "swift-syntax"),
                .product(name: "SwiftBasicFormat", package: "swift-syntax"),
            ],
            swiftSettings: [.swiftLanguageMode(.v6)]
        )
    ]
)
EOF

echo "Building SwiftGodotMacroLibrary universal (arm64 + x86_64)..."
(
    cd "$scratch/MacroBuilder"
    swift build \
        -c release \
        --arch arm64 \
        --arch x86_64 \
        --product SwiftGodotMacroLibrary
)

plugin_bin=""
for candidate in \
    "$scratch/MacroBuilder/.build/apple/Products/Release/SwiftGodotMacroLibrary" \
    "$scratch/MacroBuilder/.build/release/SwiftGodotMacroLibrary"; do
    if [[ -f "$candidate" ]]; then
        plugin_bin=$candidate
        break
    fi
done

if [[ -z "$plugin_bin" ]]; then
    echo "Could not find built SwiftGodotMacroLibrary executable under $scratch/MacroBuilder/.build" >&2
    find "$scratch/MacroBuilder/.build" -maxdepth 6 -name "SwiftGodotMacroLibrary" -type f >&2 || true
    exit 1
fi

echo "Found plugin: $plugin_bin"
lipo -info "$plugin_bin"

bundle_root="$output_dir/SwiftGodotMacros.artifactbundle"
rm -rf "$bundle_root"
mkdir -p "$bundle_root/SwiftGodotMacroLibrary-macos/bin"

cp "$plugin_bin" "$bundle_root/SwiftGodotMacroLibrary-macos/bin/SwiftGodotMacroLibrary"
chmod +x "$bundle_root/SwiftGodotMacroLibrary-macos/bin/SwiftGodotMacroLibrary"

cat > "$bundle_root/info.json" <<EOF
{
  "schemaVersion": "1.0",
  "artifacts": {
    "SwiftGodotMacroLibrary": {
      "type": "executable",
      "version": "$version",
      "variants": [
        {
          "path": "SwiftGodotMacroLibrary-macos/bin/SwiftGodotMacroLibrary",
          "supportedTriples": [
            "arm64-apple-macosx",
            "x86_64-apple-macosx"
          ]
        }
      ]
    }
  }
}
EOF

echo "Zipping artifact bundle..."
zip_path="$output_dir/SwiftGodotMacros.artifactbundle.zip"
rm -f "$zip_path"
(cd "$output_dir" && ditto -c -k --sequesterRsrc --keepParent SwiftGodotMacros.artifactbundle SwiftGodotMacros.artifactbundle.zip)

echo "Artifact bundle: $zip_path"
