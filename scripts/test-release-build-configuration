#!/usr/bin/env bash
set -euo pipefail

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

rg -q 'SWIFT_GODOT_CONFIGURATION' scripts/build-distribution-products || fail "build-distribution-products must expose SWIFT_GODOT_CONFIGURATION"
rg -q -- '-configuration "\$configuration"' scripts/build-distribution-products || fail "distribution xcodebuild must pass explicit configuration"
rg -q 'Build/Products/Release/PackageFrameworks/SwiftGodot.framework' .github/workflows/release.yml || fail "release workflow must package macOS Release products"
rg -q 'Build/Products/Release-iphoneos/PackageFrameworks/SwiftGodot.framework' .github/workflows/release.yml || fail "release workflow must package iOS Release products"
rg -q 'SWIFT_GODOT_CONFIGURATION.*Release' .github/workflows/release.yml || fail "release workflow must set SWIFT_GODOT_CONFIGURATION to Release"
rg -q 'SWIFT_GODOT_ANDROID_AAR' scripts/release .github/workflows/release.yml || fail "release path must pass the prebuilt Android AAR"
rg -q 'SwiftGodot-release\.aar' .github/workflows/release.yml || fail "release workflow must stage the publishable Android AAR"
for workflow in .github/workflows/swift.yml .github/workflows/release.yml; do
    rg -q 'SWIFT_GODOT_ANDROID_SDK_ROOT=\$sdk_root.*GITHUB_ENV' "$workflow" ||
        fail "$workflow must persist the discovered Swift Android SDK root"
    rg -q 'scripts/reclaim-android-build-space' "$workflow" ||
        fail "$workflow must reclaim disposable build space before Android export or emulation"
done

if rg -q 'Build/Products/Debug' .github/workflows/release.yml scripts/release scripts/make-swiftgodot-framework; then
    fail "release packaging should not hard-code Debug product paths"
fi

echo "release build configuration tests passed"
