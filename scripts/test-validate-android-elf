#!/usr/bin/env bash
set -euo pipefail

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

repo_root=$(cd "$(dirname "$0")/.." && pwd)
work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT

ndk_root=${ANDROID_NDK_ROOT:-"$HOME/Library/Android/sdk/ndk/27.3.13750724"}
export ANDROID_NDK_ROOT="$ndk_root"
readelf_tool=$(find "$ndk_root/toolchains/llvm/prebuilt" -path '*/bin/llvm-readelf' -print -quit)
toolchain=$(dirname "$readelf_tool")
[[ -n "$toolchain" ]] || fail "Android NDK toolchain not found"

cat > "$work_dir/swiftgodot.c" <<'EOF'
int swiftgodot_fixture(void) { return 42; }
EOF
cat > "$work_dir/embed.c" <<'EOF'
void swift_godot_embed_entry_point(void) {}
EOF
cat > "$work_dir/consumer.c" <<'EOF'
extern int swiftgodot_fixture(void);
static void local_swiftgodot_specialization(void) __asm__("$s10SwiftGodot28local_specialization_fixtureyyF");
static __attribute__((used)) void local_swiftgodot_specialization(void) {}
int consumer_fixture(void) { return swiftgodot_fixture(); }
EOF
cat > "$work_dir/plain.c" <<'EOF'
int plain_fixture(void) { return 0; }
EOF
cat > "$work_dir/host-path.c" <<'EOF'
const char *swiftgodot_source_path(void) { return "/Users/build-user/SwiftGodot/Source.swift"; }
EOF
cat > "$work_dir/consumer-with-runtime-copy.c" <<'EOF'
extern int swiftgodot_fixture(void);
void duplicate_runtime(void) __asm__("$s10SwiftGodot17duplicate_fixtureyyF");
void duplicate_runtime(void) {}
int consumer_fixture(void) { return swiftgodot_fixture(); }
EOF
cat > "$work_dir/consumer-with-local-specialization.c" <<'EOF'
extern int swiftgodot_fixture(void);
static __attribute__((used, noinline)) void local_specialization(void)
    __asm__("$s10SwiftGodot20local_specializationyyF");
static void local_specialization(void) {}
int consumer_fixture(void) {
    local_specialization();
    return swiftgodot_fixture();
}
EOF

good="$work_dir/good"
for target_abi in aarch64-linux-android28:arm64-v8a x86_64-linux-android28:x86_64; do
    target=${target_abi%%:*}
    abi=${target_abi##*:}
    compiler="$toolchain/${target}-clang"
    abi_dir="$good/$abi"
    mkdir -p "$abi_dir"
    "$compiler" -shared -fPIC "$work_dir/swiftgodot.c" \
        -Wl,-soname,libSwiftGodot.so -o "$abi_dir/libSwiftGodot.so"
    "$compiler" -shared -fPIC "$work_dir/embed.c" \
        -Wl,-soname,libSwiftGodotEmbed.so -o "$abi_dir/libSwiftGodotEmbed.so"
    "$compiler" -shared -fPIC "$work_dir/consumer.c" -L"$abi_dir" -lSwiftGodot \
        -Wl,-soname,libConsumer.so -o "$abi_dir/libConsumer.so"
done

"$repo_root/scripts/validate-android-elf" "$good" \
    "$good/arm64-v8a/libConsumer.so" "$good/x86_64/libConsumer.so"

expect_failure() {
    local pattern=$1
    shift
    local log="$work_dir/failure.log"
    if "$@" >"$log" 2>&1; then
        fail "command unexpectedly succeeded; wanted diagnostic: $pattern"
    fi
    grep -Eqi "$pattern" "$log" || {
        sed -n '1,80p' "$log" >&2
        fail "missing expected diagnostic: $pattern"
    }
}

wrong_abi="$work_dir/wrong-abi"
cp -R "$good" "$wrong_abi"
cp "$good/arm64-v8a/libSwiftGodot.so" "$wrong_abi/x86_64/libSwiftGodot.so"
expect_failure 'x86_64.*(architecture|machine)' \
    "$repo_root/scripts/validate-android-elf" "$wrong_abi"

missing_entry="$work_dir/missing-entry"
cp -R "$good" "$missing_entry"
"$toolchain/aarch64-linux-android28-clang" -shared -fPIC "$work_dir/plain.c" \
    -Wl,-soname,libSwiftGodotEmbed.so -o "$missing_entry/arm64-v8a/libSwiftGodotEmbed.so"
expect_failure 'swift_godot_embed_entry_point' \
    "$repo_root/scripts/validate-android-elf" "$missing_entry"

missing_soname="$work_dir/missing-soname"
cp -R "$good" "$missing_soname"
"$toolchain/aarch64-linux-android28-clang" -shared -fPIC "$work_dir/swiftgodot.c" \
    -o "$missing_soname/arm64-v8a/libSwiftGodot.so"
expect_failure 'SONAME' "$repo_root/scripts/validate-android-elf" "$missing_soname"

missing_dependency="$work_dir/missing-dependency"
cp -R "$good" "$missing_dependency"
"$toolchain/aarch64-linux-android28-clang" -shared -fPIC "$work_dir/plain.c" \
    -Wl,-soname,libMissing.so -o "$work_dir/libMissing.so"
"$toolchain/aarch64-linux-android28-clang" -shared -fPIC "$work_dir/consumer.c" \
    -L"$work_dir" -Wl,--no-as-needed -lMissing -Wl,-soname,libBroken.so \
    -o "$missing_dependency/arm64-v8a/libBroken.so"
expect_failure 'libMissing[.]so' \
    "$repo_root/scripts/validate-android-elf" "$missing_dependency"

consumer_without_runtime="$work_dir/consumer-without-runtime.so"
"$toolchain/aarch64-linux-android28-clang" -shared -fPIC "$work_dir/plain.c" \
    -Wl,-soname,libConsumerWithoutRuntime.so -o "$consumer_without_runtime"
expect_failure 'libSwiftGodot[.]so' \
    "$repo_root/scripts/validate-android-elf" "$good" "$consumer_without_runtime"

consumer_with_runtime_copy="$work_dir/consumer-with-runtime-copy.so"
"$toolchain/aarch64-linux-android28-clang" -shared -fPIC \
    "$work_dir/consumer-with-runtime-copy.c" -L"$good/arm64-v8a" -lSwiftGodot \
    -Wl,-soname,libConsumerWithRuntimeCopy.so -o "$consumer_with_runtime_copy"
expect_failure 'defines SwiftGodot runtime symbols' \
    "$repo_root/scripts/validate-android-elf" "$good" "$consumer_with_runtime_copy"

consumer_with_local_specialization="$work_dir/consumer-with-local-specialization.so"
"$toolchain/aarch64-linux-android28-clang" -shared -fPIC \
    "$work_dir/consumer-with-local-specialization.c" -L"$good/arm64-v8a" -lSwiftGodot \
    -Wl,-soname,libConsumerWithLocalSpecialization.so \
    -o "$consumer_with_local_specialization"
"$repo_root/scripts/validate-android-elf" "$good" "$consumer_with_local_specialization"

unexpected_abi="$work_dir/unexpected-abi"
cp -R "$good" "$unexpected_abi"
mkdir -p "$unexpected_abi/armeabi-v7a"
cp "$good/arm64-v8a/libSwiftGodot.so" "$unexpected_abi/armeabi-v7a/"
expect_failure 'unexpected ABI' "$repo_root/scripts/validate-android-elf" "$unexpected_abi"

debug_binary="$work_dir/debug-binary"
cp -R "$good" "$debug_binary"
"$toolchain/aarch64-linux-android28-clang" -shared -fPIC -g "$work_dir/swiftgodot.c" \
    -Wl,-soname,libSwiftGodot.so -o "$debug_binary/arm64-v8a/libSwiftGodot.so"
expect_failure 'debug sections' "$repo_root/scripts/validate-android-elf" "$debug_binary"
"$repo_root/scripts/strip-android-elf" "$debug_binary"
"$repo_root/scripts/validate-android-elf" "$debug_binary" \
    "$debug_binary/arm64-v8a/libConsumer.so" "$debug_binary/x86_64/libConsumer.so"

host_path_binary="$work_dir/host-path-binary"
cp -R "$good" "$host_path_binary"
"$toolchain/aarch64-linux-android28-clang" -shared -fPIC "$work_dir/host-path.c" \
    -Wl,-soname,libSwiftGodot.so -o "$host_path_binary/arm64-v8a/libSwiftGodot.so"
expect_failure 'build-host path' "$repo_root/scripts/validate-android-elf" "$host_path_binary"

single_abi="$work_dir/single-abi"
mkdir -p "$single_abi"
cp -R "$good/x86_64" "$single_abi/"
SWIFT_GODOT_ANDROID_ABIS=x86_64 "$repo_root/scripts/validate-android-elf" "$single_abi" \
    "$single_abi/x86_64/libConsumer.so"
expect_failure 'missing ABI directory: arm64-v8a' \
    "$repo_root/scripts/validate-android-elf" "$single_abi"
expect_failure 'unexpected ABI directory: x86_64' \
    env SWIFT_GODOT_ANDROID_ABIS=arm64-v8a "$repo_root/scripts/validate-android-elf" "$single_abi"

echo "Android ELF validation tests passed"
