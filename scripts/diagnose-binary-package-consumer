#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo "Usage: scripts/diagnose-binary-package-consumer TAG [SOURCE_REPO]" >&2
    exit 1
fi

tag=$1
source_repo=${2:-cafecito-games/SwiftGodot}
work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT

artifact_record() {
    local name=$1
    local file=$2
    local digest checksum url
    digest=$(gh release view "$tag" --repo "$source_repo" --json assets --jq \
        ".assets[] | select(.name == \"$file\") | .digest")
    checksum=${digest#sha256:}
    if [[ $checksum == "$digest" || ! $checksum =~ ^[0-9a-f]{64}$ ]]; then
        echo "Release $source_repo@$tag has no usable SHA-256 digest for $file" >&2
        exit 1
    fi
    url="https://github.com/$source_repo/releases/download/$tag/$file"
    jq -n \
        --arg name "$name" \
        --arg file "$file" \
        --arg url "$url" \
        --arg checksum "$checksum" \
        '{name: $name, file: $file, url: $url, checksum: $checksum}'
}

artifact_record SwiftGodot SwiftGodot.xcframework.zip > "$work_dir/swiftgodot.json"
artifact_record GDExtensionC GDExtensionC.xcframework.zip > "$work_dir/gdextension.json"
artifact_record SwiftGodotMacroLibrary SwiftGodotMacros.artifactbundle.zip > "$work_dir/macros.json"
artifacts=$(jq -s '.' "$work_dir/swiftgodot.json" "$work_dir/gdextension.json" "$work_dir/macros.json")

swiftgodot_url=$(jq -r '.[] | select(.name == "SwiftGodot") | .url' <<< "$artifacts")
swiftgodot_checksum=$(jq -r '.[] | select(.name == "SwiftGodot") | .checksum' <<< "$artifacts")
gdextension_url=$(jq -r '.[] | select(.name == "GDExtensionC") | .url' <<< "$artifacts")
gdextension_checksum=$(jq -r '.[] | select(.name == "GDExtensionC") | .checksum' <<< "$artifacts")
macro_url=$(jq -r '.[] | select(.name == "SwiftGodotMacroLibrary") | .url' <<< "$artifacts")
macro_checksum=$(jq -r '.[] | select(.name == "SwiftGodotMacroLibrary") | .checksum' <<< "$artifacts")

cat > "$work_dir/Package.swift" <<EOF
// swift-tools-version:6.2
import PackageDescription

let package = Package(
    name: "SwiftGodot",
    platforms: [
        .macOS(.v14),
        .iOS(.v17),
    ],
    products: [
        .library(
            name: "SwiftGodot",
            targets: ["SwiftGodot", "GDExtensionC", "SwiftGodotMacroLibrary"]),
    ],
    targets: [
        .binaryTarget(
            name: "SwiftGodot",
            url: "$swiftgodot_url",
            checksum: "$swiftgodot_checksum"),
        .binaryTarget(
            name: "GDExtensionC",
            url: "$gdextension_url",
            checksum: "$gdextension_checksum"),
        .binaryTarget(
            name: "SwiftGodotMacroLibrary",
            url: "$macro_url",
            checksum: "$macro_checksum"),
    ]
)
EOF

echo "Full binary consumer diagnostic started: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
scripts/test-binary-package-consumer "$work_dir"
echo "Full binary consumer diagnostic completed: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
