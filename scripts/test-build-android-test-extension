#!/usr/bin/env bash
set -euo pipefail

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

repo_root=$(cd "$(dirname "$0")/.." && pwd)
builder="$repo_root/scripts/build-android-test-extension"
packager="$repo_root/scripts/package-android-test-aar"

[[ -x "$builder" ]] || fail "build-android-test-extension must exist and be executable"
[[ -x "$packager" ]] || fail "package-android-test-aar must exist and be executable"
rg -q 'name: "AndroidTestExtension"' "$repo_root/Package.swift" || fail "AndroidTestExtension dynamic product missing"
rg -q 'type: \.dynamic' "$repo_root/Package.swift" || fail "AndroidTestExtension must be a dynamic product"
rg -q '#initSwiftExtension\(cdecl: "swiftgodot_android_test_entry"' "$repo_root/Sources/AndroidTestExtension/AndroidTestExtension.swift" || fail "test extension entry point missing"
rg -q 'SWIFTGODOT_ANDROID_OK:' "$repo_root/Sources/AndroidTestExtension/AndroidTestExtension.swift" || fail "runtime success marker missing"
rg -q 'include\(":test-plugin"\)' "$repo_root/Android/SwiftGodotPlugin/settings.gradle.kts" || fail "test plugin Gradle module missing"
rg -q 'consumer_package="\$work_dir/consumer-package"' "$builder" || fail "consumer package must not collide with the staged package identity"

work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT

fake_bin="$work_dir/bin"
android_home="$work_dir/android-sdk"
ndk_root="$android_home/ndk/27.3.13750724"
runtime_root="$work_dir/runtime"
staged_package="$work_dir/staged-package"
mkdir -p "$fake_bin" "$ndk_root" "$staged_package/Sources/GDExtension/include"
printf '%s\n' 'Pkg.Revision = 27.3.13750724' > "$ndk_root/source.properties"
printf '%s\n' '// swift-tools-version: 6.3' > "$staged_package/Package.swift"
printf '%s\n' '/* fake header */' > "$staged_package/Sources/GDExtension/include/gdextension_interface.h"

for abi in arm64-v8a x86_64; do
    mkdir -p \
        "$runtime_root/jni/$abi" \
        "$work_dir/distribution/build/$abi/release/Modules" \
        "$work_dir/distribution/build/$abi/release/GDExtensionC.build"
    printf 'fake SwiftGodot ELF\n' > "$runtime_root/jni/$abi/libSwiftGodot.so"
    printf 'fake swiftmodule\n' > "$work_dir/distribution/build/$abi/release/Modules/SwiftGodot.swiftmodule"
    printf 'module GDExtensionC {}\n' > "$work_dir/distribution/build/$abi/release/GDExtensionC.build/module.modulemap"
done

fake_macro_plugin="$work_dir/SwiftGodotMacroLibrary-tool"
printf '#!/usr/bin/env bash\nexit 0\n' > "$fake_macro_plugin"
chmod +x "$fake_macro_plugin"

cat > "$fake_bin/swift" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%q ' "$@" >> "$SWIFT_TEST_LOG"
printf '\n' >> "$SWIFT_TEST_LOG"
if [[ "${1:-}" == "--version" ]]; then
    echo "Swift version 6.3.3 (swift-6.3.3-RELEASE)"
    exit 0
fi
if [[ "${1:-} ${2:-}" == "sdk list" ]]; then
    echo "swift-6.3.3-RELEASE_android"
    exit 0
fi
scratch=
product=
target=
configuration=release
while [[ $# -gt 0 ]]; do
    case "$1" in
        --scratch-path) scratch=$2; shift 2 ;;
        --product) product=$2; shift 2 ;;
        --target) target=$2; shift 2 ;;
        -c) configuration=$2; shift 2 ;;
        *) shift ;;
    esac
done
if [[ -n "$scratch" && "$product" == "AndroidTestExtension" ]]; then
    mkdir -p "$scratch/$configuration"
    printf 'fake consumer ELF\n' > "$scratch/$configuration/libAndroidTestExtension.so"
elif [[ -n "$scratch" && "$target" == "HostStub" ]]; then
    mkdir -p "$scratch/debug"
    printf '#!/usr/bin/env bash\nexit 0\n' > "$scratch/debug/SwiftGodotMacroLibrary-tool"
    chmod +x "$scratch/debug/SwiftGodotMacroLibrary-tool"
fi
EOF
chmod +x "$fake_bin/swift"

cat > "$fake_bin/java" <<'EOF'
#!/usr/bin/env bash
echo 'openjdk version "17.0.12"' >&2
EOF
chmod +x "$fake_bin/java"

cat > "$fake_bin/gradle" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%q ' "$@" >> "$GRADLE_TEST_LOG"
printf '\n' >> "$GRADLE_TEST_LOG"
module=test-plugin
mkdir -p "$module/build/outputs/aar"
archive_root=$(mktemp -d)
trap 'rm -rf "$archive_root"' EXIT
mkdir -p "$archive_root/jni" "$archive_root/assets/addons/SwiftGodotAndroidTest"
cp -R "$module/src/main/jniLibs/." "$archive_root/jni/"
cp "$module/src/main/assets/addons/SwiftGodotAndroidTest/SwiftGodotAndroidTest.gdextension" \
    "$archive_root/assets/addons/SwiftGodotAndroidTest/"
printf '<manifest/>\n' > "$archive_root/AndroidManifest.xml"
(cd "$archive_root" && zip -qr "$OLDPWD/$module/build/outputs/aar/SwiftGodotAndroidTest-release.aar" .)
EOF
chmod +x "$fake_bin/gradle"

export PATH="$fake_bin:$PATH"
export SWIFT_TEST_LOG="$work_dir/swift.log"
export GRADLE_TEST_LOG="$work_dir/gradle.log"
export ANDROID_HOME="$android_home"
export ANDROID_NDK_ROOT="$ndk_root"
export SWIFT_GODOT_ANDROID_PACKAGE="$staged_package"
export SWIFT_GODOT_ANDROID_LIBRARIES="$runtime_root"
export SWIFT_GODOT_ANDROID_MACRO_PLUGIN="$fake_macro_plugin"
export SWIFT_GODOT_ANDROID_TEST_WORK_DIR="$work_dir/build"
export SWIFT_GODOT_ANDROID_WORK_DIR="$work_dir/distribution"
export SWIFT_GODOT_GRADLE_COMMAND="$fake_bin/gradle"
export SWIFT_GODOT_SKIP_ELF_VALIDATION=1

output="$work_dir/output"
"$builder" "$output"

for expected in \
    'build .* -c release --swift-sdk aarch64-unknown-linux-android28 --product AndroidTestExtension' \
    'build .* -c release --swift-sdk x86_64-unknown-linux-android28 --product AndroidTestExtension'
do
    grep -Eq "$expected" "$SWIFT_TEST_LOG" || fail "missing Swift invocation matching: $expected"
done

if grep -Eq -- '--target HostStub' "$SWIFT_TEST_LOG"; then
    fail "a prebuilt macro plugin must skip rebuilding SwiftGodotMacroLibrary"
fi

consumer_manifest="$work_dir/build/consumer-package/Package.swift"
if rg -q '"SwiftGodotAndroid"|swift-syntax|dependencies:' "$consumer_manifest"; then
    fail "consumer manifest must not declare external package dependencies"
fi
rg -q -- '-load-plugin-executable' "$consumer_manifest" || fail "consumer manifest must load the host macro plugin"
rg -q -- '-lSwiftGodot' "$consumer_manifest" || fail "consumer manifest must link against libSwiftGodot.so"

for abi in arm64-v8a x86_64; do
    consumer="$output/jni/$abi/libAndroidTestExtension.so"
    [[ -f "$consumer" ]] || fail "missing test extension for $abi"
    [[ ! -e "$output/jni/$abi/libSwiftGodot.so" ]] || fail "test extension output must not own libSwiftGodot.so"
done
# The consumer needs its own scratch path; sharing the runtime one makes
# SwiftPM reuse a build description that has no AndroidTestExtension target.
for abi in arm64-v8a x86_64; do
    grep -Fq -- "--scratch-path $work_dir/build/build/$abi" "$SWIFT_TEST_LOG" ||
        fail "consumer build for $abi must use its own scratch path"
    if grep -Fq -- "--scratch-path $work_dir/distribution/build/$abi" "$SWIFT_TEST_LOG"; then
        fail "consumer build for $abi must not reuse the runtime scratch path"
    fi
done

[[ ! -s "$GRADLE_TEST_LOG" ]] || fail "the per-ABI builder must not assemble the test AAR"
[[ ! -e "$output/SwiftGodotAndroidTest-release.aar" ]] || fail "the per-ABI builder must not emit an AAR"

# Without SWIFT_GODOT_ANDROID_MACRO_PLUGIN, the builder builds the host macro
# plugin on demand and populates its cache when configured.
macro_cache="$work_dir/macro-cache/SwiftGodotMacroLibrary-tool"
: > "$SWIFT_TEST_LOG"
env -u SWIFT_GODOT_ANDROID_MACRO_PLUGIN \
    SWIFT_GODOT_ANDROID_MACRO_WORK_DIR="$work_dir/macro-build" \
    SWIFT_GODOT_ANDROID_MACRO_PLUGIN_CACHE="$macro_cache" \
    SWIFT_GODOT_ANDROID_ABIS=x86_64 \
    "$builder" "$work_dir/fallback-output" >"$work_dir/fallback.log" 2>&1 ||
    fail "fallback host macro plugin build failed: $(cat "$work_dir/fallback.log")"
grep -Eq -- '--target HostStub' "$SWIFT_TEST_LOG" ||
    fail "fallback build must compile SwiftGodotMacroLibrary on the host"
[[ -x "$macro_cache" ]] || fail "host macro plugin build must populate its cache"

: > "$SWIFT_TEST_LOG"
SWIFT_GODOT_ANDROID_MACRO_WORK_DIR="$work_dir/macro-build-hit" \
    SWIFT_GODOT_ANDROID_MACRO_PLUGIN_CACHE="$macro_cache" \
    "$repo_root/scripts/build-android-macro-plugin" "$work_dir/cached-plugin/SwiftGodotMacroLibrary-tool" \
    >"$work_dir/macro-hit.log" 2>&1 ||
    fail "cached host macro plugin restore failed: $(cat "$work_dir/macro-hit.log")"
if grep -Eq -- '--target HostStub' "$SWIFT_TEST_LOG"; then
    fail "a populated host macro plugin cache must skip rebuilding SwiftGodotMacroLibrary"
fi
[[ -x "$work_dir/cached-plugin/SwiftGodotMacroLibrary-tool" ]] ||
    fail "cached host macro plugin was not staged"

single_abi_output="$work_dir/single-abi-output"
: > "$SWIFT_TEST_LOG"
SWIFT_GODOT_ANDROID_ABIS=x86_64 "$builder" "$single_abi_output" >"$work_dir/single-abi.log" 2>&1 ||
    fail "single-ABI test extension build failed: $(cat "$work_dir/single-abi.log")"
grep -Eq 'build .* --swift-sdk x86_64-unknown-linux-android28 --product AndroidTestExtension' "$SWIFT_TEST_LOG" ||
    fail "single-ABI build must cross-compile the selected ABI"
if grep -Eq -- '--swift-sdk aarch64-unknown-linux-android28' "$SWIFT_TEST_LOG"; then
    fail "single-ABI build must not cross-compile unselected ABIs"
fi
[[ ! -e "$single_abi_output/jni/arm64-v8a" ]] || fail "single-ABI build leaked an unselected ABI directory"

mkdir -p \
    "$work_dir/distribution/build/x86_64/debug/Modules" \
    "$work_dir/distribution/build/x86_64/debug/GDExtensionC.build"
printf 'fake debug swiftmodule\n' > "$work_dir/distribution/build/x86_64/debug/Modules/SwiftGodot.swiftmodule"
printf 'module GDExtensionC {}\n' > "$work_dir/distribution/build/x86_64/debug/GDExtensionC.build/module.modulemap"
debug_output="$work_dir/debug-consumer-output"
: > "$SWIFT_TEST_LOG"
SWIFT_GODOT_ANDROID_CONFIGURATION=debug SWIFT_GODOT_ANDROID_ABIS=x86_64 \
    "$builder" "$debug_output" >"$work_dir/debug-consumer.log" 2>&1 ||
    fail "debug consumer build failed: $(cat "$work_dir/debug-consumer.log")"
grep -Eq 'build .* -c debug --swift-sdk x86_64-unknown-linux-android28 --product AndroidTestExtension' "$SWIFT_TEST_LOG" ||
    fail "debug consumer build must pass -c debug to swift build"
[[ -f "$debug_output/jni/x86_64/libAndroidTestExtension.so" ]] || fail "debug consumer build did not stage x86_64"

packaged="$work_dir/packaged"
"$packager" "$output/jni" "$packaged"

grep -Eq 'test-plugin:assembleRelease' "$GRADLE_TEST_LOG" || fail "packager must assemble the test plugin"

aar="$packaged/SwiftGodotAndroidTest-release.aar"
[[ -f "$aar" ]] || fail "test extension AAR missing"
aar_entries=$(unzip -Z1 "$aar")
for abi in arm64-v8a x86_64; do
    grep -Fxq "jni/$abi/libAndroidTestExtension.so" <<< "$aar_entries" || fail "AAR missing $abi test extension"
    if grep -Fxq "jni/$abi/libSwiftGodot.so" <<< "$aar_entries"; then
        fail "test extension AAR must not package SwiftGodot for $abi"
    fi
done

partial_log="$work_dir/partial.log"
if SWIFT_GODOT_ANDROID_ABIS=x86_64 "$packager" "$single_abi_output/jni" "$work_dir/partial-packaged" \
    >"$partial_log" 2>&1; then
    fail "packager unexpectedly accepted a single-ABI consumer tree"
fi
grep -q 'missing test extension for arm64-v8a' "$partial_log" ||
    fail "packager must reject a consumer tree that is missing an ABI"

if [[ -d "$repo_root/Android/SwiftGodotPlugin/test-plugin/src/main/jniLibs" ]]; then
    fail "packager left generated JNI inputs in the source tree"
fi

rg -qF 'validate-android-elf" "$validation_root" "${consumers[@]}"' "$builder" || fail "builder must validate the test extension as a dynamic consumer"
rg -q 'strip-android-elf.*output_dir/jni' "$builder" || fail "builder must strip the Android consumer before validation"
rg -qF 'validate-android-elf" "$validation_root" "${consumers[@]}"' "$packager" || fail "packager must validate the combined ABI closure"
rg -q 'SWIFTGODOT_ANDROID_FAIL' "$repo_root/Tests/AndroidTestProject/main.gd" || fail "Godot fixture failure marker missing"
rg -q 'SWIFTGODOT_ANDROID_OK:' "$repo_root/Tests/AndroidTestProject/main.gd" || fail "Godot fixture success marker missing"

echo "Android test extension build tests passed"
