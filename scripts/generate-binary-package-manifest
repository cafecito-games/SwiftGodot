#!/usr/bin/env python3
"""Generate the remotely consumable SwiftGodotBinary Package.swift."""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import sys
import tempfile


EXPECTED_ARTIFACTS = {
    "SwiftGodot": "SwiftGodot.xcframework.zip",
    "GDExtensionC": "GDExtensionC.xcframework.zip",
}


def fail(message: str) -> "NoReturn":
    raise SystemExit(f"error: {message}")


def load_metadata(path: Path) -> tuple[str, str, dict[str, dict[str, str]]]:
    try:
        value = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        fail(f"could not read valid metadata from {path}: {error}")

    if not isinstance(value, dict):
        fail("metadata root must be an object")

    version = value.get("version")
    source_repo = value.get("sourceRepo")
    artifacts = value.get("artifacts")
    macro_sources = value.get("macroSources")
    if not isinstance(version, str) or not re.fullmatch(r"v[0-9]+\.[0-9]+\.[0-9]+", version):
        fail("version must be a stable vMAJOR.MINOR.PATCH tag")
    if not isinstance(source_repo, str) or not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", source_repo):
        fail("sourceRepo must be an owner/repository name")
    if not isinstance(artifacts, list):
        fail("artifacts must be an array")
    if not isinstance(macro_sources, dict):
        fail("macroSources must be an object")
    if macro_sources.get("path") != "Sources/SwiftGodotMacroLibrary":
        fail("macroSources.path must be Sources/SwiftGodotMacroLibrary")
    source_commit = macro_sources.get("sourceCommit")
    if not isinstance(source_commit, str) or not re.fullmatch(r"[0-9a-f]{40}", source_commit):
        fail("macroSources.sourceCommit must be a full lowercase Git commit")

    indexed: dict[str, dict[str, str]] = {}
    for artifact in artifacts:
        if not isinstance(artifact, dict) or not isinstance(artifact.get("name"), str):
            fail("each artifact must be an object with a name")
        name = artifact["name"]
        if name in indexed:
            fail(f"duplicate artifact: {name}")
        indexed[name] = artifact

    if set(indexed) != set(EXPECTED_ARTIFACTS):
        missing = sorted(set(EXPECTED_ARTIFACTS) - set(indexed))
        unexpected = sorted(set(indexed) - set(EXPECTED_ARTIFACTS))
        fail(f"artifact set mismatch; missing={missing}, unexpected={unexpected}")

    for name, expected_file in EXPECTED_ARTIFACTS.items():
        artifact = indexed[name]
        expected_url = f"https://github.com/{source_repo}/releases/download/{version}/{expected_file}"
        if artifact.get("file") != expected_file:
            fail(f"{name} file must be {expected_file}")
        if artifact.get("url") != expected_url:
            fail(f"{name} URL must be {expected_url}")
        checksum = artifact.get("checksum")
        if not isinstance(checksum, str) or not re.fullmatch(r"[0-9a-f]{64}", checksum):
            fail(f"{name} checksum must be 64 lowercase hexadecimal characters")

    return version, source_repo, indexed


def render(artifacts: dict[str, dict[str, str]]) -> str:
    target_blocks = []
    for name in EXPECTED_ARTIFACTS:
        artifact = artifacts[name]
        target_blocks.append(
            "        .binaryTarget(\n"
            f'            name: "{name}",\n'
            f'            url: "{artifact["url"]}",\n'
            f'            checksum: "{artifact["checksum"]}"),'
        )

    targets = "\n".join(target_blocks)
    return f'''// swift-tools-version:6.2
// Generated by cafecito-games/SwiftGodot scripts/release. Do not edit by hand.

import CompilerPluginSupport
import PackageDescription

let package = Package(
    name: "SwiftGodot",
    platforms: [
        .macOS(.v14),
        .iOS(.v17),
    ],
    products: [
        .library(
            name: "SwiftGodot",
            targets: ["SwiftGodot", "GDExtensionC", "SwiftGodotMacroLibrary"]),
    ],
    dependencies: [
        .package(url: "https://github.com/swiftlang/swift-syntax", from: "600.0.1"),
    ],
    targets: [
{targets}
        .macro(
            name: "SwiftGodotMacroLibrary",
            dependencies: [
                .product(name: "SwiftSyntaxMacros", package: "swift-syntax"),
                .product(name: "SwiftSyntax", package: "swift-syntax"),
                .product(name: "SwiftCompilerPlugin", package: "swift-syntax"),
                .product(name: "SwiftDiagnostics", package: "swift-syntax"),
                .product(name: "SwiftParserDiagnostics", package: "swift-syntax"),
                .product(name: "SwiftParser", package: "swift-syntax"),
                .product(name: "SwiftBasicFormat", package: "swift-syntax"),
            ],
            swiftSettings: [.swiftLanguageMode(.v6)]),
    ]
)
'''


def main() -> None:
    if len(sys.argv) != 3:
        fail("usage: generate-binary-package-manifest BINARIES_JSON PACKAGE_SWIFT")

    metadata_path = Path(sys.argv[1]).resolve()
    output_path = Path(sys.argv[2]).resolve()
    _, _, artifacts = load_metadata(metadata_path)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{output_path.name}.", dir=output_path.parent)
    try:
        with os.fdopen(descriptor, "w") as temporary:
            temporary.write(render(artifacts))
        os.replace(temporary_name, output_path)
    except BaseException:
        try:
            os.unlink(temporary_name)
        except FileNotFoundError:
            pass
        raise


if __name__ == "__main__":
    main()
