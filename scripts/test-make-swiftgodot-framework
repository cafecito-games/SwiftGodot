#!/usr/bin/env bash
set -euo pipefail

script="scripts/make-swiftgodot-framework"
release_workflow=".github/workflows/release.yml"
release_script="scripts/release"

if rg -q 'cat > .*SwiftGodot-Swift\.h|Generated by Apple Swift version|cat > .*module\.modulemap' "$script"; then
    echo "make-swiftgodot-framework still handcrafts Swift header or modulemap metadata"
    exit 1
fi

if rg -q 'sh scripts/make-swiftgodot-framework' "$release_script"; then
    echo "release script must execute make-swiftgodot-framework with its Bash shebang"
    exit 1
fi

for required in \
    "GeneratedModuleMaps" \
    "module-Swift.h" \
    "module.modulemap" \
    'stage_module_metadata "SwiftGodot"' \
    "SwiftGodotRuntime.swiftmodule" \
    "merge_swift_headers" \
    "lipo -create"
do
    if ! rg -q "$required" "$script"; then
        echo "make-swiftgodot-framework does not reference Xcode-generated metadata via $required"
        exit 1
    fi
done

for artifact in \
    "Build/Intermediates.noindex/GeneratedModuleMaps" \
    "Build/Intermediates.noindex/GeneratedModuleMaps-iphoneos" \
    "Build/Intermediates.noindex/GeneratedModuleMaps-iphonesimulator"
do
    if ! rg -q "$artifact" "$release_workflow"; then
        echo "release workflow does not package $artifact for make-swiftgodot-framework"
        exit 1
    fi
done
