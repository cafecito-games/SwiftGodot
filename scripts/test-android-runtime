#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: scripts/test-android-runtime {arm64-v8a|x86_64}" >&2
}

if [[ $# -ne 1 ]]; then usage; exit 2; fi
abi=$1
case "$abi" in arm64-v8a|x86_64) ;; *) usage; exit 2 ;; esac

script_dir=$(cd "$(dirname "$0")" && pwd)
repository_root=$(cd "$script_dir/.." && pwd)
# shellcheck source=android-config
source "$script_dir/android-config"
# shellcheck source=android-abis
source "$script_dir/android-abis"
release_tag=v4.7.2-20260902.2
godot_version=4.7.2.stable.cafecito_6b0b715d9.ed1daf0bf
# Godot resolves export templates by major.minor.patch.status only; the custom
# build name and hash that --version reports are not part of the directory.
godot_template_version=4.7.2.stable
editor_sha=d5c760b89da2ef01e9e19153f5fae969c058dd9f1e78d0e1a3881923e1a77b38
linux_editor_sha=5ef9ae1efd521967e803935885e53fd8e620e02a2b8db6aeba3108b92dcd7238
templates_sha=1e6bca23f4278466f9b1ab159ce869ab5a877884122a1faec6d5353c3d7744d2
cache_dir=${SWIFT_GODOT_ANDROID_RUNTIME_CACHE:-"$repository_root/.build/android-runtime-cache"}
work_dir=${SWIFT_GODOT_ANDROID_RUNTIME_WORK_DIR:-"$repository_root/.build/android-runtime-$abi"}
project_dir="$work_dir/project"
apk="$project_dir/build/SwiftGodotAndroidTest.apk"
godot_command=${SWIFT_GODOT_GODOT_COMMAND:-}
adb_command=${SWIFT_GODOT_ADB_COMMAND:-adb}
timeout_seconds=${SWIFT_GODOT_ANDROID_TIMEOUT:-120}
exit_timeout_seconds=${SWIFT_GODOT_ANDROID_EXIT_TIMEOUT:-15}
serial=${ANDROID_SERIAL:-}

die() { echo "Error: $*" >&2; exit 1; }
sha256() { shasum -a 256 "$1" | awk '{print $1}'; }

case "$work_dir" in
    ""|/|"$repository_root") die "refusing unsafe runtime work directory: $work_dir" ;;
esac

download_release_asset() {
    local name=$1 destination=$2 expected=$3
    if [[ ! -f "$destination" ]]; then
        mkdir -p "$(dirname "$destination")"
        gh release download "$release_tag" --repo cafecito-games/custom-godot --pattern "$name" --output "$destination"
    fi
    [[ "$(sha256 "$destination")" == "$expected" ]] || die "SHA-256 mismatch for $name"
}

write_export_plugin() {
    local addon=$1 aar_name=$2 plugin_name=$3
    cat > "$addon/plugin.cfg" <<EOF
[plugin]
name="$plugin_name"
description="SwiftGodot Android runtime verification plugin"
author="cafecito-games"
version="test"
script="export_plugin.gd"
EOF
    # Indent with spaces: an unquoted heredoc passes a backslash escape through
    # verbatim, so a "\t" here would reach GDScript as two literal characters
    # and fail to parse.
    cat > "$addon/export_plugin.gd" <<EOF
@tool
extends EditorPlugin
var export_plugin
func _enter_tree():
    export_plugin = AndroidExportPlugin.new()
    add_export_plugin(export_plugin)
func _exit_tree():
    remove_export_plugin(export_plugin)
    export_plugin = null
class AndroidExportPlugin extends EditorExportPlugin:
    func _supports_platform(platform):
        return platform is EditorExportPlatformAndroid
    func _get_android_libraries(platform, debug):
        return PackedStringArray(["res://addons/$plugin_name/bin/$aar_name"])
    func _get_name():
        return "$plugin_name"
EOF
}

rm -rf "$project_dir"
mkdir -p "$work_dir"
rsync -aL "$repository_root/Tests/AndroidTestProject/" "$project_dir/"

if [[ -z "${SWIFT_GODOT_RUNTIME_SKIP_SETUP:-}" ]]; then
    root_aar=${SWIFT_GODOT_ANDROID_AAR:-"$repository_root/.build/android-aar/SwiftGodot-release.aar"}
    test_aar=${SWIFT_GODOT_ANDROID_TEST_AAR:-"$repository_root/.build/android-test/SwiftGodotAndroidTest-release.aar"}
    [[ -f "$root_aar" ]] || die "SwiftGodot AAR missing: $root_aar"
    [[ -f "$test_aar" ]] || die "Android test AAR missing: $test_aar"

    root_addon="$project_dir/addons/SwiftGodot"
    test_addon="$project_dir/addons/SwiftGodotAndroidTest"
    mkdir -p "$root_addon/bin" "$test_addon/bin"
    cp "$root_aar" "$root_addon/bin/SwiftGodot-release.aar"
    cp "$test_aar" "$test_addon/bin/SwiftGodotAndroidTest-release.aar"
    write_export_plugin "$root_addon" SwiftGodot-release.aar SwiftGodot
    write_export_plugin "$test_addon" SwiftGodotAndroidTest-release.aar SwiftGodotAndroidTest

    if [[ -z "$godot_command" ]]; then
        editor_dir="$cache_dir/editor"
        case "$(uname -s)" in
        Darwin)
            editor_archive="$cache_dir/godot_macos_editor.arm64.zip"
            download_release_asset godot_macos_editor.arm64.zip "$editor_archive" "$editor_sha"
            if [[ ! -d "$editor_dir" ]]; then
                mkdir -p "$editor_dir"
                unzip -q "$editor_archive" -d "$editor_dir"
            fi
            godot_command=$(find "$editor_dir" -type f -path '*/Contents/MacOS/Godot' -print -quit)
            ;;
        Linux)
            editor_archive="$cache_dir/godot_linux_editor.x86_64.tar.gz"
            download_release_asset godot_linux_editor.x86_64.tar.gz "$editor_archive" "$linux_editor_sha"
            if [[ ! -d "$editor_dir" ]]; then
                mkdir -p "$editor_dir"
                tar -xzf "$editor_archive" -C "$editor_dir"
            fi
            godot_command=$(find "$editor_dir" -maxdepth 2 -type f -perm -111 -name 'godot*' -print -quit)
            ;;
        *) die "unsupported host platform: $(uname -s)" ;;
        esac
        if [[ -z "$godot_command" ]]; then
            rm -rf "$editor_dir"
            die "custom Godot editor executable was not found in $editor_archive"
        fi
    fi
    [[ -x "$godot_command" ]] || die "Godot editor is not executable: $godot_command"
    [[ "$($godot_command --version | head -1)" == "$godot_version" ]] || die "unexpected Godot editor version"

    templates_zip="$cache_dir/android.zip"
    download_release_asset android.zip "$templates_zip" "$templates_sha"
    # Godot reads export templates from its own data directory, not from
    # GODOT_DATA_PATH.
    case "$(uname -s)" in
        Darwin) template_root="$HOME/Library/Application Support/Godot/export_templates" ;;
        *) template_root="${XDG_DATA_HOME:-$HOME/.local/share}/godot/export_templates" ;;
    esac
    template_dir="$template_root/$godot_template_version"
    # This directory is shared with whatever else the user has installed for
    # this Godot version, so never clear it; overwrite only the entries the
    # archive owns. The stamp records which archive those entries came from,
    # because a present-but-stale android_source.zip is indistinguishable from
    # a current one by name alone.
    template_stamp="$template_dir/.swiftgodot-android-templates"
    installed_templates=
    if [[ -f "$template_stamp" ]]; then
        installed_templates=$(cat "$template_stamp")
    fi
    if [[ ! -f "$template_dir/android_source.zip" || "$installed_templates" != "$templates_sha" ]]; then
        mkdir -p "$template_dir"
        unzip -o -q "$templates_zip" -d "$template_dir"
        printf '%s\n' "$templates_sha" > "$template_stamp"
        echo "Installed Android export templates $templates_sha into $template_dir"
    fi
    [[ -f "$template_dir/android_source.zip" ]] ||
        die "Android export template missing: $template_dir/android_source.zip"
else
    [[ -n "$godot_command" ]] || die "SWIFT_GODOT_GODOT_COMMAND is required when setup is skipped"
fi

mkdir -p "$(dirname "$apk")"
"$godot_command" --headless --path "$project_dir" --editor --quit
"$godot_command" --headless --path "$project_dir" \
    --install-android-build-template \
    --export-debug Android "$apk"
[[ -d "$project_dir/android/build" ]] || die "Godot did not install the project Android Gradle build template"
[[ -f "$apk" ]] || die "Godot export did not produce $apk"

apk_entries=$(unzip -Z1 "$apk")
for packaged_abi in $(android_required_abis); do
    for library in libSwiftGodot.so libSwiftGodotEmbed.so libAndroidTestExtension.so; do
        packaged_path="lib/$packaged_abi/$library"
        count=$(awk -v required="$packaged_path" '$0 == required { count++ } END { print count + 0 }' <<< "$apk_entries")
        [[ "$count" == 1 ]] || die "APK must contain exactly one $packaged_path; found $count"
    done
done

if [[ -n "${SWIFT_GODOT_ANDROID_EXPORT_ONLY:-}" ]]; then
    echo "Android APK export validation passed: $apk"
    exit 0
fi

package=games.cafecito.swiftgodot.runtime_test
if [[ -n "$serial" ]]; then adb=("$adb_command" -s "$serial"); else adb=("$adb_command"); fi

diagnostics_dir="$work_dir/diagnostics"
mkdir -p "$diagnostics_dir"

# Capture device state on every exit, not only on the failures we anticipated.
# An unexpected abort used to leave nothing behind to diagnose from.
# shellcheck disable=SC2329  # invoked through the EXIT trap below
capture_diagnostics() {
    local status=$?
    {
        printf 'serial=%s\n' "${serial:-<default>}"
        "${adb[@]}" devices -l || true
        "${adb[@]}" shell getprop || true
        "${adb[@]}" shell dumpsys activity processes || true
    } > "$diagnostics_dir/device.txt" 2>&1
    "${adb[@]}" logcat -d > "$diagnostics_dir/logcat.txt" 2>&1 || true
    return "$status"
}
trap capture_diagnostics EXIT

"${adb[@]}" wait-for-device
"${adb[@]}" logcat -c
"${adb[@]}" install -r "$apk"

# monkey reports "No activities found to run" on stdout and still exits 0, so
# discarding its output turns a launch that never happened into a silent
# 120 second wait for a marker that was never going to appear.
launch_output=$("${adb[@]}" shell monkey -p "$package" 1 2>&1 || true)
printf '%s\n' "$launch_output"
if grep -Eqi 'no activities found|monkey aborted|Error:' <<< "$launch_output"; then
    die "could not launch $package: $launch_output"
fi

logcat_dump="$work_dir/logcat.txt"

# Every failure path saves the device log. A bare "timed out" says nothing
# about what the application actually did.
save_logcat() {
    printf '%s\n' "$1" > "$logcat_dump"
    echo "Saved device log to $logcat_dump" >&2
    printf '%s\n' "$1" >&2
}

deadline=$((SECONDS + timeout_seconds))
success="SWIFTGODOT_ANDROID_OK:$abi:42"
# Each marker is a boundary crossing between Godot's engine thread and Swift's
# main actor that has failed on Android before; the final marker alone would
# not prove the earlier ones ran.
required_markers=(
    SWIFTGODOT_ANDROID_CONSTRUCTED
    SWIFTGODOT_ANDROID_NODE_API_OK
    SWIFTGODOT_ANDROID_MAIN_ACTOR_HOP_OK
)
logs=
while (( SECONDS < deadline )); do
    logs=$("${adb[@]}" logcat -d 2>&1 || true)
    if grep -Fq "$success" <<< "$logs"; then
        for marker in "${required_markers[@]}"; do
            if ! grep -Fq "$marker" <<< "$logs"; then
                save_logcat "$logs"
                die "Android test reached $success without emitting $marker"
            fi
        done
        exit_deadline=$((SECONDS + exit_timeout_seconds))
        while (( SECONDS < exit_deadline )); do
            if ! "${adb[@]}" shell pidof "$package" >/dev/null 2>&1; then
                echo "$success"
                exit 0
            fi
            sleep 1
        done
        die "Android test emitted success but did not terminate cleanly"
    fi
    if grep -Eq 'SWIFTGODOT_ANDROID_FAIL|dlopen failed|GDExtension.*(failed|error)|Cannot open dynamic library' <<< "$logs"; then
        save_logcat "$logs"
        die "Android runtime reported a loader or GDExtension failure"
    fi
    sleep 1
done

save_logcat "${logs:-$("${adb[@]}" logcat -d 2>&1 || true)}"
if [[ -n "$("${adb[@]}" shell pidof "$package" 2>/dev/null | tr -d '\r')" ]]; then
    echo "$package is still running; it started but never reached the marker" >&2
else
    echo "$package is not running; it exited or never started" >&2
fi
die "timed out after ${timeout_seconds}s waiting for $success"
