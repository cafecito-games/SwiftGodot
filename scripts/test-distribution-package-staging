#!/usr/bin/env bash
set -euo pipefail

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

rg -q 'SWIFT_GODOT_PREPARED_PACKAGE_DIR' scripts/build-distribution-products || fail "build-distribution-products must accept a prepared package"
rg -q 'SWIFT_GODOT_STAGE_ONLY' scripts/build-distribution-products || fail "build-distribution-products must support stage-only mode"
rg -q 'SWIFT_GODOT_PREPARED_PACKAGE_DIR="\$prepared_release_package"' scripts/release || fail "local release must reuse the prepared package"
rg -q 'stage-package:' .github/workflows/release.yml || fail "release workflow must stage generated sources once"
rg -q 'swiftgodot-distribution-package' .github/workflows/release.yml || fail "release workflow must pass the staged package as an artifact"
rg -q '^  android:' .github/workflows/swift.yml || fail "CI must define an Android job"
rg -q 'scripts/build-android-libraries' .github/workflows/swift.yml || fail "CI must cross-build Android libraries"
rg -q 'scripts/build-android-test-extension' .github/workflows/swift.yml || fail "CI must build the independent Android consumer"
rg -q 'scripts/test-android-runtime x86_64' .github/workflows/swift.yml || fail "CI must execute the x86_64 Android runtime smoke test"
rg -q 'swift-6\.3\.3-RELEASE_android' .github/workflows/swift.yml .github/workflows/release.yml || fail "Android workflows must install the pinned Swift SDK"
rg -q '^  build-android:' .github/workflows/release.yml || fail "release workflow must build the Android AAR"
rg -q 'name: swiftgodot-android' .github/workflows/release.yml || fail "release workflow must upload the Android artifact"
rg -q 'scripts/build-android-test-extension' .github/workflows/release.yml || fail "release workflow must build the independent Android consumer"
rg -q 'SWIFT_GODOT_ANDROID_EXPORT_ONLY' .github/workflows/release.yml || fail "release workflow must inspect a Gradle-exported Android APK"
rg -q -- '- build-android' .github/workflows/release.yml || fail "release job must depend on Android"

echo "distribution package staging tests passed"
