#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: scripts/package-android-aar JNI_ROOT OUTPUT_DIR" >&2
}

if [[ $# -ne 2 ]]; then
    usage
    exit 2
fi

script_dir=$(cd "$(dirname "$0")" && pwd)
repository_root=$(cd "$script_dir/.." && pwd)
# shellcheck source=android-config
source "$script_dir/android-config"
# shellcheck source=android-abis
source "$script_dir/android-abis"

project_dir="$repository_root/Android/SwiftGodotPlugin"
jni_root=$1
output_dir=$2
generated_jni="$project_dir/plugin/src/main/jniLibs"

die() {
    echo "Error: $*" >&2
    exit 1
}

# The published AAR always carries every configured ABI, whichever subset an
# individual build job produced.
required_abis=$(unset SWIFT_GODOT_ANDROID_ABIS; android_selected_abis) || die "invalid Android ABI configuration"

for abi in $required_abis; do
    [[ -d "$jni_root/$abi" ]] || die "missing JNI ABI directory: $abi"
done
[[ ! -e "$generated_jni" ]] || die "generated JNI directory already exists: $generated_jni"

cleanup() {
    rm -rf "$generated_jni"
}
trap cleanup EXIT

mkdir -p "$generated_jni"
for abi in $required_abis; do
    rsync -aL "$jni_root/$abi" "$generated_jni/"
done
"$script_dir/strip-android-elf" "$generated_jni"
SWIFT_GODOT_ANDROID_ABIS='' "$script_dir/validate-android-elf" "$generated_jni"

(
    cd "$project_dir"
    ./gradlew --no-daemon :plugin:assembleRelease
)

aar="$project_dir/plugin/build/outputs/aar/SwiftGodot-release.aar"
[[ -f "$aar" ]] || die "Gradle did not produce SwiftGodot-release.aar"
mkdir -p "$output_dir"
cp "$aar" "$output_dir/SwiftGodot-release.aar"
"$script_dir/validate-android-aar" "$output_dir/SwiftGodot-release.aar"

echo "Android AAR packaged at $output_dir/SwiftGodot-release.aar"
