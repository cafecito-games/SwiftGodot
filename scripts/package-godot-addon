#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: scripts/package-godot-addon TAG SWIFTGODOT_XCFRAMEWORK SWIFTGODOTEMBED_XCFRAMEWORK ANDROID_AAR SHIM_DIR [OUTPUT_DIR]

Stages the SwiftGodot Godot addon at OUTPUT_DIR/dist/addons/SwiftGodot and
writes OUTPUT_DIR/SwiftGodot-TAG.zip. The zip extracts to addons/SwiftGodot.

The addon ships:
  - plugin.cfg, export_plugin.gd, LICENSE
  - SwiftGodotEmbed.gdextension      — registered, no-op GDExtension
  - bin/android/SwiftGodot.aar
  - bin/ios/SwiftGodot.xcframework
  - bin/ios/SwiftGodotEmbed.xcframework
  - bin/macos_arm64/SwiftGodot.framework
  - bin/macos_arm64/SwiftGodotEmbed.framework
  - bin/linux_x86_64/libSwiftGodotEmbed.so
  - bin/linux_arm64/libSwiftGodotEmbed.so
  - bin/windows_x86_64/SwiftGodotEmbed.dll

SHIM_DIR is the directory produced by scripts/build-gdextension-shim; it supplies
the three Linux and Windows payloads above.

It also publishes the same tree as gpm slices under
OUTPUT_DIR/gpm-slices, so a project using gpm downloads only the platforms it
ships to instead of the whole zip. Both outputs describe one addon; the zip stays
for consumers who install by hand.

The export plugin adds the AAR to Android exports. The .gdextension declares
SwiftGodot under `[dependencies]` so Godot's iOS/macOS exporters embed
SwiftGodot.framework into the exported app exactly once. Downstream
GDExtensions that link SwiftGodot do NOT need to list it in their own
`[dependencies]` block as long as this addon is installed.

The Linux and Windows payloads are the no-op SwiftGodotEmbed shim only. Linux is
supported as a source build, but the addon ships no prebuilt SwiftGodot library
for Linux or Windows, so those platforms get no `[dependencies]` entry: there
would be nothing for Godot's exporter to embed, and an entry naming an absent
file would reintroduce the load error this shim removes. Consumer GDExtensions
link their own SwiftGodot build on those hosts.

A host outside the declared set — linux.riscv64 or windows.arm64, say — still
sees Godot's "No GDExtension library found" report. That is accepted; no wildcard
entry masks it.
EOF
}

if [[ $# -lt 5 || $# -gt 6 ]]; then
    usage
    exit 1
fi

tag=$1
xcframework=$2
embed_xcframework=$3
android_aar=$4
shim_dir=$5
output_dir=${6:-.}

case "$tag" in
    ""|*/*)
        echo "TAG must be non-empty and must not contain /"
        exit 1
        ;;
esac

absolute_path() {
    case "$1" in
        /*)
            printf '%s\n' "$1"
            ;;
        *)
            printf '%s/%s\n' "$(pwd)" "$1"
            ;;
    esac
}

xcframework=$(absolute_path "$xcframework")
embed_xcframework=$(absolute_path "$embed_xcframework")
android_aar=$(absolute_path "$android_aar")
shim_dir=$(absolute_path "$shim_dir")
output_dir=$(absolute_path "$output_dir")

if [[ ! -d "$xcframework" ]]; then
    echo "Expected SwiftGodot xcframework directory: $xcframework"
    exit 1
fi

if [[ ! -d "$embed_xcframework" ]]; then
    echo "Expected SwiftGodotEmbed xcframework directory: $embed_xcframework"
    exit 1
fi

if [[ ! -f "$android_aar" ]]; then
    echo "Expected Android AAR file: $android_aar"
    exit 1
fi

if [[ ! -d "$shim_dir" ]]; then
    echo "Expected the GDExtension shim directory produced by scripts/build-gdextension-shim: $shim_dir"
    exit 1
fi

if [[ ! -f LICENSE ]]; then
    echo "Expected to run from the SwiftGodot repository root"
    exit 1
fi

# shellcheck source=gdextension-shim-config
source scripts/gdextension-shim-config

# shellcheck source=gpm-slice-config
source scripts/gpm-slice-config

[[ -f "$GPM_SLICE_MANIFEST" ]] || {
    echo "Missing the gpm packaging manifest: $GPM_SLICE_MANIFEST"
    exit 1
}

# Checked before anything is staged, because a cut without slices is a silent
# regression for every project that installs this addon through gpm. The floor is
# a floor rather than the pin so a newer local gpm is accepted; CI installs the
# pinned build with scripts/install-gpm.
if ! command -v gpm >/dev/null 2>&1; then
    echo "gpm $GPM_SLICE_MINIMUM_VERSION or newer is required to publish the addon's slices."
    echo "Install it with 'scripts/install-gpm DIR' and put the printed directory on PATH,"
    echo "or with 'brew install --cask cafecito-games/tap/gpm'."
    exit 1
fi

gpm_version=$(gpm_slice_installed_version) || gpm_version=
if [[ -z "$gpm_version" ]]; then
    echo "Cannot read a version out of 'gpm --version'; refusing to package with an unidentified gpm."
    exit 1
fi
if ! gpm_slice_version_at_least "$gpm_version" "$GPM_SLICE_MINIMUM_VERSION"; then
    echo "gpm $gpm_version is older than the required $GPM_SLICE_MINIMUM_VERSION."
    echo "0.5.1 is the floor: earlier versions cannot store the Android AAR as a shared"
    echo "artifact, and reject the android.* [libraries] keys Godot resolves from the APK."
    exit 1
fi

# Refuse before staging anything if the shim build was skipped or soft-failed
# upstream: never emit a [libraries] entry for a payload that is not there.
missing_payloads=()
for entry in "${GDEXTENSION_SHIM_TARGETS[@]}"; do
    IFS='|' read -r _tag payload_dir payload_name _target _container _machine <<<"$entry"
    if [[ ! -s "$shim_dir/$payload_dir/$payload_name" ]]; then
        missing_payloads+=("$payload_dir/$payload_name")
    fi
done
if [[ ${#missing_payloads[@]} -gt 0 ]]; then
    echo "Missing GDExtension shim payloads under $shim_dir:"
    printf '  %s\n' "${missing_payloads[@]}"
    echo "Run scripts/build-gdextension-shim first."
    exit 1
fi

copy_without_symlinks() {
    local source=$1
    local destination_parent=$2

    # gpm refuses to extract symlink entries from release zips. Dereference
    # framework symlinks into real files/directories while preserving paths.
    rsync -aL "$source" "$destination_parent/"
}

# Pick the macOS arm64 slice from an xcframework. Falls back to a unique
# macos-* slice when no exact "macos-arm64" directory exists.
pick_macos_framework() {
    local xcf=$1
    local module=$2
    local resolved

    if [[ -d "$xcf/macos-arm64/$module.framework" ]]; then
        printf '%s\n' "$xcf/macos-arm64/$module.framework"
        return
    fi

    local candidates=()
    for candidate in "$xcf"/macos-*/"$module.framework"; do
        [[ -d "$candidate" ]] && candidates+=("$candidate")
    done

    if [[ ${#candidates[@]} -eq 1 ]]; then
        printf '%s\n' "${candidates[0]}"
        return
    fi

    echo "Expected exactly one macOS $module.framework slice in $xcf"
    exit 1
}

mac_framework=$(pick_macos_framework "$xcframework" "SwiftGodot")
mac_embed_framework=$(pick_macos_framework "$embed_xcframework" "SwiftGodotEmbed")

mkdir -p "$output_dir"

dist_dir="$output_dir/dist"
addon_dir="$dist_dir/addons/SwiftGodot"
zip_path="$output_dir/SwiftGodot-$tag.zip"
plugin_version=${tag#v}

rm -rf "$addon_dir"
shim_bin_dirs=()
for entry in "${GDEXTENSION_SHIM_TARGETS[@]}"; do
    IFS='|' read -r _tag payload_dir _name _target _container _machine <<<"$entry"
    shim_bin_dirs+=("$addon_dir/bin/$payload_dir")
done
mkdir -p "$addon_dir/bin/android" "$addon_dir/bin/ios" "$addon_dir/bin/macos_arm64" "${shim_bin_dirs[@]}"

cat > "$addon_dir/plugin.cfg" <<EOF
[plugin]
name="SwiftGodot"
description="Prebuilt SwiftGodot runtime for Android, iOS, and macOS GDExtensions, and a no-op SwiftGodotEmbed for Linux and Windows. Registers SwiftGodotEmbed and exports the Android AAR automatically."
author="cafecito-games"
version="$plugin_version"
script="export_plugin.gd"
EOF

cat > "$addon_dir/export_plugin.gd" <<'EOF'
@tool
extends EditorPlugin

var export_plugin: AndroidExportPlugin

func _enter_tree():
	export_plugin = AndroidExportPlugin.new()
	add_export_plugin(export_plugin)

func _exit_tree():
	remove_export_plugin(export_plugin)
	export_plugin = null

class AndroidExportPlugin extends EditorExportPlugin:
	func _supports_platform(platform):
		return platform is EditorExportPlatformAndroid

	func _get_android_libraries(platform, debug):
		return PackedStringArray(["res://addons/SwiftGodot/bin/android/SwiftGodot.aar"])

	func _get_name():
		return "SwiftGodot"
EOF

cat > "$addon_dir/SwiftGodotEmbed.gdextension" <<'EOF'
[configuration]
entry_symbol = "swift_godot_embed_entry_point"
compatibility_minimum = "4.7"
android_aar_plugin = true

[libraries]
android.debug.arm64 = "res://addons/SwiftGodot/bin/android/arm64-v8a/libSwiftGodotEmbed.so"
android.release.arm64 = "res://addons/SwiftGodot/bin/android/arm64-v8a/libSwiftGodotEmbed.so"
android.debug.x86_64 = "res://addons/SwiftGodot/bin/android/x86_64/libSwiftGodotEmbed.so"
android.release.x86_64 = "res://addons/SwiftGodot/bin/android/x86_64/libSwiftGodotEmbed.so"
ios.debug = "res://addons/SwiftGodot/bin/ios/SwiftGodotEmbed.xcframework"
ios.release = "res://addons/SwiftGodot/bin/ios/SwiftGodotEmbed.xcframework"
ios.simulator.debug = "res://addons/SwiftGodot/bin/ios/SwiftGodotEmbed.xcframework"
ios.simulator.release = "res://addons/SwiftGodot/bin/ios/SwiftGodotEmbed.xcframework"
macos.arm64 = "res://addons/SwiftGodot/bin/macos_arm64/SwiftGodotEmbed.framework"
linux.x86_64 = "res://addons/SwiftGodot/bin/linux_x86_64/libSwiftGodotEmbed.so"
linux.arm64 = "res://addons/SwiftGodot/bin/linux_arm64/libSwiftGodotEmbed.so"
windows.x86_64 = "res://addons/SwiftGodot/bin/windows_x86_64/SwiftGodotEmbed.dll"

[dependencies]
ios.debug = { "res://addons/SwiftGodot/bin/ios/SwiftGodot.xcframework": "" }
ios.release = { "res://addons/SwiftGodot/bin/ios/SwiftGodot.xcframework": "" }
ios.simulator.debug = { "res://addons/SwiftGodot/bin/ios/SwiftGodot.xcframework": "" }
ios.simulator.release = { "res://addons/SwiftGodot/bin/ios/SwiftGodot.xcframework": "" }
macos.arm64 = { "res://addons/SwiftGodot/bin/macos_arm64/SwiftGodot.framework": "" }
EOF

cp LICENSE "$addon_dir/LICENSE"
cp "$android_aar" "$addon_dir/bin/android/SwiftGodot.aar"
copy_without_symlinks "$xcframework" "$addon_dir/bin/ios"
copy_without_symlinks "$embed_xcframework" "$addon_dir/bin/ios"
copy_without_symlinks "$mac_framework" "$addon_dir/bin/macos_arm64"
copy_without_symlinks "$mac_embed_framework" "$addon_dir/bin/macos_arm64"

for entry in "${GDEXTENSION_SHIM_TARGETS[@]}"; do
    IFS='|' read -r _tag payload_dir payload_name _target _container _machine <<<"$entry"
    cp "$shim_dir/$payload_dir/$payload_name" "$addon_dir/bin/$payload_dir/$payload_name"
done

if find "$addon_dir" -type l -print | grep -q .; then
    echo "Refusing to package addon with symlinks; gpm cannot extract them:"
    find "$addon_dir" -type l -print
    exit 1
fi

# Resolvability is proven after staging and before zipping, so a failure leaves
# no artifact behind for a release to publish.
scripts/validate-godot-addon-libraries "$addon_dir" "$addon_dir/bin/android/SwiftGodot.aar"

rm -f "$zip_path"
(
    cd "$dist_dir"
    zip -qryX "$zip_path" addons/SwiftGodot
)

# gpm has no exclusion mechanism, so it packages the staged tree rather than the
# working tree: everything under addons/SwiftGodot that no .gdextension key and
# no [package.slices] rule claims lands in core, which every consumer downloads
# on every platform. The manifest is copied in beside the staged tree because
# `gpm package --dir` reads it from there.
slices_dir="$output_dir/$GPM_SLICE_OUTPUT_SUBDIR"
cp "$GPM_SLICE_MANIFEST" "$dist_dir/gpm-package.toml"
rm -rf "$slices_dir"
gpm package --dir "$dist_dir" --out "$slices_dir" --version "$plugin_version" >&2

# Proven before the caller can publish it, for the same reason the library
# validation runs before zipping: a wrong cut is only discovered in someone
# else's project, where it fails as a download error.
scripts/validate-addon-slices "$slices_dir" "$plugin_version" "$addon_dir/bin/android/SwiftGodot.aar" >&2

printf '%s\n' "$zip_path"
