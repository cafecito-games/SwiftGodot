#!/usr/bin/env bash
set -euo pipefail

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

rg -q 'swift package compute-checksum "\$zip_path"' scripts/release || fail "SwiftGodot checksum must be computed from the release zip"
rg -q 'swift package compute-checksum "\$gdextension_zip_path"' scripts/release || fail "GDExtensionC checksum must be computed from the release zip"
rg -q '"checksum": "\$swiftgodot_checksum"' scripts/release || fail "SwiftGodot manifest entry must include checksum"
rg -q '"checksum": "\$gdextension_checksum"' scripts/release || fail "GDExtensionC manifest entry must include checksum"
rg -q '"name": "GDExtensionC"' scripts/release || fail "binaries.json must include GDExtensionC"
rg -q '"macroSources"' scripts/release || fail "binaries.json must record macro source provenance"
rg -q 'Sources/SwiftGodotMacroLibrary' scripts/release || fail "release must stage the macro implementation sources"
rg -q 'git archive "\$commit" Sources/SwiftGodotMacroLibrary' scripts/release || fail "release must extract macro sources from the release commit"
rg -q 'scripts/generate-binary-package-manifest' scripts/release || fail "release must generate the remote binary package from binaries.json"
rg -q 'artifact\["url"\]' scripts/generate-binary-package-manifest || fail "binary targets must use release URLs"
rg -q 'artifact\["checksum"\]' scripts/generate-binary-package-manifest || fail "binary targets must use computed checksums"
rg -q 'import CompilerPluginSupport' scripts/generate-binary-package-manifest || fail "generated package must declare a source macro target"
rg -q 'SwiftSyntaxMacros' scripts/generate-binary-package-manifest || fail "generated macro target must declare SwiftSyntax dependencies"
if rg -q 'path: "Binaries/' scripts/release scripts/generate-binary-package-manifest; then
    fail "remote binary package must not reference hydrated local Binaries paths"
fi
rg -q 'scripts/test-binary-package-consumer "\$binary_repo_dir"' scripts/release || fail "release must clean-build a binary-package consumer before publishing"
rg -q -- '--jobs 4' scripts/test-binary-package-consumer || fail "binary consumer build must use a bounded parallel worker count"
rg -q -- '--verbose' scripts/test-binary-package-consumer || fail "binary consumer build must emit diagnostic progress"
rg -q -- '--cache-path "\$work_dir/cache"' scripts/test-binary-package-consumer || fail "binary consumer must use a fresh SwiftPM cache"
rg -q 'SWIFT_GODOT_BINARY_CONSUMER_WORK_DIR' scripts/test-binary-package-consumer || fail "binary consumer must support a reusable local debugging workspace"
rg -q 'otool .* \| grep -q' scripts/test-binary-package-consumer || fail "binary consumer must use a runner-available linkage assertion"
rg -q '^@Godot$' scripts/test-binary-package-consumer || fail "binary consumer must exercise real macro expansion"
rg -q 'swift package resolve' scripts/test-binary-package-consumer || fail "binary consumer validation must separate resolution from compilation"
rg -q 'PHASE BEGIN' scripts/test-binary-package-consumer || fail "binary consumer validation must log phase boundaries"
rg -q 'PHASE END' scripts/test-binary-package-consumer || fail "binary consumer validation must log phase completion"
rg -q 'PHASE TIMEOUT' scripts/test-binary-package-consumer || fail "binary consumer validation must fail fast when a phase stalls"
rg -q 'ps -axo' scripts/test-binary-package-consumer || fail "binary consumer timeout must dump active toolchain processes"
rg -q 'pgrep -P' scripts/test-binary-package-consumer || fail "binary consumer timeout must terminate the whole SwiftPM process tree"
rg -q 'SWIFT_GODOT_BINARY_CONSUMER_PHASE_TIMEOUT_SECONDS' scripts/test-binary-package-consumer || fail "binary consumer phase timeout must be configurable"
rg -q 'SWIFT_GODOT_BINARY_CONSUMER_TIMEOUT_MINUTES' scripts/test-binary-package-consumer || fail "binary consumer phase timeout must derive from the total validation budget"
rg -q 'preflight_reserve_seconds' scripts/test-binary-package-consumer || fail "binary consumer phase timeout must reserve budget for release-asset probing and publication"
rg -q -- '--disable-prefetching' scripts/test-binary-package-consumer || fail "binary consumer validation must support disabling SwiftPM prefetching"
rg -q -- '--enable-prefetching' scripts/test-binary-package-consumer || fail "binary consumer validation must keep prefetching on by default"
rg -q 'PHASE BEGIN release-asset-verify' scripts/publish-binary-package || fail "publisher must report reachability/checksum failures separately from resolution"
rg -q 'consumer_validation_timeout' .github/workflows/release.yml || fail "release workflow must expose a configurable consumer validation timeout"
rg -q 'SWIFT_GODOT_BINARY_CONSUMER_TIMEOUT_MINUTES' .github/workflows/release.yml || fail "release workflow must propagate the validation budget to the consumer watchdog"
rg -q 'prefetch: \[enabled, disabled\]' .github/workflows/release.yml || fail "download diagnosis must compare prefetching on and off"
release_line=$(rg -n 'gh release create' scripts/release | cut -d: -f1 | tail -n 1)
consumer_line=$(rg -n 'scripts/test-binary-package-consumer "\$binary_repo_dir"' scripts/release | cut -d: -f1)
[[ -n "$release_line" && -n "$consumer_line" && "$consumer_line" -gt "$release_line" ]] || fail "remote consumer test must run after release assets exist"
flag_line=$(rg -n '^[[:space:]]*release_created=1$' scripts/release | cut -d: -f1 | tail -n 1)
[[ -n "$flag_line" && "$flag_line" -lt "$release_line" ]] || fail "release rollback must be armed before gh release create can partially succeed"
release_job=$(awk '
    /^  release:$/ { in_release = 1 }
    in_release && /^  [A-Za-z0-9_-]+:$/ && $0 != "  release:" { exit }
    in_release { print }
' .github/workflows/release.yml)
grep -q '^    timeout-minutes: 45$' <<< "$release_job" || fail "release publication job must have a 45-minute hard timeout"
release_step=$(grep -A1 '^      - name: Run release script$' <<< "$release_job")
grep -q '^        timeout-minutes: 30$' <<< "$release_step" || fail "release script step must have a 30-minute hard timeout"
rg -q 'SWIFT_GODOT_DEFER_BINARY_PUBLISH: 1' .github/workflows/release.yml || fail "heavy release job must defer binary validation to a clean runner"
rg -q -- '--prerelease' scripts/release || fail "deferred source release must remain a prerelease until binary validation passes"
rg -q 'scripts/publish-binary-package' .github/workflows/release.yml || fail "release workflow must publish binary metadata from a clean job"
publish_job=$(awk '
    /^  publish-binary-package:$/ { in_publish = 1 }
    in_publish && /^  [A-Za-z0-9_-]+:$/ && $0 != "  publish-binary-package:" { exit }
    in_publish { print }
' .github/workflows/release.yml)
publish_if=$(awk '
    /^    if: >-$/ { in_if = 1 }
    in_if { print }
    in_if && /}}$/ { exit }
' <<< "$publish_job")
expected_publish_if=$'    if: >-\n      ${{ !cancelled()\n      && needs.prepare.result == \'success\'\n      && needs.release.result == \'success\' }}'
[[ "$publish_if" == "$expected_publish_if" ]] || fail "clean binary publication job must use the exact cancellation and required-dependency guard"
grep -q '^    timeout-minutes: 30$' <<< "$publish_job" || fail "clean binary publication job must have a 30-minute hard timeout"
publish_step=$(grep -A1 '^      - name: Validate public URLs, publish the binary tag, and promote the release$' <<< "$publish_job")
# The GitHub Actions expression is literal text, not a shell variable.
# shellcheck disable=SC2016
grep -qF '        timeout-minutes: ${{ inputs.consumer_validation_timeout }}' <<< "$publish_step" || fail "clean binary publication step timeout must come from the consumer_validation_timeout input"
publish_consumer_line=$(rg -n 'scripts/test-binary-package-consumer "\$metadata_dir"' scripts/publish-binary-package | cut -d: -f1)
publish_push_line=$(rg -n 'git push --atomic' scripts/publish-binary-package | cut -d: -f1)
publish_promote_line=$(rg -n 'gh release edit .*--prerelease=false' scripts/publish-binary-package | cut -d: -f1)
[[ -n "$publish_consumer_line" && -n "$publish_push_line" && "$publish_consumer_line" -lt "$publish_push_line" ]] || fail "clean consumer validation must precede binary publication"
[[ -n "$publish_promote_line" && "$publish_push_line" -lt "$publish_promote_line" ]] || fail "source release promotion must follow binary publication"
rg -q 'diff -qr Sources/SwiftGodotMacroLibrary "\$metadata_dir/Sources/SwiftGodotMacroLibrary"' scripts/publish-binary-package || fail "publisher must verify staged macro source bytes"

work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT

cat > "$work_dir/binaries.json" <<'EOF'
{
  "version": "v9.8.7",
  "sourceRepo": "cafecito-games/SwiftGodot",
  "macroSources": {
    "path": "Sources/SwiftGodotMacroLibrary",
    "sourceCommit": "dddddddddddddddddddddddddddddddddddddddd"
  },
  "artifacts": [
    {"name":"SwiftGodot","file":"SwiftGodot.xcframework.zip","url":"https://github.com/cafecito-games/SwiftGodot/releases/download/v9.8.7/SwiftGodot.xcframework.zip","checksum":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
    {"name":"GDExtensionC","file":"GDExtensionC.xcframework.zip","url":"https://github.com/cafecito-games/SwiftGodot/releases/download/v9.8.7/GDExtensionC.xcframework.zip","checksum":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}
  ]
}
EOF

scripts/generate-binary-package-manifest "$work_dir/binaries.json" "$work_dir/Package.swift"
rg -q 'url: "https://github.com/cafecito-games/SwiftGodot/releases/download/v9.8.7/SwiftGodot.xcframework.zip"' "$work_dir/Package.swift" || fail "generated manifest must contain the SwiftGodot URL"
rg -q 'checksum: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"' "$work_dir/Package.swift" || fail "generated manifest must contain the SwiftGodot checksum"
rg -q 'name: "SwiftGodotMacroLibrary"' "$work_dir/Package.swift" || fail "generated manifest must contain the source macro target"

jq 'del(.artifacts[1])' "$work_dir/binaries.json" > "$work_dir/missing.json"
if scripts/generate-binary-package-manifest "$work_dir/missing.json" "$work_dir/missing.swift" 2>/dev/null; then
    fail "generator must reject a missing artifact"
fi

jq '.artifacts[0].checksum = "wrong"' "$work_dir/binaries.json" > "$work_dir/checksum.json"
if scripts/generate-binary-package-manifest "$work_dir/checksum.json" "$work_dir/checksum.swift" 2>/dev/null; then
    fail "generator must reject a malformed checksum"
fi

jq 'del(.macroSources)' "$work_dir/binaries.json" > "$work_dir/missing-macro-sources.json"
if scripts/generate-binary-package-manifest "$work_dir/missing-macro-sources.json" "$work_dir/missing-macro-sources.swift" 2>/dev/null; then
    fail "generator must reject missing macro source provenance"
fi

printf '{not json}\n' > "$work_dir/malformed.json"
if scripts/generate-binary-package-manifest "$work_dir/malformed.json" "$work_dir/malformed.swift" 2>/dev/null; then
    fail "generator must reject malformed metadata"
fi

# The runtime ships inside SwiftGodot.xcframework; it must not be released or
# referenced as a separate binary artifact (duplicate class registration).
rg -q 'SwiftGodotRuntime.xcframework' scripts/release && fail "release must not ship a standalone SwiftGodotRuntime.xcframework"
rg -q '"name": "SwiftGodotRuntime"' scripts/release && fail "binaries.json must not list a separate SwiftGodotRuntime artifact"
rg -q 'SwiftGodotMacros.artifactbundle.zip' scripts/release && fail "release must not publish an executable artifact that SwiftPM cannot load as a macro"

echo "binary manifest tests passed"
