#!/usr/bin/env bash
set -euo pipefail

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

script="scripts/package-godot-addon"
release_script="scripts/release"
swift_workflow=".github/workflows/swift.yml"
release_workflow=".github/workflows/release.yml"

[[ -x "$script" ]] || fail "package-godot-addon script must exist and be executable"

work_dir=$(mktemp -d)
http_server_pid=
cleanup() {
    if [[ -n "$http_server_pid" ]]; then
        kill "$http_server_pid" 2>/dev/null || true
        wait "$http_server_pid" 2>/dev/null || true
    fi
    rm -rf "$work_dir"
}
trap cleanup EXIT

# Build a fake SwiftGodot xcframework with a signed, versioned macOS framework,
# plus a matching C-only SwiftGodotEmbed xcframework. Mirrors
# scripts/make-swiftgodot-framework: SwiftGodot carries Headers and Modules
# metadata symlinks, while C-only SwiftGodotEmbed carries only Versions/Current,
# SwiftGodotEmbed, and Resources.
make_fake_xcframework() {
    local module=$1
    local kind=${2:-swift}
    local xcf="$work_dir/$module.xcframework"
    local mac="$xcf/macos-arm64/$module.framework"

    mkdir -p \
        "$xcf/ios-arm64/$module.framework" \
        "$xcf/ios-arm64-simulator/$module.framework" \
        "$mac/Versions/A/Resources"
    if [[ "$kind" == swift ]]; then
        mkdir -p \
            "$mac/Versions/A/Headers" \
            "$mac/Versions/A/Modules/$module.swiftmodule"
    fi

    # A real Info.plist, because packaging reads the slice set out of it rather
    # than globbing the bundle, and restages bin/ios from the iOS entries only.
    cat > "$xcf/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AvailableLibraries</key>
	<array>
		<dict>
			<key>BinaryPath</key>
			<string>$module.framework/$module</string>
			<key>LibraryIdentifier</key>
			<string>ios-arm64</string>
			<key>LibraryPath</key>
			<string>$module.framework</string>
			<key>SupportedArchitectures</key>
			<array>
				<string>arm64</string>
			</array>
			<key>SupportedPlatform</key>
			<string>ios</string>
		</dict>
		<dict>
			<key>BinaryPath</key>
			<string>$module.framework/$module</string>
			<key>LibraryIdentifier</key>
			<string>ios-arm64-simulator</string>
			<key>LibraryPath</key>
			<string>$module.framework</string>
			<key>SupportedArchitectures</key>
			<array>
				<string>arm64</string>
			</array>
			<key>SupportedPlatform</key>
			<string>ios</string>
			<key>SupportedPlatformVariant</key>
			<string>simulator</string>
		</dict>
		<dict>
			<key>BinaryPath</key>
			<string>$module.framework/Versions/A/$module</string>
			<key>LibraryIdentifier</key>
			<string>macos-arm64</string>
			<key>LibraryPath</key>
			<string>$module.framework</string>
			<key>SupportedArchitectures</key>
			<array>
				<string>arm64</string>
			</array>
			<key>SupportedPlatform</key>
			<string>macos</string>
		</dict>
	</array>
	<key>CFBundlePackageType</key>
	<string>XFWK</string>
	<key>XCFrameworkFormatVersion</key>
	<string>1.0</string>
</dict>
</plist>
PLIST
    printf 'fake ios device binary\n' > "$xcf/ios-arm64/$module.framework/$module"
    printf 'fake ios simulator binary\n' > "$xcf/ios-arm64-simulator/$module.framework/$module"
    cc -dynamiclib -arch arm64 \
        -install_name "@rpath/$module.framework/Versions/A/$module" \
        -x c - -o "$mac/Versions/A/$module" <<'SOURCE'
int swiftgodot_test_fixture_symbol(void) { return 0; }
SOURCE
    if [[ "$kind" == swift ]]; then
        printf 'fake header\n' > "$mac/Versions/A/Headers/$module-Swift.h"
        printf 'fake module\n' > "$mac/Versions/A/Modules/module.modulemap"
        printf 'fake swiftmodule\n' > "$mac/Versions/A/Modules/$module.swiftmodule/arm64-apple-macos.swiftmodule"
    fi
    cat > "$mac/Versions/A/Resources/Info.plist" <<FRAMEWORK_PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>$module</string>
	<key>CFBundleIdentifier</key>
	<string>com.cafecito-games.$module</string>
	<key>CFBundleName</key>
	<string>$module</string>
	<key>CFBundlePackageType</key>
	<string>FMWK</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
</dict>
</plist>
FRAMEWORK_PLIST

    ln -s A "$mac/Versions/Current"
    if [[ "$kind" == swift ]]; then
        ln -s Versions/Current/Headers "$mac/Headers"
        ln -s Versions/Current/Modules "$mac/Modules"
    fi
    ln -s Versions/Current/Resources "$mac/Resources"
    ln -s "Versions/Current/$module" "$mac/$module"

    codesign --force -s - "$mac" >/dev/null 2>&1

    printf '%s\n' "$xcf"
}

xcframework=$(make_fake_xcframework SwiftGodot swift)
embed_xcframework=$(make_fake_xcframework SwiftGodotEmbed c)

# shellcheck source=gdextension-shim-config
source scripts/gdextension-shim-config
entry_symbol=$(gdextension_shim_entry_symbol)

# shellcheck source=gpm-slice-config
source scripts/gpm-slice-config

# The android.* [libraries] entries point at bin/android/<abi>/ paths that
# deliberately do not exist in the addon tree; Godot resolves them from the
# exported APK, and the real objects live inside the AAR. The fixture therefore
# has to be a real zip with jni/<abi>/ entries so the validator can check them.
make_fake_android_aar() {
    local aar="$work_dir/SwiftGodot.aar"
    local staging="$work_dir/aar-staging"

    mkdir -p "$staging/jni/arm64-v8a" "$staging/jni/x86_64"
    printf 'fake manifest\n' > "$staging/AndroidManifest.xml"
    printf 'fake classes\n' > "$staging/classes.jar"
    printf 'fake arm64 embed\n' > "$staging/jni/arm64-v8a/libSwiftGodotEmbed.so"
    printf 'fake x86_64 embed\n' > "$staging/jni/x86_64/libSwiftGodotEmbed.so"
    (cd "$staging" && zip -qryX "$aar" .)

    printf '%s\n' "$aar"
}

android_aar=$(make_fake_android_aar)

shim_dir="$work_dir/shim"
scripts/build-gdextension-shim "$shim_dir" >/dev/null

output_dir="$work_dir/output"
"$script" "v1.2.3-rc.1" "$xcframework" "$embed_xcframework" "$android_aar" "$shim_dir" "$output_dir" >/dev/null

zip_path="$output_dir/SwiftGodot-v1.2.3-rc.1.zip"
[[ -f "$zip_path" ]] || fail "expected addon zip at $zip_path"

stage_root="$output_dir/dist/addons/SwiftGodot"
[[ -d "$stage_root" ]] || fail "expected staged addon tree at $stage_root"

extract_dir="$work_dir/extract"
mkdir -p "$extract_dir"
unzip -q "$zip_path" -d "$extract_dir"

addon="$extract_dir/addons/SwiftGodot"
[[ -d "$addon" ]] || fail "zip must extract to addons/SwiftGodot"
[[ "$(find "$extract_dir" -mindepth 1 -maxdepth 1 -type d -name addons | wc -l | tr -d ' ')" == "1" ]] || fail "zip must have only addons at the root"

[[ -f "$addon/plugin.cfg" ]] || fail "plugin.cfg missing"
[[ -f "$addon/export_plugin.gd" ]] || fail "export_plugin.gd missing"
[[ -f "$addon/LICENSE" ]] || fail "LICENSE missing"
cmp -s LICENSE "$addon/LICENSE" || fail "addon LICENSE must match repo LICENSE"
[[ -f "$addon/SwiftGodotEmbed.gdextension" ]] || fail "SwiftGodotEmbed.gdextension missing"
[[ -d "$addon/bin/ios/SwiftGodot.xcframework" ]] || fail "iOS SwiftGodot.xcframework missing"
[[ -d "$addon/bin/ios/SwiftGodotEmbed.xcframework" ]] || fail "iOS SwiftGodotEmbed.xcframework missing"
[[ -d "$addon/bin/macos_arm64/SwiftGodot.framework" ]] || fail "macOS SwiftGodot.framework missing"
[[ -d "$addon/bin/macos_arm64/SwiftGodotEmbed.framework" ]] || fail "macOS SwiftGodotEmbed.framework missing"

# bin/ios carries iOS slices only. A macOS slice in there is unreachable —
# macos.arm64 resolves to bin/macos_arm64/ — and dereferencing a versioned macOS
# framework yields a bundle with a root binary and a Versions/ layout at once,
# which codesign refuses as "bundle format is ambiguous". A consumer signing
# every slice of every embedded xcframework fails its whole archive on it.
xcframework_slices_for_platform() {
    local plist=$1
    local wanted=$2
    local index=0
    local identifier platform

    while identifier=$(/usr/libexec/PlistBuddy -c "Print :AvailableLibraries:$index:LibraryIdentifier" "$plist" 2>/dev/null); do
        platform=$(/usr/libexec/PlistBuddy -c "Print :AvailableLibraries:$index:SupportedPlatform" "$plist" 2>/dev/null) || platform=
        if [[ "$wanted" == any || "$platform" == "$wanted" ]]; then
            printf '%s\n' "$identifier"
        fi
        index=$((index + 1))
    done
}

for module in SwiftGodot SwiftGodotEmbed; do
    staged_xcframework="$addon/bin/ios/$module.xcframework"
    source_xcframework="$work_dir/$module.xcframework"

    declared=$(xcframework_slices_for_platform "$staged_xcframework/Info.plist" any | sort)
    declared_ios=$(xcframework_slices_for_platform "$staged_xcframework/Info.plist" ios | sort)
    [[ -n "$declared" ]] || fail "staged $module.xcframework declares no slices"
    [[ "$declared" == "$declared_ios" ]] || {
        echo "Declared slices:" >&2
        printf '%s\n' "$declared" >&2
        fail "staged $module.xcframework must declare iOS slices only"
    }

    # Every iOS slice of the input is kept, and nothing else is on disk: the
    # expected set is read out of the input rather than written down here.
    expected_ios=$(xcframework_slices_for_platform "$source_xcframework/Info.plist" ios | sort)
    present=$(find "$staged_xcframework" -mindepth 1 -maxdepth 1 ! -name Info.plist -exec basename {} \; | sort)
    [[ "$present" == "$expected_ios" ]] || {
        echo "Expected staged slices:" >&2
        printf '%s\n' "$expected_ios" >&2
        echo "Present:" >&2
        printf '%s\n' "$present" >&2
        fail "staged $module.xcframework must carry exactly the input's iOS slices"
    }

    # Each kept slice is byte-for-byte what the input held.
    while IFS= read -r slice; do
        diff -r --no-dereference "$source_xcframework/$slice" "$staged_xcframework/$slice" >/dev/null ||
            fail "staged $module.xcframework changed slice $slice"
    done <<<"$expected_ios"
done

[[ -f "$addon/bin/android/SwiftGodot.aar" ]] || fail "Android SwiftGodot.aar missing"
cmp -s "$android_aar" "$addon/bin/android/SwiftGodot.aar" || fail "Android AAR must be copied without modification"

for entry in "${GDEXTENSION_SHIM_TARGETS[@]}"; do
    IFS='|' read -r _tag payload_dir payload_name _target _container _machine <<<"$entry"
    [[ -f "$addon/bin/$payload_dir/$payload_name" ]] || fail "$payload_dir/$payload_name missing from the addon"
    cmp -s "$shim_dir/$payload_dir/$payload_name" "$addon/bin/$payload_dir/$payload_name" ||
        fail "$payload_dir/$payload_name must be copied without modification"
    facts=$(scripts/inspect-native-library "$addon/bin/$payload_dir/$payload_name") ||
        fail "$payload_dir/$payload_name is not a loadable native library"
    printf '%s\n' "$facts" | sed -n 's/^exports=//p' | tr ' ' '\n' | grep -qx "$entry_symbol" ||
        fail "$payload_dir/$payload_name does not export $entry_symbol"
done

unexpected_addon_entries=$(find "$addon" -mindepth 1 -maxdepth 1 ! -name plugin.cfg ! -name export_plugin.gd ! -name LICENSE ! -name bin ! -name 'SwiftGodotEmbed.gdextension' -print)
[[ -z "$unexpected_addon_entries" ]] || fail "unexpected top-level addon entries: $unexpected_addon_entries"

bin_whitelist=(-name ios -o -name macos_arm64 -o -name android)
for entry in "${GDEXTENSION_SHIM_TARGETS[@]}"; do
    IFS='|' read -r _tag payload_dir _name _target _container _machine <<<"$entry"
    bin_whitelist+=(-o -name "$payload_dir")
done
unexpected_bin_entries=$(find "$addon/bin" -mindepth 1 -maxdepth 1 ! \( "${bin_whitelist[@]}" \) -print)
[[ -z "$unexpected_bin_entries" ]] || fail "unexpected bin entries: $unexpected_bin_entries"

# Only SwiftGodotEmbed.gdextension is allowed; nothing under bin/ should be a
# .gdextension file.
gdextension_files=$(find "$addon" -name '*.gdextension' -print)
if [[ "$gdextension_files" != "$addon/SwiftGodotEmbed.gdextension" ]]; then
    fail "expected only SwiftGodotEmbed.gdextension; got: $gdextension_files"
fi

expected_macos_framework_symlinks() {
    local module=$1
    printf '%s\n' \
        "Versions/Current|A" \
        "$module|Versions/Current/$module" \
        "Resources|Versions/Current/Resources"
    if [[ "$module" == SwiftGodot ]]; then
        printf '%s\n' \
            "Headers|Versions/Current/Headers" \
            "Modules|Versions/Current/Modules"
    fi
}

# Versioned macOS frameworks require relative symlinks so codesign classifies the
# bundle unambiguously and each Mach-O binary is stored once at Versions/A/<Name>.
zip_listing=$(unzip -Zl "$zip_path")
for module in SwiftGodot SwiftGodotEmbed; do
    prefix="addons/SwiftGodot/bin/macos_arm64/$module.framework"
    while IFS='|' read -r relative_link _expected_target; do
        awk -v target="$prefix/$relative_link" '$NF == target && $1 ~ /^l/ { found = 1 } END { exit found ? 0 : 1 }' <<<"$zip_listing" ||
            fail "addon zip must store $prefix/$relative_link as a symlink entry"
    done < <(expected_macos_framework_symlinks "$module")
    awk -v target="$prefix/Versions/A/$module" '$NF == target && $1 ~ /^-/ { found = 1 } END { exit found ? 0 : 1 }' <<<"$zip_listing" ||
        fail "addon zip must store $prefix/Versions/A/$module as a regular file"
done

unexpected_symlinks=$(find "$addon" \
    \( -path "$addon/bin/macos_arm64/SwiftGodot.framework/*" \
       -o -path "$addon/bin/macos_arm64/SwiftGodotEmbed.framework/*" \) -prune \
    -o -type l -print)
[[ -z "$unexpected_symlinks" ]] ||
    fail "unexpected symlinks outside macOS framework bundles: $unexpected_symlinks"

for forbidden in '*.swift' '*.h' '*.swiftmodule'; do
    if find "$addon" \
        \( -path "$addon/bin/ios/SwiftGodot.xcframework/*" \
           -o -path "$addon/bin/ios/SwiftGodotEmbed.xcframework/*" \
           -o -path "$addon/bin/macos_arm64/SwiftGodot.framework/*" \
           -o -path "$addon/bin/macos_arm64/SwiftGodotEmbed.framework/*" \) -prune \
        -o -name "$forbidden" -print | grep -q .; then
        fail "found $forbidden outside binary bundles"
    fi
done

expected_plugin="$work_dir/expected-plugin.cfg"
cat > "$expected_plugin" <<'EOF'
[plugin]
name="SwiftGodot"
description="Prebuilt SwiftGodot runtime for Android, iOS, and macOS GDExtensions, and a no-op SwiftGodotEmbed for Linux and Windows. Registers SwiftGodotEmbed and exports the Android AAR automatically."
author="cafecito-games"
version="1.2.3-rc.1"
script="export_plugin.gd"
EOF
cmp -s "$expected_plugin" "$addon/plugin.cfg" || {
    echo "Expected plugin.cfg:" >&2
    cat "$expected_plugin" >&2
    echo "Actual plugin.cfg:" >&2
    cat "$addon/plugin.cfg" >&2
    fail "plugin.cfg contents differ"
}

expected_gdextension="$work_dir/expected.gdextension"
cat > "$expected_gdextension" <<'EOF'
[configuration]
entry_symbol = "swift_godot_embed_entry_point"
compatibility_minimum = "4.7"
android_aar_plugin = true

[libraries]
android.debug.arm64 = "res://addons/SwiftGodot/bin/android/arm64-v8a/libSwiftGodotEmbed.so"
android.release.arm64 = "res://addons/SwiftGodot/bin/android/arm64-v8a/libSwiftGodotEmbed.so"
android.debug.x86_64 = "res://addons/SwiftGodot/bin/android/x86_64/libSwiftGodotEmbed.so"
android.release.x86_64 = "res://addons/SwiftGodot/bin/android/x86_64/libSwiftGodotEmbed.so"
ios.debug = "res://addons/SwiftGodot/bin/ios/SwiftGodotEmbed.xcframework"
ios.release = "res://addons/SwiftGodot/bin/ios/SwiftGodotEmbed.xcframework"
ios.simulator.debug = "res://addons/SwiftGodot/bin/ios/SwiftGodotEmbed.xcframework"
ios.simulator.release = "res://addons/SwiftGodot/bin/ios/SwiftGodotEmbed.xcframework"
macos.arm64 = "res://addons/SwiftGodot/bin/macos_arm64/SwiftGodotEmbed.framework"
linux.x86_64 = "res://addons/SwiftGodot/bin/linux_x86_64/libSwiftGodotEmbed.so"
linux.arm64 = "res://addons/SwiftGodot/bin/linux_arm64/libSwiftGodotEmbed.so"
windows.x86_64 = "res://addons/SwiftGodot/bin/windows_x86_64/SwiftGodotEmbed.dll"

[dependencies]
ios.debug = { "res://addons/SwiftGodot/bin/ios/SwiftGodot.xcframework": "" }
ios.release = { "res://addons/SwiftGodot/bin/ios/SwiftGodot.xcframework": "" }
ios.simulator.debug = { "res://addons/SwiftGodot/bin/ios/SwiftGodot.xcframework": "" }
ios.simulator.release = { "res://addons/SwiftGodot/bin/ios/SwiftGodot.xcframework": "" }
macos.arm64 = { "res://addons/SwiftGodot/bin/macos_arm64/SwiftGodot.framework": "" }
EOF
cmp -s "$expected_gdextension" "$addon/SwiftGodotEmbed.gdextension" || {
    echo "Expected SwiftGodotEmbed.gdextension:" >&2
    cat "$expected_gdextension" >&2
    echo "Actual SwiftGodotEmbed.gdextension:" >&2
    cat "$addon/SwiftGodotEmbed.gdextension" >&2
    fail "SwiftGodotEmbed.gdextension contents differ"
}

rg -q '^extends EditorPlugin$' "$addon/export_plugin.gd" || fail "export plugin must extend EditorPlugin"
rg -q 'add_export_plugin\(export_plugin\)' "$addon/export_plugin.gd" || fail "export plugin must register its Android export hook"
rg -q 'platform is EditorExportPlatformAndroid' "$addon/export_plugin.gd" || fail "export plugin must support Android"
rg -q 'res://addons/SwiftGodot/bin/android/SwiftGodot\.aar' "$addon/export_plugin.gd" || fail "export plugin must return the packaged Android AAR"
rg -q '^\s*func _get_name\(\):' "$addon/export_plugin.gd" || fail "Android export plugin must have a stable name"

assert_versioned_macos_framework() {
    local framework=$1
    local module=$2
    local context=$3

    [[ -d "$framework" && ! -L "$framework" ]] ||
        fail "$context macOS $module.framework must be a real bundle directory"
    [[ -f "$framework/Versions/A/$module" && ! -L "$framework/Versions/A/$module" ]] ||
        fail "$context macOS $module.framework must keep regular binary Versions/A/$module for its install name"

    local link_path expected_target actual_target
    while IFS='|' read -r link_path expected_target; do
        [[ -L "$framework/$link_path" ]] ||
            fail "$context macOS $module.framework/$link_path must be a symlink, not a dereferenced copy"
        actual_target=$(readlink "$framework/$link_path")
        [[ "$actual_target" == "$expected_target" ]] ||
            fail "$context macOS $module.framework/$link_path points to '$actual_target', expected '$expected_target'"
    done < <(expected_macos_framework_symlinks "$module")

    if [[ "$module" == SwiftGodotEmbed ]]; then
        [[ ! -e "$framework/Headers" && ! -L "$framework/Headers" ]] ||
            fail "$context C-only macOS SwiftGodotEmbed.framework must not carry Headers"
        [[ ! -e "$framework/Modules" && ! -L "$framework/Modules" ]] ||
            fail "$context C-only macOS SwiftGodotEmbed.framework must not carry Modules"
    fi

    local binary_copies
    binary_copies=$(find "$framework" -type f -name "$module" | wc -l | tr -d ' ')
    [[ "$binary_copies" == "1" ]] ||
        fail "$context macOS $module.framework must contain exactly 1 regular binary file, got $binary_copies"

    codesign --verify --strict "$framework" >/dev/null 2>&1 ||
        fail "$context macOS $module.framework failed codesign --verify --strict"

    local resign_dir
    resign_dir=$(mktemp -d "$work_dir/resign.XXXXXX")
    rsync -a "$framework" "$resign_dir/"
    codesign --force -s - "$resign_dir/$module.framework" >/dev/null 2>&1 ||
        fail "$context macOS $module.framework cannot be re-signed with codesign --force -s -"
    codesign --verify --strict "$resign_dir/$module.framework" >/dev/null 2>&1 ||
        fail "$context re-signed macOS $module.framework failed codesign --verify --strict"
    rm -rf "$resign_dir"
}

for module in SwiftGodot SwiftGodotEmbed; do
    assert_versioned_macos_framework "$stage_root/bin/macos_arm64/$module.framework" "$module" "staged"
    assert_versioned_macos_framework "$addon/bin/macos_arm64/$module.framework" "$module" "extracted-zip"
done

# --- gpm slices -------------------------------------------------------------
# The same staged tree is published as slices so a project installing through gpm
# downloads only the platforms it ships to. package-godot-addon validates its own
# cut; these assertions pin the contract that validation checks against.
slices_dir="$output_dir/$GPM_SLICE_OUTPUT_SUBDIR"
[[ -d "$slices_dir" ]] || fail "expected gpm slices at $slices_dir"

slice_index="$slices_dir/gpm-index.toml"
[[ -f "$slice_index" ]] || fail "gpm package wrote no gpm-index.toml"

slice_facts=$(scripts/inspect-gpm-index "$slice_index") || fail "cannot read $slice_index"

slice_fact() {
    printf '%s\n' "$slice_facts" | sed -n "s/^$1=//p"
}

[[ "$(slice_fact format)" == "2" ]] ||
    fail "the index must be format 2, which is what carries the shared Android artifact"
[[ "$(slice_fact version)" == "1.2.3-rc.1" ]] ||
    fail "the index version must be the plugin.cfg version, without the tag's v prefix"

published_slices=$(printf '%s\n' "$slice_facts" | sed -n 's/^slice=\([^ ]*\) .*$/\1/p' | sort)
expected_slices=$(printf '%s\n' "${GPM_SLICE_EXPECTED_SLICES[@]}" | sort)
[[ "$published_slices" == "$expected_slices" ]] || {
    echo "Expected slices:" >&2
    printf '%s\n' "$expected_slices" >&2
    echo "Published slices:" >&2
    printf '%s\n' "$published_slices" >&2
    fail "published slice set differs from scripts/gpm-slice-config"
}

# Read back out of the shim config rather than restated, so adding a shim
# platform without publishing its slice fails here.
for entry in "${GDEXTENSION_SHIM_TARGETS[@]}"; do
    IFS='|' read -r platform_tag _dir _name _target _container _machine <<<"$entry"
    grep -qx "$platform_tag" <<<"$published_slices" ||
        fail "scripts/gdextension-shim-config declares $platform_tag but no slice publishes it"
done

# core is downloaded by every consumer on every platform, so a binary reaching it
# is a size regression for projects that will never load it.
core_listing=$(unzip -Z1 "$slices_dir/$(printf '%s\n' "$slice_facts" | sed -n 's/^slice=core \([^ ]*\) .*$/\1/p')")
if grep -q '^bin/' <<<"$core_listing"; then
    grep '^bin/' <<<"$core_listing" >&2
    fail "the core slice must carry no binaries"
fi

# The AAR is one file for every ABI. It must be stored once as a shared artifact
# both per-ABI slices pull, not copied into each.
android_artifact="$slices_dir/$(printf '%s\n' "$slice_facts" | sed -n 's/^artifact=android \([^ ]*\) .*$/\1/p')"
[[ -f "$android_artifact" ]] || fail "no shared android artifact was published"
[[ "$(unzip -Z1 "$android_artifact")" == "bin/android/SwiftGodot.aar" ]] ||
    fail "the shared android artifact must carry exactly bin/android/SwiftGodot.aar"
for slice_id in android.arm64 android.x86_64; do
    grep -qw android <<<"$(printf '%s\n' "$slice_facts" | sed -n "s/^slice_artifacts=$slice_id //p")" ||
        fail "slice $slice_id must reference the shared android artifact"
done

# The android.* [libraries] keys name paths Godot resolves from the exported APK,
# so their slices carry no files of their own. They still have to publish the
# keys, or a consumer reassembles a .gdextension with no Android library at all.
rg -q '"android\.debug\.arm64" = "res://addons/SwiftGodot/bin/android/arm64-v8a/libSwiftGodotEmbed\.so"' "$slice_index" ||
    fail "the index must record the android.arm64 library key for reassembly"

scripts/validate-addon-slices "$slices_dir" "1.2.3-rc.1" "$addon/bin/android/SwiftGodot.aar" >/dev/null ||
    fail "the published cut must pass scripts/validate-addon-slices"

# The macos.arm64 slice archive must preserve the versioned framework symlinks
# rather than shipping dereferenced regular files.
macos_slice_file="$slices_dir/$(printf '%s\n' "$slice_facts" | sed -n 's/^slice=macos\.arm64 \([^ ]*\) .*$/\1/p')"
[[ -f "$macos_slice_file" ]] || fail "no macos.arm64 slice archive was published"
macos_slice_listing=$(unzip -Zl "$macos_slice_file")
for module in SwiftGodot SwiftGodotEmbed; do
    prefix="bin/macos_arm64/$module.framework"
    while IFS='|' read -r relative_link _expected_target; do
        awk -v target="$prefix/$relative_link" '$NF == target && $1 ~ /^l/ { found = 1 } END { exit found ? 0 : 1 }' <<<"$macos_slice_listing" ||
            fail "macos.arm64 slice must store $prefix/$relative_link as a symlink entry"
    done < <(expected_macos_framework_symlinks "$module")
    awk -v target="$prefix/Versions/A/$module" '$NF == target && $1 ~ /^-/ { found = 1 } END { exit found ? 0 : 1 }' <<<"$macos_slice_listing" ||
        fail "macos.arm64 slice must store $prefix/Versions/A/$module as a regular file"
done

# Round-trip verification: install the packaged slices with gpm into a scratch
# Godot project and prove the versioned macOS framework symlinks survive as real
# symbolic links and pass strict codesign verification.
port_file="$work_dir/http-port"
python3 - "$slices_dir" "$port_file" <<'HTTP_SERVER' &
import functools
import http.server
import pathlib
import sys

directory, port_path = sys.argv[1], sys.argv[2]


class QuietHandler(http.server.SimpleHTTPRequestHandler):
    def log_message(self, format, *args):
        pass


server = http.server.ThreadingHTTPServer(
    ("127.0.0.1", 0),
    functools.partial(QuietHandler, directory=directory),
)
pathlib.Path(port_path).write_text(f"{server.server_address[1]}\n", encoding="utf-8")
server.serve_forever()
HTTP_SERVER
http_server_pid=$!
while [[ ! -s "$port_file" ]] && kill -0 "$http_server_pid" 2>/dev/null; do
    sleep 0.05
done
[[ -s "$port_file" ]] || fail "failed to start local HTTP server for gpm round-trip install"
http_port=$(tr -d '\n' < "$port_file")

core_slice_name=$(printf '%s\n' "$slice_facts" | sed -n 's/^slice=core \([^ ]*\) .*$/\1/p')
gpm_project="$work_dir/gpm-consumer"
mkdir -p "$gpm_project"
printf 'config_version=5\n' > "$gpm_project/project.godot"
cat > "$gpm_project/addons.toml" <<ADDONS_TOML
[project]
platforms = ["ios", "macos.arm64", "android.arm64", "android.x86_64", "linux.x86_64", "linux.arm64", "windows.x86_64"]

[addons.SwiftGodot]
source = "archive"
url    = "http://127.0.0.1:$http_port/$core_slice_name"
index  = "http://127.0.0.1:$http_port/gpm-index.toml"
ADDONS_TOML

gpm install --dir "$gpm_project" --json >/dev/null ||
    fail "gpm install failed on the published slice cut"

gpm_installed_addon="$gpm_project/addons/SwiftGodot"
[[ -d "$gpm_installed_addon" ]] || fail "gpm install did not materialize addons/SwiftGodot"
rg -q '^    file_manifest_version = 2$' "$gpm_project/.gpm-state.toml" ||
    fail "gpm state must record file_manifest_version = 2 for symlinked macOS frameworks"
rg -q 'symlinks = \[' "$gpm_project/.gpm-state.toml" ||
    fail "gpm state must record installed symlinks"

for module in SwiftGodot SwiftGodotEmbed; do
    assert_versioned_macos_framework "$gpm_installed_addon/bin/macos_arm64/$module.framework" "$module" "gpm-installed"
done

scripts/validate-godot-addon-libraries "$gpm_installed_addon" "$gpm_installed_addon/bin/android/SwiftGodot.aar" >/dev/null ||
    fail "reassembled gpm-installed addon failed library validation"

# Repeat install must be idempotent and report the symlinked addon as intact.
gpm install --dir "$gpm_project" --json >/dev/null ||
    fail "repeat gpm install failed on the installed symlinked addon"
gpm_list_json=$(gpm list --dir "$gpm_project" --json) ||
    fail "gpm list failed after round-trip install"
python3 -c '
import json, sys
entries = json.loads(sys.argv[1])
assert len(entries) == 1 and entries[0]["name"] == "SwiftGodot" and entries[0]["installed"] is True, entries
' "$gpm_list_json" || fail "gpm list did not report SwiftGodot as installed after round-trip"

kill "$http_server_pid" 2>/dev/null || true
wait "$http_server_pid" 2>/dev/null || true
http_server_pid=

# Fail closed: the validator is the authority on the published set, so it must
# reject a cut short an archive, and one carrying an archive the index does not
# name.
missing_archive_dir=$(mktemp -d "$work_dir/missing-archive.XXXXXX")
cp -R "$slices_dir/." "$missing_archive_dir/"
rm -f "$missing_archive_dir/$(printf '%s\n' "$slice_facts" | sed -n 's/^slice=ios \([^ ]*\) .*$/\1/p')"
if scripts/validate-addon-slices "$missing_archive_dir" "1.2.3-rc.1" "$addon/bin/android/SwiftGodot.aar" >/dev/null 2>&1; then
    fail "slice validation must fail when an archive the index names is absent"
fi

stray_archive_dir=$(mktemp -d "$work_dir/stray-archive.XXXXXX")
cp -R "$slices_dir/." "$stray_archive_dir/"
printf 'stray\n' > "$stray_archive_dir/SwiftGodot-1.2.3-rc.1-haiku.zip"
if scripts/validate-addon-slices "$stray_archive_dir" "1.2.3-rc.1" "$addon/bin/android/SwiftGodot.aar" >/dev/null 2>&1; then
    fail "slice validation must fail on an archive the index does not name"
fi

dereferenced_dist_dir=$(mktemp -d "$work_dir/deref-dist.XXXXXX")
rsync -aL "$output_dir/dist/" "$dereferenced_dist_dir/"
dereferenced_slices_dir=$(mktemp -d "$work_dir/deref-slices.XXXXXX")
gpm package --dir "$dereferenced_dist_dir" --out "$dereferenced_slices_dir" --version "1.2.3-rc.1" >/dev/null 2>&1
if scripts/validate-addon-slices "$dereferenced_slices_dir" "1.2.3-rc.1" "$addon/bin/android/SwiftGodot.aar" >/dev/null 2>&1; then
    fail "slice validation must fail when macos.arm64 slice stores dereferenced framework files instead of symlinks"
fi

rg -q 'scripts/package-godot-addon "\$tag" "\$output_dir/SwiftGodot\.xcframework" "\$output_dir/SwiftGodotEmbed\.xcframework" "\$android_aar" "\$shim_dir" "\$output_dir"' "$release_script" || fail "release script must package the Godot addon from Apple artifacts, the Android AAR, and the GDExtension shim"
rg -q 'scripts/build-gdextension-shim "\$shim_dir"' "$release_script" || fail "release script must build the GDExtension shim before packaging the addon"
rg -q '! -x scripts/build-gdextension-shim' "$release_script" || fail "release script must require scripts/build-gdextension-shim up front"
rg -q 'SwiftGodot-\$tag\.zip' "$release_script" || fail "release script must name the addon zip SwiftGodot-\$tag.zip"
rg -q 'release_assets=\("\$zip_path" "\$gdextension_zip_path" "\$android_aar" "\$addon_zip_path" "\$\{addon_slice_assets\[@\]\}"\)' "$release_script" ||
    fail "release script must collect the binary artifacts, Android AAR, addon zip, and slice assets for upload"
stable_release_create_count=$(rg -c '^    gh release create "\$tag" "\$\{release_assets\[@\]\}" -R "\$source_repo" -F "\$release_notes" --target "\$commit"$' "$release_script" || true)
[[ "$stable_release_create_count" == 1 ]] ||
    fail "stable release path must upload the complete release asset set exactly once"
prerelease_create_count=$(rg -c '^    gh release create "\$tag" "\$\{release_assets\[@\]\}" -R "\$source_repo" -F "\$release_notes" --target "\$commit" --prerelease$' "$release_script" || true)
[[ "$prerelease_create_count" == 1 ]] ||
    fail "deferred prerelease path must upload the complete release asset set exactly once"
if rg -q 'no longer using vXXX|v-prefixed tags|\[\[ "\$RELEASE_TAG" == v\* \]\]' "$release_script" .github/workflows/release.yml; then
    fail "release path must allow v-prefixed tags for Godot addon assets"
fi
rg -q '^package-godot-addon:' Makefile || fail "Makefile must expose package-godot-addon"
rg -q 'scripts/package-godot-addon "\$\$tag" "\$\$xcframework" "\$\$embed_xcframework" "\$\$android_aar" "\$\$shim_dir" "\$\$output_dir"' Makefile || fail "Makefile must pass the Android AAR and the GDExtension shim to package-godot-addon"
rg -q 'scripts/build-gdextension-shim "\$\$shim_dir"' Makefile || fail "Makefile must build the GDExtension shim before packaging the addon"
rg -q 'scripts/test-package-godot-addon' "$swift_workflow" || fail "CI must run package-godot-addon regression tests"
rg -q 'scripts/test-build-gdextension-shim' "$swift_workflow" || fail "CI must run the GDExtension shim build tests"

# The slice cut is part of the release, not an optional extra: the release script
# has to upload the archives and their index beside the addon zip, and must
# refuse to start without the validator.
rg -q 'source scripts/gpm-slice-config' "$release_script" || fail "release script must read the slice configuration"
rg -q '! -x scripts/validate-addon-slices' "$release_script" || fail "release script must require scripts/validate-addon-slices up front"
rg -q 'addon_slice_assets=\("\$addon_slices_dir"/\*\)' "$release_script" || fail "release script must collect the slice archives for upload"
rg -q '"\$\{addon_slice_assets\[@\]\}"' "$release_script" || fail "release script must upload the slice archives and their index"
rg -q 'gpm-index\.toml' "$release_script" || fail "release script must assert the index was written before uploading"

# A release must not be publishable with the slices silently missing, and a
# developer's floating Homebrew gpm must not be able to cut one either.
rg -q 'GPM_SLICE_MINIMUM_VERSION' "$script" || fail "packaging must enforce the gpm version floor"
rg -q 'scripts/validate-addon-slices' "$script" || fail "packaging must validate its own slice cut"
for workflow in "$release_workflow" "$swift_workflow"; do
    rg -q 'scripts/install-gpm' "$workflow" ||
        fail "$workflow must install the pinned gpm via scripts/install-gpm"
done
# The packager pin lives only in scripts/gpm-slice-config; a workflow naming a
# gpm version of its own would be a second place to update.
if rg -q 'gpm-version|GPM_VERSION|brew install --cask cafecito-games/tap/gpm' "$release_workflow" "$swift_workflow"; then
    fail "workflows must not pin a gpm version separately from scripts/gpm-slice-config"
fi

# A release must not be publishable with the shim build skipped. scripts/release
# builds the shim itself and package-godot-addon re-validates every payload, so
# the release job only has to supply the pinned toolchain.
for workflow in "$release_workflow" "$swift_workflow"; do
    rg -q 'scripts/install-zig' "$workflow" ||
        fail "$workflow must install the pinned Zig toolchain via scripts/install-zig"
done
# The toolchain pin lives only in scripts/gdextension-shim-config; a workflow
# naming a zig version of its own would be a second place to update.
if rg -q 'zig-version|ZIG_VERSION|brew install zig' "$release_workflow" "$swift_workflow"; then
    fail "workflows must not pin a zig version separately from scripts/gdextension-shim-config"
fi

# The Linux job is the one that reproduces the defect, so the load gate belongs
# there rather than on the macOS packaging host.
rg -q "No GDExtension library found" "$swift_workflow" ||
    fail "the Linux job must fail on Godot's missing-library error text"

# --- Fail-closed contract ---------------------------------------------------
# Every row below must make packaging exit non-zero. Each case repackages from a
# pristine copy of the good inputs so the cases stay independent.
expect_packaging_failure() {
    local description=$1
    shift

    local case_dir
    case_dir=$(mktemp -d "$work_dir/case.XXXXXX")
    cp -R "$shim_dir" "$case_dir/shim"
    cp "$android_aar" "$case_dir/SwiftGodot.aar"

    local case_shim="$case_dir/shim"
    local case_aar="$case_dir/SwiftGodot.aar"
    # The mutation runs against the copies, via the two names above.
    "$@" "$case_shim" "$case_aar"

    if "$script" "v1.2.3-rc.1" "$xcframework" "$embed_xcframework" "$case_aar" "$case_shim" "$case_dir/output" >/dev/null 2>&1; then
        fail "packaging must fail: $description"
    fi
    if [[ -f "$case_dir/output/SwiftGodot-v1.2.3-rc.1.zip" ]]; then
        fail "a failed packaging run must publish no zip: $description"
    fi
}

# A release with no slices is a silent regression for every project that
# installs this addon through gpm, so a missing packager must fail the run rather
# than quietly producing the zip alone. The check is a preflight, so a stripped
# PATH never reaches the staging work.
no_gpm_dir=$(mktemp -d "$work_dir/no-gpm.XXXXXX")
if PATH=/usr/bin:/bin "$script" "v1.2.3-rc.1" "$xcframework" "$embed_xcframework" "$android_aar" "$shim_dir" "$no_gpm_dir" >/dev/null 2>&1; then
    fail "packaging must fail when gpm is not installed"
fi
[[ ! -f "$no_gpm_dir/SwiftGodot-v1.2.3-rc.1.zip" ]] ||
    fail "a run without gpm must publish no zip"

# gpm versions older than 0.6.1 refuse symlink entries in slice archives, so the
# preflight version floor must reject 0.6.0 up front without staging or zipping.
old_gpm_bin=$(mktemp -d "$work_dir/old-gpm-bin.XXXXXX")
cat > "$old_gpm_bin/gpm" <<'OLD_GPM'
#!/usr/bin/env bash
if [[ "${1:-}" == "--version" ]]; then
    echo "gpm version 0.6.0"
    exit 0
fi
echo "outdated gpm should never be invoked past --version" >&2
exit 1
OLD_GPM
chmod +x "$old_gpm_bin/gpm"
old_gpm_dir=$(mktemp -d "$work_dir/old-gpm-out.XXXXXX")
old_gpm_output=$(PATH="$old_gpm_bin:$PATH" "$script" "v1.2.3-rc.1" "$xcframework" "$embed_xcframework" "$android_aar" "$shim_dir" "$old_gpm_dir" 2>&1 && echo UNEXPECTED_SUCCESS || true)
printf '%s\n' "$old_gpm_output" | grep -q UNEXPECTED_SUCCESS &&
    fail "packaging must reject gpm 0.6.0 below the 0.6.1 symlink floor"
printf '%s\n' "$old_gpm_output" | grep -Fq "0.6.1" ||
    fail "outdated gpm rejection must name the 0.6.1 version floor"
[[ ! -f "$old_gpm_dir/SwiftGodot-v1.2.3-rc.1.zip" ]] ||
    fail "a run with an outdated gpm must publish no zip"

# An escaping symlink inside an input framework must fail closed and leave no
# standalone zip behind either.
escaping_xcframework_dir=$(mktemp -d "$work_dir/escaping-xcf.XXXXXX")
rsync -a "$xcframework" "$escaping_xcframework_dir/"
ln -s ../../../../../../etc/passwd "$escaping_xcframework_dir/SwiftGodot.xcframework/macos-arm64/SwiftGodot.framework/Versions/A/Resources/escape"
if "$script" "v1.2.3-rc.1" "$escaping_xcframework_dir/SwiftGodot.xcframework" "$embed_xcframework" "$android_aar" "$shim_dir" "$escaping_xcframework_dir/output" >/dev/null 2>&1; then
    fail "packaging must fail when an input framework contains an escaping symlink"
fi
[[ ! -f "$escaping_xcframework_dir/output/SwiftGodot-v1.2.3-rc.1.zip" ]] ||
    fail "a failed run on an escaping symlink must publish no zip"

delete_linux_payload() { rm -f "$1/linux_x86_64/libSwiftGodotEmbed.so"; }
expect_packaging_failure "a shim payload is missing" delete_linux_payload

truncate_windows_payload() { : > "$1/windows_x86_64/SwiftGodotEmbed.dll"; }
expect_packaging_failure "a shim payload is empty" truncate_windows_payload

substitute_macos_object() {
    local case_shim=$1
    cc -shared -o "$case_shim/linux_x86_64/libSwiftGodotEmbed.so" -x c - <<'OBJECT'
unsigned char swift_godot_embed_entry_point(void *a, void *b, void *c) { (void)a; (void)b; (void)c; return 1; }
OBJECT
}
expect_packaging_failure "a Linux payload is a macOS object" substitute_macos_object

substitute_wrong_architecture() {
    local case_shim=$1
    cp "$case_shim/linux_arm64/libSwiftGodotEmbed.so" "$case_shim/linux_x86_64/libSwiftGodotEmbed.so"
}
expect_packaging_failure "a Linux x86_64 payload targets arm64" substitute_wrong_architecture

# lld's MinGW driver exports every global symbol when it is handed no export
# list, which is why the shim build supplies a generated .def. A DLL whose export
# table names something else must not reach a release.
strip_windows_export() {
    local case_shim=$1
    local decoy_source="$case_shim/decoy.c"
    local decoy_exports="$case_shim/decoy.def"

    printf 'unsigned char unrelated_entry_point(void) { return 1; }\n' > "$decoy_source"
    printf 'EXPORTS\nunrelated_entry_point\n' > "$decoy_exports"
    zig cc -target x86_64-windows-gnu -shared -O2 -std=c11 -s \
        -o "$case_shim/windows_x86_64/SwiftGodotEmbed.dll" \
        "$decoy_source" "$decoy_exports"
    rm -f "$decoy_source" "$decoy_exports" "$case_shim/windows_x86_64/SwiftGodotEmbed.lib"
}
expect_packaging_failure "the DLL does not export the entry symbol" strip_windows_export

# A PE name forwarded to another DLL is present in the export table but resolves
# to someone else's function. GetProcAddress would hand Godot KERNEL32.Sleep, so
# the name alone must not satisfy the export check.
forward_windows_export() {
    local case_shim=$1
    local decoy_source="$case_shim/forward.c"
    local forward_exports="$case_shim/forward.def"

    printf 'unsigned char unrelated(void) { return 1; }\n' > "$decoy_source"
    printf 'EXPORTS\n%s = KERNEL32.Sleep\n' "$entry_symbol" > "$forward_exports"
    zig cc -target x86_64-windows-gnu -shared -O2 -std=c11 -s \
        -o "$case_shim/windows_x86_64/SwiftGodotEmbed.dll" \
        "$decoy_source" "$forward_exports"
    rm -f "$decoy_source" "$forward_exports" "$case_shim/windows_x86_64/SwiftGodotEmbed.lib"
}
expect_packaging_failure "the DLL forwards the entry symbol to another DLL" forward_windows_export

remove_aar_abi() {
    local case_shim=$1
    local case_aar=$2
    zip -qd "$case_aar" 'jni/x86_64/libSwiftGodotEmbed.so'
}
expect_packaging_failure "an android.* entry has no payload in the AAR" remove_aar_abi

# The validator must catch the class of defect, not just the three instances
# fixed here: a [libraries] entry for a platform with nothing staged fails.
undeclared_platform_dir=$(mktemp -d "$work_dir/undeclared.XXXXXX")
undeclared_addon="$undeclared_platform_dir/addons/SwiftGodot"
mkdir -p "$undeclared_addon"
cp -R "$stage_root/bin" "$undeclared_addon/bin"
sed 's#^linux\.arm64 = .*$#&\nlinux.riscv64 = "res://addons/SwiftGodot/bin/linux_riscv64/libSwiftGodotEmbed.so"#' \
    "$stage_root/SwiftGodotEmbed.gdextension" > "$undeclared_addon/SwiftGodotEmbed.gdextension"
if scripts/validate-godot-addon-libraries "$undeclared_addon" "$undeclared_addon/bin/android/SwiftGodot.aar" >/dev/null 2>&1; then
    fail "validation must fail for a [libraries] entry whose payload was never staged"
fi

# A directory-valued entry must not launder an unsupported platform past the
# check. Classification is by platform tag, so pointing an undeclared tag at a
# directory that happens to exist still fails.
directory_payload_dir=$(mktemp -d "$work_dir/directory-payload.XXXXXX")
directory_payload_addon="$directory_payload_dir/addons/SwiftGodot"
mkdir -p "$directory_payload_addon"
cp -R "$stage_root/bin" "$directory_payload_addon/bin"
sed 's#^linux\.arm64 = .*$#&\nlinux.riscv64 = "res://addons/SwiftGodot/bin/linux_x86_64"#' \
    "$stage_root/SwiftGodotEmbed.gdextension" > "$directory_payload_addon/SwiftGodotEmbed.gdextension"
if scripts/validate-godot-addon-libraries "$directory_payload_addon" "$directory_payload_addon/bin/android/SwiftGodot.aar" >/dev/null 2>&1; then
    fail "validation must fail for an unsupported platform pointed at an existing directory"
fi

# A supported native platform must not be satisfied by a directory either.
directory_library_dir=$(mktemp -d "$work_dir/directory-library.XXXXXX")
directory_library_addon="$directory_library_dir/addons/SwiftGodot"
mkdir -p "$directory_library_addon"
cp -R "$stage_root/bin" "$directory_library_addon/bin"
cp "$stage_root/SwiftGodotEmbed.gdextension" "$directory_library_addon/SwiftGodotEmbed.gdextension"
rm -f "$directory_library_addon/bin/linux_x86_64/libSwiftGodotEmbed.so"
mkdir -p "$directory_library_addon/bin/linux_x86_64/libSwiftGodotEmbed.so"
if scripts/validate-godot-addon-libraries "$directory_library_addon" "$directory_library_addon/bin/android/SwiftGodot.aar" >/dev/null 2>&1; then
    fail "validation must fail when a native library entry resolves to a directory"
fi

# The iOS-only rule is enforced over the staged tree, in both directions: a
# non-iOS slice declared by the Info.plist, and one sitting on disk under a plist
# that does not name it.
declared_macos_dir=$(mktemp -d "$work_dir/declared-macos.XXXXXX")
declared_macos_addon="$declared_macos_dir/addons/SwiftGodot"
mkdir -p "$declared_macos_addon"
cp -R "$stage_root/bin" "$declared_macos_addon/bin"
cp "$stage_root/SwiftGodotEmbed.gdextension" "$declared_macos_addon/SwiftGodotEmbed.gdextension"
rsync -aL "$xcframework/macos-arm64" "$declared_macos_addon/bin/ios/SwiftGodot.xcframework/"
cp "$xcframework/Info.plist" "$declared_macos_addon/bin/ios/SwiftGodot.xcframework/Info.plist"
if scripts/validate-godot-addon-libraries "$declared_macos_addon" "$declared_macos_addon/bin/android/SwiftGodot.aar" >/dev/null 2>&1; then
    fail "validation must fail when an xcframework under bin/ios declares a non-iOS slice"
fi

stray_slice_dir=$(mktemp -d "$work_dir/stray-slice.XXXXXX")
stray_slice_addon="$stray_slice_dir/addons/SwiftGodot"
mkdir -p "$stray_slice_addon"
cp -R "$stage_root/bin" "$stray_slice_addon/bin"
cp "$stage_root/SwiftGodotEmbed.gdextension" "$stray_slice_addon/SwiftGodotEmbed.gdextension"
rsync -aL "$xcframework/macos-arm64" "$stray_slice_addon/bin/ios/SwiftGodot.xcframework/"
if scripts/validate-godot-addon-libraries "$stray_slice_addon" "$stray_slice_addon/bin/android/SwiftGodot.aar" >/dev/null 2>&1; then
    fail "validation must fail when a slice sits under bin/ios that the Info.plist does not declare"
fi

# And the mirror image: a payload the shim builds but the addon never declares.
undeclared_entry_dir=$(mktemp -d "$work_dir/undeclared-entry.XXXXXX")
undeclared_entry_addon="$undeclared_entry_dir/addons/SwiftGodot"
mkdir -p "$undeclared_entry_addon"
cp -R "$stage_root/bin" "$undeclared_entry_addon/bin"
rg -v '^windows\.x86_64 = ' "$stage_root/SwiftGodotEmbed.gdextension" > "$undeclared_entry_addon/SwiftGodotEmbed.gdextension"
if scripts/validate-godot-addon-libraries "$undeclared_entry_addon" "$undeclared_entry_addon/bin/android/SwiftGodot.aar" >/dev/null 2>&1; then
    fail "validation must fail when a built shim platform has no [libraries] entry"
fi

# A dereferenced macOS framework under bin/macos_arm64 carries both a root
# binary and Versions/ at once, which codesign rejects as ambiguous. Library
# validation must reject that layout directly.
dereferenced_macos_dir=$(mktemp -d "$work_dir/dereferenced-macos.XXXXXX")
dereferenced_macos_addon="$dereferenced_macos_dir/addons/SwiftGodot"
mkdir -p "$dereferenced_macos_addon"
cp -R "$stage_root/bin" "$dereferenced_macos_addon/bin"
cp "$stage_root/SwiftGodotEmbed.gdextension" "$dereferenced_macos_addon/SwiftGodotEmbed.gdextension"
rm -rf "$dereferenced_macos_addon/bin/macos_arm64/SwiftGodot.framework"
rsync -aL "$xcframework/macos-arm64/SwiftGodot.framework" "$dereferenced_macos_addon/bin/macos_arm64/"
if scripts/validate-godot-addon-libraries "$dereferenced_macos_addon" "$dereferenced_macos_addon/bin/android/SwiftGodot.aar" >/dev/null 2>&1; then
    fail "validation must fail when a macOS framework under bin/macos_arm64 has dereferenced symlinks"
fi

# Apple and Android output is unchanged by the shim work: repackaging with the
# same Apple and Android inputs reproduces an identical tree for those slices.
rerun_dir="$work_dir/rerun"
"$script" "v1.2.3-rc.1" "$xcframework" "$embed_xcframework" "$android_aar" "$shim_dir" "$rerun_dir" >/dev/null
rerun_root="$rerun_dir/dist/addons/SwiftGodot"
for slice in bin/ios bin/macos_arm64 bin/android; do
    diff -r --no-dereference "$stage_root/$slice" "$rerun_root/$slice" >/dev/null ||
        fail "repackaging changed $slice"
done
diff -r --no-dereference "$stage_root" "$rerun_root" >/dev/null || fail "repackaging is not idempotent"

# gpm guarantees reproducible archives — sorted entries, fixed timestamps,
# normalized modes — so two cuts of an unchanged tree must be byte-identical. A
# cut that is not reproducible is a gpm bug worth reporting rather than tolerating.
diff -r --no-dereference "$slices_dir" "$rerun_dir/$GPM_SLICE_OUTPUT_SUBDIR" >/dev/null ||
    fail "repackaging produced different slice archives for an unchanged tree"

echo "Godot addon packaging tests passed"
