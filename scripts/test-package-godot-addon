#!/usr/bin/env bash
set -euo pipefail

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

script="scripts/package-godot-addon"
release_script="scripts/release"
swift_workflow=".github/workflows/swift.yml"
release_workflow=".github/workflows/release.yml"

[[ -x "$script" ]] || fail "package-godot-addon script must exist and be executable"

work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT

# Build a fake SwiftGodot xcframework with a versioned macOS framework, plus a
# minimal SwiftGodotEmbed xcframework. The two xcframeworks parallel what the
# release pipeline produces.
make_fake_xcframework() {
    local module=$1
    local xcf="$work_dir/$module.xcframework"
    local mac="$xcf/macos-arm64/$module.framework"

    mkdir -p \
        "$xcf/ios-arm64/$module.framework" \
        "$xcf/ios-arm64-simulator/$module.framework" \
        "$mac/Versions/A/Headers" \
        "$mac/Versions/A/Modules/$module.swiftmodule" \
        "$mac/Versions/A/Resources"

    printf 'fake xcframework plist\n' > "$xcf/Info.plist"
    printf 'fake ios device binary\n' > "$xcf/ios-arm64/$module.framework/$module"
    printf 'fake ios simulator binary\n' > "$xcf/ios-arm64-simulator/$module.framework/$module"
    printf 'fake macos binary\n' > "$mac/Versions/A/$module"
    printf 'fake header\n' > "$mac/Versions/A/Headers/$module-Swift.h"
    printf 'fake module\n' > "$mac/Versions/A/Modules/module.modulemap"
    printf 'fake swiftmodule\n' > "$mac/Versions/A/Modules/$module.swiftmodule/arm64-apple-macos.swiftmodule"
    printf 'fake plist\n' > "$mac/Versions/A/Resources/Info.plist"

    ln -s A "$mac/Versions/Current"
    ln -s Versions/Current/Headers "$mac/Headers"
    ln -s Versions/Current/Modules "$mac/Modules"
    ln -s Versions/Current/Resources "$mac/Resources"
    ln -s "Versions/Current/$module" "$mac/$module"

    printf '%s\n' "$xcf"
}

xcframework=$(make_fake_xcframework SwiftGodot)
embed_xcframework=$(make_fake_xcframework SwiftGodotEmbed)

# shellcheck source=gdextension-shim-config
source scripts/gdextension-shim-config
entry_symbol=$(gdextension_shim_entry_symbol)

# The android.* [libraries] entries point at bin/android/<abi>/ paths that
# deliberately do not exist in the addon tree; Godot resolves them from the
# exported APK, and the real objects live inside the AAR. The fixture therefore
# has to be a real zip with jni/<abi>/ entries so the validator can check them.
make_fake_android_aar() {
    local aar="$work_dir/SwiftGodot.aar"
    local staging="$work_dir/aar-staging"

    mkdir -p "$staging/jni/arm64-v8a" "$staging/jni/x86_64"
    printf 'fake manifest\n' > "$staging/AndroidManifest.xml"
    printf 'fake classes\n' > "$staging/classes.jar"
    printf 'fake arm64 embed\n' > "$staging/jni/arm64-v8a/libSwiftGodotEmbed.so"
    printf 'fake x86_64 embed\n' > "$staging/jni/x86_64/libSwiftGodotEmbed.so"
    (cd "$staging" && zip -qryX "$aar" .)

    printf '%s\n' "$aar"
}

android_aar=$(make_fake_android_aar)

shim_dir="$work_dir/shim"
scripts/build-gdextension-shim "$shim_dir" >/dev/null

output_dir="$work_dir/output"
"$script" "v1.2.3-rc.1" "$xcframework" "$embed_xcframework" "$android_aar" "$shim_dir" "$output_dir" >/dev/null

zip_path="$output_dir/SwiftGodot-v1.2.3-rc.1.zip"
[[ -f "$zip_path" ]] || fail "expected addon zip at $zip_path"

stage_root="$output_dir/dist/addons/SwiftGodot"
[[ -d "$stage_root" ]] || fail "expected staged addon tree at $stage_root"

extract_dir="$work_dir/extract"
mkdir -p "$extract_dir"
unzip -q "$zip_path" -d "$extract_dir"

addon="$extract_dir/addons/SwiftGodot"
[[ -d "$addon" ]] || fail "zip must extract to addons/SwiftGodot"
[[ "$(find "$extract_dir" -mindepth 1 -maxdepth 1 -type d -name addons | wc -l | tr -d ' ')" == "1" ]] || fail "zip must have only addons at the root"

[[ -f "$addon/plugin.cfg" ]] || fail "plugin.cfg missing"
[[ -f "$addon/export_plugin.gd" ]] || fail "export_plugin.gd missing"
[[ -f "$addon/LICENSE" ]] || fail "LICENSE missing"
cmp -s LICENSE "$addon/LICENSE" || fail "addon LICENSE must match repo LICENSE"
[[ -f "$addon/SwiftGodotEmbed.gdextension" ]] || fail "SwiftGodotEmbed.gdextension missing"
[[ -d "$addon/bin/ios/SwiftGodot.xcframework" ]] || fail "iOS SwiftGodot.xcframework missing"
[[ -d "$addon/bin/ios/SwiftGodotEmbed.xcframework" ]] || fail "iOS SwiftGodotEmbed.xcframework missing"
[[ -d "$addon/bin/macos_arm64/SwiftGodot.framework" ]] || fail "macOS SwiftGodot.framework missing"
[[ -d "$addon/bin/macos_arm64/SwiftGodotEmbed.framework" ]] || fail "macOS SwiftGodotEmbed.framework missing"
[[ -f "$addon/bin/android/SwiftGodot.aar" ]] || fail "Android SwiftGodot.aar missing"
cmp -s "$android_aar" "$addon/bin/android/SwiftGodot.aar" || fail "Android AAR must be copied without modification"

for entry in "${GDEXTENSION_SHIM_TARGETS[@]}"; do
    IFS='|' read -r _tag payload_dir payload_name _target _container _machine <<<"$entry"
    [[ -f "$addon/bin/$payload_dir/$payload_name" ]] || fail "$payload_dir/$payload_name missing from the addon"
    cmp -s "$shim_dir/$payload_dir/$payload_name" "$addon/bin/$payload_dir/$payload_name" ||
        fail "$payload_dir/$payload_name must be copied without modification"
    facts=$(scripts/inspect-native-library "$addon/bin/$payload_dir/$payload_name") ||
        fail "$payload_dir/$payload_name is not a loadable native library"
    printf '%s\n' "$facts" | sed -n 's/^exports=//p' | tr ' ' '\n' | grep -qx "$entry_symbol" ||
        fail "$payload_dir/$payload_name does not export $entry_symbol"
done

unexpected_addon_entries=$(find "$addon" -mindepth 1 -maxdepth 1 ! -name plugin.cfg ! -name export_plugin.gd ! -name LICENSE ! -name bin ! -name 'SwiftGodotEmbed.gdextension' -print)
[[ -z "$unexpected_addon_entries" ]] || fail "unexpected top-level addon entries: $unexpected_addon_entries"

bin_whitelist=(-name ios -o -name macos_arm64 -o -name android)
for entry in "${GDEXTENSION_SHIM_TARGETS[@]}"; do
    IFS='|' read -r _tag payload_dir _name _target _container _machine <<<"$entry"
    bin_whitelist+=(-o -name "$payload_dir")
done
unexpected_bin_entries=$(find "$addon/bin" -mindepth 1 -maxdepth 1 ! \( "${bin_whitelist[@]}" \) -print)
[[ -z "$unexpected_bin_entries" ]] || fail "unexpected bin entries: $unexpected_bin_entries"

# Only SwiftGodotEmbed.gdextension is allowed; nothing under bin/ should be a
# .gdextension file.
gdextension_files=$(find "$addon" -name '*.gdextension' -print)
if [[ "$gdextension_files" != "$addon/SwiftGodotEmbed.gdextension" ]]; then
    fail "expected only SwiftGodotEmbed.gdextension; got: $gdextension_files"
fi

if zipinfo -l "$zip_path" | awk '$1 ~ /^l/ { found = 1 } END { exit found ? 0 : 1 }'; then
    zipinfo -l "$zip_path" | awk '$1 ~ /^l/ { print }' >&2
    fail "SwiftGodot addon zip must not contain symlink entries; gpm refuses to extract them"
fi

if find "$addon" -type l -print | grep -q .; then
    find "$addon" -type l -print >&2
    fail "SwiftGodot addon zip must extract without symlinks"
fi

for forbidden in '*.swift' '*.h' '*.swiftmodule'; do
    if find "$addon" \
        \( -path "$addon/bin/ios/SwiftGodot.xcframework/*" \
           -o -path "$addon/bin/ios/SwiftGodotEmbed.xcframework/*" \
           -o -path "$addon/bin/macos_arm64/SwiftGodot.framework/*" \
           -o -path "$addon/bin/macos_arm64/SwiftGodotEmbed.framework/*" \) -prune \
        -o -name "$forbidden" -print | grep -q .; then
        fail "found $forbidden outside binary bundles"
    fi
done

expected_plugin="$work_dir/expected-plugin.cfg"
cat > "$expected_plugin" <<'EOF'
[plugin]
name="SwiftGodot"
description="Prebuilt SwiftGodot runtime for Android, iOS, and macOS GDExtensions, and a no-op SwiftGodotEmbed for Linux and Windows. Registers SwiftGodotEmbed and exports the Android AAR automatically."
author="cafecito-games"
version="1.2.3-rc.1"
script="export_plugin.gd"
EOF
cmp -s "$expected_plugin" "$addon/plugin.cfg" || {
    echo "Expected plugin.cfg:" >&2
    cat "$expected_plugin" >&2
    echo "Actual plugin.cfg:" >&2
    cat "$addon/plugin.cfg" >&2
    fail "plugin.cfg contents differ"
}

expected_gdextension="$work_dir/expected.gdextension"
cat > "$expected_gdextension" <<'EOF'
[configuration]
entry_symbol = "swift_godot_embed_entry_point"
compatibility_minimum = "4.7"
android_aar_plugin = true

[libraries]
android.debug.arm64 = "res://addons/SwiftGodot/bin/android/arm64-v8a/libSwiftGodotEmbed.so"
android.release.arm64 = "res://addons/SwiftGodot/bin/android/arm64-v8a/libSwiftGodotEmbed.so"
android.debug.x86_64 = "res://addons/SwiftGodot/bin/android/x86_64/libSwiftGodotEmbed.so"
android.release.x86_64 = "res://addons/SwiftGodot/bin/android/x86_64/libSwiftGodotEmbed.so"
ios.debug = "res://addons/SwiftGodot/bin/ios/SwiftGodotEmbed.xcframework"
ios.release = "res://addons/SwiftGodot/bin/ios/SwiftGodotEmbed.xcframework"
ios.simulator.debug = "res://addons/SwiftGodot/bin/ios/SwiftGodotEmbed.xcframework"
ios.simulator.release = "res://addons/SwiftGodot/bin/ios/SwiftGodotEmbed.xcframework"
macos.arm64 = "res://addons/SwiftGodot/bin/macos_arm64/SwiftGodotEmbed.framework"
linux.x86_64 = "res://addons/SwiftGodot/bin/linux_x86_64/libSwiftGodotEmbed.so"
linux.arm64 = "res://addons/SwiftGodot/bin/linux_arm64/libSwiftGodotEmbed.so"
windows.x86_64 = "res://addons/SwiftGodot/bin/windows_x86_64/SwiftGodotEmbed.dll"

[dependencies]
ios.debug = { "res://addons/SwiftGodot/bin/ios/SwiftGodot.xcframework": "" }
ios.release = { "res://addons/SwiftGodot/bin/ios/SwiftGodot.xcframework": "" }
ios.simulator.debug = { "res://addons/SwiftGodot/bin/ios/SwiftGodot.xcframework": "" }
ios.simulator.release = { "res://addons/SwiftGodot/bin/ios/SwiftGodot.xcframework": "" }
macos.arm64 = { "res://addons/SwiftGodot/bin/macos_arm64/SwiftGodot.framework": "" }
EOF
cmp -s "$expected_gdextension" "$addon/SwiftGodotEmbed.gdextension" || {
    echo "Expected SwiftGodotEmbed.gdextension:" >&2
    cat "$expected_gdextension" >&2
    echo "Actual SwiftGodotEmbed.gdextension:" >&2
    cat "$addon/SwiftGodotEmbed.gdextension" >&2
    fail "SwiftGodotEmbed.gdextension contents differ"
}

rg -q '^extends EditorPlugin$' "$addon/export_plugin.gd" || fail "export plugin must extend EditorPlugin"
rg -q 'add_export_plugin\(export_plugin\)' "$addon/export_plugin.gd" || fail "export plugin must register its Android export hook"
rg -q 'platform is EditorExportPlatformAndroid' "$addon/export_plugin.gd" || fail "export plugin must support Android"
rg -q 'res://addons/SwiftGodot/bin/android/SwiftGodot\.aar' "$addon/export_plugin.gd" || fail "export plugin must return the packaged Android AAR"
rg -q '^\s*func _get_name\(\):' "$addon/export_plugin.gd" || fail "Android export plugin must have a stable name"

for module in SwiftGodot SwiftGodotEmbed; do
    framework="$addon/bin/macos_arm64/$module.framework"
    [[ -f "$framework/Versions/A/$module" ]] || fail "macOS $module.framework must keep Versions/A/$module for its install name"
    [[ -f "$framework/Versions/Current/$module" ]] || fail "macOS $module.framework must materialize Versions/Current/$module"
    [[ -f "$framework/$module" ]] || fail "macOS $module.framework must materialize root binary"
    [[ -d "$framework/Headers" ]] || fail "macOS $module.framework must materialize root Headers directory"
    [[ -d "$framework/Modules" ]] || fail "macOS $module.framework must materialize root Modules directory"
done

rg -q 'scripts/package-godot-addon "\$tag" "\$output_dir/SwiftGodot\.xcframework" "\$output_dir/SwiftGodotEmbed\.xcframework" "\$android_aar" "\$shim_dir" "\$output_dir"' "$release_script" || fail "release script must package the Godot addon from Apple artifacts, the Android AAR, and the GDExtension shim"
rg -q 'scripts/build-gdextension-shim "\$shim_dir"' "$release_script" || fail "release script must build the GDExtension shim before packaging the addon"
rg -q '! -x scripts/build-gdextension-shim' "$release_script" || fail "release script must require scripts/build-gdextension-shim up front"
rg -q 'SwiftGodot-\$tag\.zip' "$release_script" || fail "release script must name the addon zip SwiftGodot-\$tag.zip"
rg -q 'gh release create "\$tag" "\$zip_path" "\$gdextension_zip_path" "\$macro_zip_path" "\$android_aar" "\$addon_zip_path"' "$release_script" || fail "release script must upload the binary artifacts, Android AAR, and addon zip"
if rg -q 'no longer using vXXX|v-prefixed tags|\[\[ "\$RELEASE_TAG" == v\* \]\]' "$release_script" .github/workflows/release.yml; then
    fail "release path must allow v-prefixed tags for Godot addon assets"
fi
rg -q '^package-godot-addon:' Makefile || fail "Makefile must expose package-godot-addon"
rg -q 'scripts/package-godot-addon "\$\$tag" "\$\$xcframework" "\$\$embed_xcframework" "\$\$android_aar" "\$\$shim_dir" "\$\$output_dir"' Makefile || fail "Makefile must pass the Android AAR and the GDExtension shim to package-godot-addon"
rg -q 'scripts/build-gdextension-shim "\$\$shim_dir"' Makefile || fail "Makefile must build the GDExtension shim before packaging the addon"
rg -q 'scripts/test-package-godot-addon' "$swift_workflow" || fail "CI must run package-godot-addon regression tests"
rg -q 'scripts/test-build-gdextension-shim' "$swift_workflow" || fail "CI must run the GDExtension shim build tests"

# A release must not be publishable with the shim build skipped. scripts/release
# builds the shim itself and package-godot-addon re-validates every payload, so
# the release job only has to supply the pinned toolchain.
for workflow in "$release_workflow" "$swift_workflow"; do
    rg -q 'scripts/install-zig' "$workflow" ||
        fail "$workflow must install the pinned Zig toolchain via scripts/install-zig"
done
# The toolchain pin lives only in scripts/gdextension-shim-config; a workflow
# naming a zig version of its own would be a second place to update.
if rg -q 'zig-version|ZIG_VERSION|brew install zig' "$release_workflow" "$swift_workflow"; then
    fail "workflows must not pin a zig version separately from scripts/gdextension-shim-config"
fi

# The Linux job is the one that reproduces the defect, so the load gate belongs
# there rather than on the macOS packaging host.
rg -q "No GDExtension library found" "$swift_workflow" ||
    fail "the Linux job must fail on Godot's missing-library error text"

# --- Fail-closed contract ---------------------------------------------------
# Every row below must make packaging exit non-zero. Each case repackages from a
# pristine copy of the good inputs so the cases stay independent.
expect_packaging_failure() {
    local description=$1
    shift

    local case_dir
    case_dir=$(mktemp -d "$work_dir/case.XXXXXX")
    cp -R "$shim_dir" "$case_dir/shim"
    cp "$android_aar" "$case_dir/SwiftGodot.aar"

    local case_shim="$case_dir/shim"
    local case_aar="$case_dir/SwiftGodot.aar"
    # The mutation runs against the copies, via the two names above.
    "$@" "$case_shim" "$case_aar"

    if "$script" "v1.2.3-rc.1" "$xcframework" "$embed_xcframework" "$case_aar" "$case_shim" "$case_dir/output" >/dev/null 2>&1; then
        fail "packaging must fail: $description"
    fi
    if [[ -f "$case_dir/output/SwiftGodot-v1.2.3-rc.1.zip" ]]; then
        fail "a failed packaging run must publish no zip: $description"
    fi
}

delete_linux_payload() { rm -f "$1/linux_x86_64/libSwiftGodotEmbed.so"; }
expect_packaging_failure "a shim payload is missing" delete_linux_payload

truncate_windows_payload() { : > "$1/windows_x86_64/SwiftGodotEmbed.dll"; }
expect_packaging_failure "a shim payload is empty" truncate_windows_payload

substitute_macos_object() {
    local case_shim=$1
    cc -shared -o "$case_shim/linux_x86_64/libSwiftGodotEmbed.so" -x c - <<'OBJECT'
unsigned char swift_godot_embed_entry_point(void *a, void *b, void *c) { (void)a; (void)b; (void)c; return 1; }
OBJECT
}
expect_packaging_failure "a Linux payload is a macOS object" substitute_macos_object

substitute_wrong_architecture() {
    local case_shim=$1
    cp "$case_shim/linux_arm64/libSwiftGodotEmbed.so" "$case_shim/linux_x86_64/libSwiftGodotEmbed.so"
}
expect_packaging_failure "a Linux x86_64 payload targets arm64" substitute_wrong_architecture

# lld's MinGW driver exports every global symbol when it is handed no export
# list, which is why the shim build supplies a generated .def. A DLL whose export
# table names something else must not reach a release.
strip_windows_export() {
    local case_shim=$1
    local decoy_source="$case_shim/decoy.c"
    local decoy_exports="$case_shim/decoy.def"

    printf 'unsigned char unrelated_entry_point(void) { return 1; }\n' > "$decoy_source"
    printf 'EXPORTS\nunrelated_entry_point\n' > "$decoy_exports"
    zig cc -target x86_64-windows-gnu -shared -O2 -std=c11 -s \
        -o "$case_shim/windows_x86_64/SwiftGodotEmbed.dll" \
        "$decoy_source" "$decoy_exports"
    rm -f "$decoy_source" "$decoy_exports" "$case_shim/windows_x86_64/SwiftGodotEmbed.lib"
}
expect_packaging_failure "the DLL does not export the entry symbol" strip_windows_export

# A PE name forwarded to another DLL is present in the export table but resolves
# to someone else's function. GetProcAddress would hand Godot KERNEL32.Sleep, so
# the name alone must not satisfy the export check.
forward_windows_export() {
    local case_shim=$1
    local decoy_source="$case_shim/forward.c"
    local forward_exports="$case_shim/forward.def"

    printf 'unsigned char unrelated(void) { return 1; }\n' > "$decoy_source"
    printf 'EXPORTS\n%s = KERNEL32.Sleep\n' "$entry_symbol" > "$forward_exports"
    zig cc -target x86_64-windows-gnu -shared -O2 -std=c11 -s \
        -o "$case_shim/windows_x86_64/SwiftGodotEmbed.dll" \
        "$decoy_source" "$forward_exports"
    rm -f "$decoy_source" "$forward_exports" "$case_shim/windows_x86_64/SwiftGodotEmbed.lib"
}
expect_packaging_failure "the DLL forwards the entry symbol to another DLL" forward_windows_export

remove_aar_abi() {
    local case_shim=$1
    local case_aar=$2
    zip -qd "$case_aar" 'jni/x86_64/libSwiftGodotEmbed.so'
}
expect_packaging_failure "an android.* entry has no payload in the AAR" remove_aar_abi

# The validator must catch the class of defect, not just the three instances
# fixed here: a [libraries] entry for a platform with nothing staged fails.
undeclared_platform_dir=$(mktemp -d "$work_dir/undeclared.XXXXXX")
undeclared_addon="$undeclared_platform_dir/addons/SwiftGodot"
mkdir -p "$undeclared_addon"
cp -R "$stage_root/bin" "$undeclared_addon/bin"
sed 's#^linux\.arm64 = .*$#&\nlinux.riscv64 = "res://addons/SwiftGodot/bin/linux_riscv64/libSwiftGodotEmbed.so"#' \
    "$stage_root/SwiftGodotEmbed.gdextension" > "$undeclared_addon/SwiftGodotEmbed.gdextension"
if scripts/validate-godot-addon-libraries "$undeclared_addon" "$undeclared_addon/bin/android/SwiftGodot.aar" >/dev/null 2>&1; then
    fail "validation must fail for a [libraries] entry whose payload was never staged"
fi

# A directory-valued entry must not launder an unsupported platform past the
# check. Classification is by platform tag, so pointing an undeclared tag at a
# directory that happens to exist still fails.
directory_payload_dir=$(mktemp -d "$work_dir/directory-payload.XXXXXX")
directory_payload_addon="$directory_payload_dir/addons/SwiftGodot"
mkdir -p "$directory_payload_addon"
cp -R "$stage_root/bin" "$directory_payload_addon/bin"
sed 's#^linux\.arm64 = .*$#&\nlinux.riscv64 = "res://addons/SwiftGodot/bin/linux_x86_64"#' \
    "$stage_root/SwiftGodotEmbed.gdextension" > "$directory_payload_addon/SwiftGodotEmbed.gdextension"
if scripts/validate-godot-addon-libraries "$directory_payload_addon" "$directory_payload_addon/bin/android/SwiftGodot.aar" >/dev/null 2>&1; then
    fail "validation must fail for an unsupported platform pointed at an existing directory"
fi

# A supported native platform must not be satisfied by a directory either.
directory_library_dir=$(mktemp -d "$work_dir/directory-library.XXXXXX")
directory_library_addon="$directory_library_dir/addons/SwiftGodot"
mkdir -p "$directory_library_addon"
cp -R "$stage_root/bin" "$directory_library_addon/bin"
cp "$stage_root/SwiftGodotEmbed.gdextension" "$directory_library_addon/SwiftGodotEmbed.gdextension"
rm -f "$directory_library_addon/bin/linux_x86_64/libSwiftGodotEmbed.so"
mkdir -p "$directory_library_addon/bin/linux_x86_64/libSwiftGodotEmbed.so"
if scripts/validate-godot-addon-libraries "$directory_library_addon" "$directory_library_addon/bin/android/SwiftGodot.aar" >/dev/null 2>&1; then
    fail "validation must fail when a native library entry resolves to a directory"
fi

# And the mirror image: a payload the shim builds but the addon never declares.
undeclared_entry_dir=$(mktemp -d "$work_dir/undeclared-entry.XXXXXX")
undeclared_entry_addon="$undeclared_entry_dir/addons/SwiftGodot"
mkdir -p "$undeclared_entry_addon"
cp -R "$stage_root/bin" "$undeclared_entry_addon/bin"
rg -v '^windows\.x86_64 = ' "$stage_root/SwiftGodotEmbed.gdextension" > "$undeclared_entry_addon/SwiftGodotEmbed.gdextension"
if scripts/validate-godot-addon-libraries "$undeclared_entry_addon" "$undeclared_entry_addon/bin/android/SwiftGodot.aar" >/dev/null 2>&1; then
    fail "validation must fail when a built shim platform has no [libraries] entry"
fi

# Apple and Android output is unchanged by the shim work: repackaging with the
# same Apple and Android inputs reproduces an identical tree for those slices.
rerun_dir="$work_dir/rerun"
"$script" "v1.2.3-rc.1" "$xcframework" "$embed_xcframework" "$android_aar" "$shim_dir" "$rerun_dir" >/dev/null
rerun_root="$rerun_dir/dist/addons/SwiftGodot"
for slice in bin/ios bin/macos_arm64 bin/android; do
    diff -r "$stage_root/$slice" "$rerun_root/$slice" >/dev/null ||
        fail "repackaging changed $slice"
done
diff -r "$stage_root" "$rerun_root" >/dev/null || fail "repackaging is not idempotent"

echo "Godot addon packaging tests passed"
