#!/usr/bin/env bash
set -euo pipefail

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

script="scripts/package-godot-addon"
release_script="scripts/release"
swift_workflow=".github/workflows/swift.yml"

[[ -x "$script" ]] || fail "package-godot-addon script must exist and be executable"

work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT

xcframework="$work_dir/SwiftGodot.xcframework"
mac_framework="$xcframework/macos-arm64/SwiftGodot.framework"

mkdir -p \
    "$xcframework/ios-arm64/SwiftGodot.framework" \
    "$xcframework/ios-arm64-simulator/SwiftGodot.framework" \
    "$mac_framework/Versions/A/Headers" \
    "$mac_framework/Versions/A/Modules/SwiftGodot.swiftmodule" \
    "$mac_framework/Versions/A/Resources"

printf 'fake xcframework plist\n' > "$xcframework/Info.plist"
printf 'fake ios device binary\n' > "$xcframework/ios-arm64/SwiftGodot.framework/SwiftGodot"
printf 'fake ios simulator binary\n' > "$xcframework/ios-arm64-simulator/SwiftGodot.framework/SwiftGodot"
printf 'fake macos binary\n' > "$mac_framework/Versions/A/SwiftGodot"
printf 'fake header\n' > "$mac_framework/Versions/A/Headers/SwiftGodot-Swift.h"
printf 'fake module\n' > "$mac_framework/Versions/A/Modules/module.modulemap"
printf 'fake swiftmodule\n' > "$mac_framework/Versions/A/Modules/SwiftGodot.swiftmodule/arm64-apple-macos.swiftmodule"
printf 'fake plist\n' > "$mac_framework/Versions/A/Resources/Info.plist"

ln -s A "$mac_framework/Versions/Current"
ln -s Versions/Current/Headers "$mac_framework/Headers"
ln -s Versions/Current/Modules "$mac_framework/Modules"
ln -s Versions/Current/Resources "$mac_framework/Resources"
ln -s Versions/Current/SwiftGodot "$mac_framework/SwiftGodot"

output_dir="$work_dir/output"
"$script" "v1.2.3-rc.1" "$xcframework" "$output_dir" >/dev/null

zip_path="$output_dir/SwiftGodot-v1.2.3-rc.1.zip"
[[ -f "$zip_path" ]] || fail "expected addon zip at $zip_path"

stage_root="$output_dir/dist/addons/SwiftGodot"
[[ -d "$stage_root" ]] || fail "expected staged addon tree at $stage_root"

extract_dir="$work_dir/extract"
mkdir -p "$extract_dir"
unzip -q "$zip_path" -d "$extract_dir"

addon="$extract_dir/addons/SwiftGodot"
[[ -d "$addon" ]] || fail "zip must extract to addons/SwiftGodot"
[[ "$(find "$extract_dir" -mindepth 1 -maxdepth 1 -type d -name addons | wc -l | tr -d ' ')" == "1" ]] || fail "zip must have only addons at the root"

[[ -f "$addon/plugin.cfg" ]] || fail "plugin.cfg missing"
[[ -f "$addon/LICENSE" ]] || fail "LICENSE missing"
cmp -s LICENSE "$addon/LICENSE" || fail "addon LICENSE must match repo LICENSE"
[[ -d "$addon/bin/ios/SwiftGodot.xcframework" ]] || fail "iOS SwiftGodot.xcframework missing"
[[ -d "$addon/bin/macos_arm64/SwiftGodot.framework" ]] || fail "macOS SwiftGodot.framework missing"

unexpected_addon_entries=$(find "$addon" -mindepth 1 -maxdepth 1 ! -name plugin.cfg ! -name LICENSE ! -name bin -print)
[[ -z "$unexpected_addon_entries" ]] || fail "unexpected top-level addon entries: $unexpected_addon_entries"

unexpected_bin_entries=$(find "$addon/bin" -mindepth 1 -maxdepth 1 ! -name ios ! -name macos_arm64 -print)
[[ -z "$unexpected_bin_entries" ]] || fail "unexpected bin entries: $unexpected_bin_entries"

if find "$addon" -name '*.gdextension' -print | grep -q .; then
    fail "SwiftGodot addon zip must not contain a .gdextension file"
fi

for forbidden in '*.swift' '*.h' '*.swiftmodule'; do
    if find "$addon" \
        \( -path "$addon/bin/ios/SwiftGodot.xcframework/*" -o -path "$addon/bin/macos_arm64/SwiftGodot.framework/*" \) -prune \
        -o -name "$forbidden" -print | grep -q .; then
        fail "found $forbidden outside binary bundles"
    fi
done

expected_plugin="$work_dir/expected-plugin.cfg"
cat > "$expected_plugin" <<'EOF'
[plugin]
name="SwiftGodot"
description="Shared SwiftGodot xcframework/framework for iOS/macOS GDExtensions. Binary-only addon; consumed via `[dependencies]` of other gdextensions."
author="cafecito-games"
version="1.2.3-rc.1"
script=""
EOF
cmp -s "$expected_plugin" "$addon/plugin.cfg" || {
    echo "Expected plugin.cfg:" >&2
    cat "$expected_plugin" >&2
    echo "Actual plugin.cfg:" >&2
    cat "$addon/plugin.cfg" >&2
    fail "plugin.cfg contents differ"
}

unzipped_mac_framework="$addon/bin/macos_arm64/SwiftGodot.framework"
[[ -L "$unzipped_mac_framework/Versions/Current" ]] || fail "Versions/Current must remain a symlink"
[[ "$(readlink "$unzipped_mac_framework/Versions/Current")" == "A" ]] || fail "Versions/Current symlink must point to A"
[[ -L "$unzipped_mac_framework/SwiftGodot" ]] || fail "framework binary root symlink must remain intact"
[[ "$(readlink "$unzipped_mac_framework/SwiftGodot")" == "Versions/Current/SwiftGodot" ]] || fail "framework binary symlink must point through Versions/Current"

rg -q 'scripts/package-godot-addon "\$tag" "\$output_dir/SwiftGodot\.xcframework" "\$output_dir"' "$release_script" || fail "release script must package the Godot addon from the release xcframework"
rg -q 'SwiftGodot-\$tag\.zip' "$release_script" || fail "release script must name the addon zip SwiftGodot-\$tag.zip"
rg -q 'gh release create "\$tag" "\$zip_path" "\$macro_zip_path" "\$addon_zip_path"' "$release_script" || fail "release script must upload the addon zip with the release assets"
if rg -q 'no longer using vXXX|v-prefixed tags|\[\[ "\$RELEASE_TAG" == v\* \]\]' "$release_script" .github/workflows/release.yml; then
    fail "release path must allow v-prefixed tags for Godot addon assets"
fi
rg -q '^package-godot-addon:' Makefile || fail "Makefile must expose package-godot-addon"
rg -q 'scripts/test-package-godot-addon' "$swift_workflow" || fail "CI must run package-godot-addon regression tests"

echo "Godot addon packaging tests passed"
