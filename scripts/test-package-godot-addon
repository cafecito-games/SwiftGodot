#!/usr/bin/env bash
set -euo pipefail

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

script="scripts/package-godot-addon"
release_script="scripts/release"
swift_workflow=".github/workflows/swift.yml"

[[ -x "$script" ]] || fail "package-godot-addon script must exist and be executable"

work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT

# Build a fake SwiftGodot xcframework with a versioned macOS framework, plus a
# minimal SwiftGodotEmbed xcframework. The two xcframeworks parallel what the
# release pipeline produces.
make_fake_xcframework() {
    local module=$1
    local xcf="$work_dir/$module.xcframework"
    local mac="$xcf/macos-arm64/$module.framework"

    mkdir -p \
        "$xcf/ios-arm64/$module.framework" \
        "$xcf/ios-arm64-simulator/$module.framework" \
        "$mac/Versions/A/Headers" \
        "$mac/Versions/A/Modules/$module.swiftmodule" \
        "$mac/Versions/A/Resources"

    printf 'fake xcframework plist\n' > "$xcf/Info.plist"
    printf 'fake ios device binary\n' > "$xcf/ios-arm64/$module.framework/$module"
    printf 'fake ios simulator binary\n' > "$xcf/ios-arm64-simulator/$module.framework/$module"
    printf 'fake macos binary\n' > "$mac/Versions/A/$module"
    printf 'fake header\n' > "$mac/Versions/A/Headers/$module-Swift.h"
    printf 'fake module\n' > "$mac/Versions/A/Modules/module.modulemap"
    printf 'fake swiftmodule\n' > "$mac/Versions/A/Modules/$module.swiftmodule/arm64-apple-macos.swiftmodule"
    printf 'fake plist\n' > "$mac/Versions/A/Resources/Info.plist"

    ln -s A "$mac/Versions/Current"
    ln -s Versions/Current/Headers "$mac/Headers"
    ln -s Versions/Current/Modules "$mac/Modules"
    ln -s Versions/Current/Resources "$mac/Resources"
    ln -s "Versions/Current/$module" "$mac/$module"

    printf '%s\n' "$xcf"
}

xcframework=$(make_fake_xcframework SwiftGodot)
embed_xcframework=$(make_fake_xcframework SwiftGodotEmbed)
android_aar="$work_dir/SwiftGodot.aar"
printf 'fake Android AAR\n' > "$android_aar"

output_dir="$work_dir/output"
"$script" "v1.2.3-rc.1" "$xcframework" "$embed_xcframework" "$android_aar" "$output_dir" >/dev/null

zip_path="$output_dir/SwiftGodot-v1.2.3-rc.1.zip"
[[ -f "$zip_path" ]] || fail "expected addon zip at $zip_path"

stage_root="$output_dir/dist/addons/SwiftGodot"
[[ -d "$stage_root" ]] || fail "expected staged addon tree at $stage_root"

extract_dir="$work_dir/extract"
mkdir -p "$extract_dir"
unzip -q "$zip_path" -d "$extract_dir"

addon="$extract_dir/addons/SwiftGodot"
[[ -d "$addon" ]] || fail "zip must extract to addons/SwiftGodot"
[[ "$(find "$extract_dir" -mindepth 1 -maxdepth 1 -type d -name addons | wc -l | tr -d ' ')" == "1" ]] || fail "zip must have only addons at the root"

[[ -f "$addon/plugin.cfg" ]] || fail "plugin.cfg missing"
[[ -f "$addon/export_plugin.gd" ]] || fail "export_plugin.gd missing"
[[ -f "$addon/LICENSE" ]] || fail "LICENSE missing"
cmp -s LICENSE "$addon/LICENSE" || fail "addon LICENSE must match repo LICENSE"
[[ -f "$addon/SwiftGodotEmbed.gdextension" ]] || fail "SwiftGodotEmbed.gdextension missing"
[[ -d "$addon/bin/ios/SwiftGodot.xcframework" ]] || fail "iOS SwiftGodot.xcframework missing"
[[ -d "$addon/bin/ios/SwiftGodotEmbed.xcframework" ]] || fail "iOS SwiftGodotEmbed.xcframework missing"
[[ -d "$addon/bin/macos_arm64/SwiftGodot.framework" ]] || fail "macOS SwiftGodot.framework missing"
[[ -d "$addon/bin/macos_arm64/SwiftGodotEmbed.framework" ]] || fail "macOS SwiftGodotEmbed.framework missing"
[[ -f "$addon/bin/android/SwiftGodot.aar" ]] || fail "Android SwiftGodot.aar missing"
cmp -s "$android_aar" "$addon/bin/android/SwiftGodot.aar" || fail "Android AAR must be copied without modification"

unexpected_addon_entries=$(find "$addon" -mindepth 1 -maxdepth 1 ! -name plugin.cfg ! -name export_plugin.gd ! -name LICENSE ! -name bin ! -name 'SwiftGodotEmbed.gdextension' -print)
[[ -z "$unexpected_addon_entries" ]] || fail "unexpected top-level addon entries: $unexpected_addon_entries"

unexpected_bin_entries=$(find "$addon/bin" -mindepth 1 -maxdepth 1 ! -name ios ! -name macos_arm64 ! -name android -print)
[[ -z "$unexpected_bin_entries" ]] || fail "unexpected bin entries: $unexpected_bin_entries"

# Only SwiftGodotEmbed.gdextension is allowed; nothing under bin/ should be a
# .gdextension file.
gdextension_files=$(find "$addon" -name '*.gdextension' -print)
if [[ "$gdextension_files" != "$addon/SwiftGodotEmbed.gdextension" ]]; then
    fail "expected only SwiftGodotEmbed.gdextension; got: $gdextension_files"
fi

if zipinfo -l "$zip_path" | awk '$1 ~ /^l/ { found = 1 } END { exit found ? 0 : 1 }'; then
    zipinfo -l "$zip_path" | awk '$1 ~ /^l/ { print }' >&2
    fail "SwiftGodot addon zip must not contain symlink entries; gpm refuses to extract them"
fi

if find "$addon" -type l -print | grep -q .; then
    find "$addon" -type l -print >&2
    fail "SwiftGodot addon zip must extract without symlinks"
fi

for forbidden in '*.swift' '*.h' '*.swiftmodule'; do
    if find "$addon" \
        \( -path "$addon/bin/ios/SwiftGodot.xcframework/*" \
           -o -path "$addon/bin/ios/SwiftGodotEmbed.xcframework/*" \
           -o -path "$addon/bin/macos_arm64/SwiftGodot.framework/*" \
           -o -path "$addon/bin/macos_arm64/SwiftGodotEmbed.framework/*" \) -prune \
        -o -name "$forbidden" -print | grep -q .; then
        fail "found $forbidden outside binary bundles"
    fi
done

expected_plugin="$work_dir/expected-plugin.cfg"
cat > "$expected_plugin" <<'EOF'
[plugin]
name="SwiftGodot"
description="Prebuilt SwiftGodot runtime for Android, iOS, and macOS GDExtensions. Registers SwiftGodotEmbed and exports the Android AAR automatically."
author="cafecito-games"
version="1.2.3-rc.1"
script="export_plugin.gd"
EOF
cmp -s "$expected_plugin" "$addon/plugin.cfg" || {
    echo "Expected plugin.cfg:" >&2
    cat "$expected_plugin" >&2
    echo "Actual plugin.cfg:" >&2
    cat "$addon/plugin.cfg" >&2
    fail "plugin.cfg contents differ"
}

expected_gdextension="$work_dir/expected.gdextension"
cat > "$expected_gdextension" <<'EOF'
[configuration]
entry_symbol = "swift_godot_embed_entry_point"
compatibility_minimum = "4.7"
android_aar_plugin = true

[libraries]
android.debug.arm64 = "res://addons/SwiftGodot/bin/android/arm64-v8a/libSwiftGodotEmbed.so"
android.release.arm64 = "res://addons/SwiftGodot/bin/android/arm64-v8a/libSwiftGodotEmbed.so"
android.debug.x86_64 = "res://addons/SwiftGodot/bin/android/x86_64/libSwiftGodotEmbed.so"
android.release.x86_64 = "res://addons/SwiftGodot/bin/android/x86_64/libSwiftGodotEmbed.so"
ios.debug = "res://addons/SwiftGodot/bin/ios/SwiftGodotEmbed.xcframework"
ios.release = "res://addons/SwiftGodot/bin/ios/SwiftGodotEmbed.xcframework"
ios.simulator.debug = "res://addons/SwiftGodot/bin/ios/SwiftGodotEmbed.xcframework"
ios.simulator.release = "res://addons/SwiftGodot/bin/ios/SwiftGodotEmbed.xcframework"
macos.arm64 = "res://addons/SwiftGodot/bin/macos_arm64/SwiftGodotEmbed.framework"

[dependencies]
ios.debug = { "res://addons/SwiftGodot/bin/ios/SwiftGodot.xcframework": "" }
ios.release = { "res://addons/SwiftGodot/bin/ios/SwiftGodot.xcframework": "" }
ios.simulator.debug = { "res://addons/SwiftGodot/bin/ios/SwiftGodot.xcframework": "" }
ios.simulator.release = { "res://addons/SwiftGodot/bin/ios/SwiftGodot.xcframework": "" }
macos.arm64 = { "res://addons/SwiftGodot/bin/macos_arm64/SwiftGodot.framework": "" }
EOF
cmp -s "$expected_gdextension" "$addon/SwiftGodotEmbed.gdextension" || {
    echo "Expected SwiftGodotEmbed.gdextension:" >&2
    cat "$expected_gdextension" >&2
    echo "Actual SwiftGodotEmbed.gdextension:" >&2
    cat "$addon/SwiftGodotEmbed.gdextension" >&2
    fail "SwiftGodotEmbed.gdextension contents differ"
}

rg -q '^extends EditorPlugin$' "$addon/export_plugin.gd" || fail "export plugin must extend EditorPlugin"
rg -q 'add_export_plugin\(export_plugin\)' "$addon/export_plugin.gd" || fail "export plugin must register its Android export hook"
rg -q 'platform is EditorExportPlatformAndroid' "$addon/export_plugin.gd" || fail "export plugin must support Android"
rg -q 'res://addons/SwiftGodot/bin/android/SwiftGodot\.aar' "$addon/export_plugin.gd" || fail "export plugin must return the packaged Android AAR"
rg -q '^\s*func _get_name\(\):' "$addon/export_plugin.gd" || fail "Android export plugin must have a stable name"

for module in SwiftGodot SwiftGodotEmbed; do
    framework="$addon/bin/macos_arm64/$module.framework"
    [[ -f "$framework/Versions/A/$module" ]] || fail "macOS $module.framework must keep Versions/A/$module for its install name"
    [[ -f "$framework/Versions/Current/$module" ]] || fail "macOS $module.framework must materialize Versions/Current/$module"
    [[ -f "$framework/$module" ]] || fail "macOS $module.framework must materialize root binary"
    [[ -d "$framework/Headers" ]] || fail "macOS $module.framework must materialize root Headers directory"
    [[ -d "$framework/Modules" ]] || fail "macOS $module.framework must materialize root Modules directory"
done

rg -q 'scripts/package-godot-addon "\$tag" "\$output_dir/SwiftGodot\.xcframework" "\$output_dir/SwiftGodotEmbed\.xcframework" "\$android_aar" "\$output_dir"' "$release_script" || fail "release script must package the Godot addon from Apple artifacts and the Android AAR"
rg -q 'SwiftGodot-\$tag\.zip' "$release_script" || fail "release script must name the addon zip SwiftGodot-\$tag.zip"
rg -q 'gh release create "\$tag" "\$zip_path" "\$gdextension_zip_path" "\$macro_zip_path" "\$android_aar" "\$addon_zip_path"' "$release_script" || fail "release script must upload the binary artifacts, Android AAR, and addon zip"
if rg -q 'no longer using vXXX|v-prefixed tags|\[\[ "\$RELEASE_TAG" == v\* \]\]' "$release_script" .github/workflows/release.yml; then
    fail "release path must allow v-prefixed tags for Godot addon assets"
fi
rg -q '^package-godot-addon:' Makefile || fail "Makefile must expose package-godot-addon"
rg -q 'scripts/package-godot-addon "\$\$tag" "\$\$xcframework" "\$\$embed_xcframework" "\$\$android_aar" "\$\$output_dir"' Makefile || fail "Makefile must pass the Android AAR to package-godot-addon"
rg -q 'scripts/test-package-godot-addon' "$swift_workflow" || fail "CI must run package-godot-addon regression tests"

echo "Godot addon packaging tests passed"
