#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: scripts/build-android-libraries OUTPUT_DIR" >&2
}

if [[ $# -ne 1 ]]; then
    usage
    exit 2
fi

script_dir=$(cd "$(dirname "$0")" && pwd)
repository_root=$(cd "$script_dir/.." && pwd)
# shellcheck source=android-config
source "$script_dir/android-config"
# shellcheck source=android-abis
source "$script_dir/android-abis"

output_dir=$1
swift_command=${SWIFT_GODOT_SWIFT_COMMAND:-swift}
java_command=${SWIFT_GODOT_JAVA_COMMAND:-java}
work_dir=${SWIFT_GODOT_ANDROID_WORK_DIR:-"$repository_root/.build/android-distribution"}
staged_package=${SWIFT_GODOT_ANDROID_PACKAGE:-"$work_dir/package"}
scratch_root=${SWIFT_GODOT_ANDROID_SCRATCH_ROOT:-"$work_dir/build"}

die() {
    echo "Error: $*" >&2
    exit 1
}

case "$output_dir" in
    ""|/|"$repository_root") die "refusing unsafe output directory: $output_dir" ;;
esac

selected_abis=$(android_selected_abis) || die "invalid Android ABI selection"

swift_version=$($swift_command --version 2>&1) || die "unable to run $swift_command"
printf '%s\n' "$swift_version" | grep -Eq "Swift version ${SWIFT_ANDROID_VERSION}([[:space:]]|$)" ||
    die "Swift ${SWIFT_ANDROID_VERSION} is required; found: $(printf '%s' "$swift_version" | head -1)"

sdk_list=$($swift_command sdk list 2>&1) || die "unable to list installed Swift SDKs"
printf '%s\n' "$sdk_list" | grep -Fq "$SWIFT_ANDROID_SDK_ID" ||
    die "required Swift SDK is not installed: $SWIFT_ANDROID_SDK_ID"

[[ -n "${ANDROID_HOME:-}" && -d "$ANDROID_HOME" ]] ||
    die "ANDROID_HOME must name an installed Android SDK"
[[ -n "${ANDROID_NDK_ROOT:-}" && -d "$ANDROID_NDK_ROOT" ]] ||
    die "ANDROID_NDK_ROOT must name Android NDK $SWIFT_ANDROID_NDK_VERSION"

ndk_revision=
if [[ -f "$ANDROID_NDK_ROOT/source.properties" ]]; then
    ndk_revision=$(sed -n 's/^Pkg\.Revision[[:space:]]*=[[:space:]]*//p' "$ANDROID_NDK_ROOT/source.properties" | head -1)
fi
[[ "$ndk_revision" == "$SWIFT_ANDROID_NDK_VERSION" ]] ||
    die "Android NDK $SWIFT_ANDROID_NDK_VERSION is required; found: ${ndk_revision:-unknown}"

java_version=$($java_command -version 2>&1) || die "unable to run Java"
printf '%s\n' "$java_version" | grep -Eq 'version "17([.]|"|$)' ||
    die "JDK 17 is required; found: $(printf '%s' "$java_version" | head -1)"

if [[ -n "${SWIFT_GODOT_ANDROID_CLEAN:-}" ]]; then
    rm -rf "$scratch_root"
fi
mkdir -p "$work_dir" "$scratch_root"

# A pre-staged package lets several single-ABI jobs share one generation pass.
if [[ -n "${SWIFT_GODOT_ANDROID_PACKAGE:-}" ]]; then
    [[ -f "$staged_package/Package.swift" ]] ||
        die "pre-staged Android package is missing Package.swift: $staged_package"
else
    rm -rf "$staged_package"
    "$script_dir/generate-android-package" "$staged_package"
fi

rm -rf "$output_dir"
mkdir -p "$output_dir/jni"

for abi in $selected_abis; do
    triple=$(android_triple_for_abi "$abi") || die "unsupported Android ABI: $abi"

    abi_scratch="$scratch_root/$abi"
    mkdir -p "$output_dir/jni/$abi"
    for product in SwiftGodot SwiftGodotEmbed; do
        echo "Building $product for $abi ($triple)..."
        "$swift_command" build \
            --package-path "$staged_package" \
            --scratch-path "$abi_scratch" \
            -c release \
            --swift-sdk "$triple" \
            --product "$product"

        library=$(find "$abi_scratch" -type f -name "lib${product}.so" -print -quit)
        [[ -n "$library" ]] || die "build did not emit lib${product}.so for $abi"
        cp "$library" "$output_dir/jni/$abi/lib${product}.so"
    done
done

if [[ -z "${SWIFT_GODOT_SKIP_ELF_VALIDATION:-}" ]]; then
    "$script_dir/stage-android-runtime-libraries" "$output_dir/jni"
    "$script_dir/strip-android-elf" "$output_dir/jni"
    "$script_dir/validate-android-elf" "$output_dir/jni"
fi

echo "Android libraries staged at $output_dir/jni"
