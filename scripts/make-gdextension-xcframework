#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 ]]; then
    echo "Usage: scripts/make-gdextension-xcframework ROOT OUTPUT_DIR" >&2
    exit 1
fi

repository_root=$(cd "$(dirname "$0")/.." && pwd)
derived_data=${1%/}
output_dir=${2%/}
configuration=${SWIFT_GODOT_CONFIGURATION:-Release}
bd_mac="$derived_data/Build/Products/$configuration"
bd_mac_x86="${derived_data}_x86/Build/Products/$configuration"
bd_ios="$derived_data/Build/Products/$configuration-iphoneos"
bd_ios_sim="$derived_data/Build/Products/$configuration-iphonesimulator"
stage_root=$(mktemp -d)

cleanup() {
    rm -rf "$stage_root"
}
trap cleanup EXIT

require_path() {
    if [[ ! -e "$1" ]]; then
        echo "Missing required release artifact: $1" >&2
        exit 1
    fi
}

output="$output_dir/GDExtensionC.xcframework"
headers="$stage_root/headers"
mac_object="$bd_mac/GDExtensionC.o"
mac_library="$stage_root/macos/libGDExtensionC.a"
ios_library="$stage_root/ios/libGDExtensionC.a"
ios_sim_library="$stage_root/ios-simulator/libGDExtensionC.a"

require_path "$mac_object"
require_path "$bd_ios/GDExtensionC.o"
require_path "$bd_ios_sim/GDExtensionC.o"

mkdir -p "$output_dir" "$headers" "$(dirname "$mac_library")" "$(dirname "$ios_library")" "$(dirname "$ios_sim_library")"
cp "$repository_root/Sources/GDExtension/GDExtension.h" "$headers/"
cp "$repository_root/Sources/GDExtension/include/GDExtensionSupport.h" "$headers/"
cp "$repository_root/Sources/GDExtension/include/gdextension_interface.h" "$headers/"
cat > "$headers/module.modulemap" <<'EOF'
module GDExtensionC {
    umbrella "."
    export *
}
EOF

if [[ -e "$bd_mac_x86/GDExtensionC.o" ]]; then
    lipo -create "$mac_object" "$bd_mac_x86/GDExtensionC.o" -output "$stage_root/GDExtensionC-universal.o"
    mac_object="$stage_root/GDExtensionC-universal.o"
fi

libtool -static -o "$mac_library" "$mac_object"
libtool -static -o "$ios_library" "$bd_ios/GDExtensionC.o"
libtool -static -o "$ios_sim_library" "$bd_ios_sim/GDExtensionC.o"

rm -rf "$output"
xcodebuild -quiet -create-xcframework \
    -library "$mac_library" -headers "$headers" \
    -library "$ios_library" -headers "$headers" \
    -library "$ios_sim_library" -headers "$headers" \
    -output "$output"

echo "generated $output"
