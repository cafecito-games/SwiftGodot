#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: scripts/validate-android-elf JNI_ROOT [SWIFTGODOT_CONSUMER.so ...]" >&2
}

if [[ $# -lt 1 ]]; then
    usage
    exit 2
fi

jni_root=$1
shift
ndk_root=${ANDROID_NDK_ROOT:-}

die() {
    echo "Error: $*" >&2
    exit 1
}

[[ -d "$jni_root" ]] || die "JNI root does not exist: $jni_root"
[[ -n "$ndk_root" && -d "$ndk_root" ]] || die "ANDROID_NDK_ROOT must name an Android NDK"

readelf_tool=$(find "$ndk_root/toolchains/llvm/prebuilt" -path '*/bin/llvm-readelf' -print -quit)
[[ -x "$readelf_tool" ]] || die "llvm-readelf not found below ANDROID_NDK_ROOT"

is_system_library() {
    case "$1" in
        libc.so|libdl.so|liblog.so|libm.so|libz.so|libandroid.so|libEGL.so|libGLESv2.so|libGLESv3.so|libOpenSLES.so|libvulkan.so|ld-android.so|linker|linker64)
            return 0
            ;;
        *) return 1 ;;
    esac
}

needed_libraries() {
    "$readelf_tool" -d "$1" | sed -n 's/.*Shared library: \[\([^]]*\)\].*/\1/p'
}

for abi in arm64-v8a x86_64; do
    abi_dir="$jni_root/$abi"
    [[ -d "$abi_dir" ]] || die "missing ABI directory: $abi"
    [[ -f "$abi_dir/libSwiftGodot.so" ]] || die "missing $abi/libSwiftGodot.so"
    [[ -f "$abi_dir/libSwiftGodotEmbed.so" ]] || die "missing $abi/libSwiftGodotEmbed.so"

    case "$abi" in
        arm64-v8a) expected_machine='AArch64' ;;
        x86_64) expected_machine='Advanced Micro Devices X86-64' ;;
    esac

    while IFS= read -r library; do
        header=$($readelf_tool -h "$library") || die "unable to read ELF header: $library"
        printf '%s\n' "$header" | grep -Fq "Machine:                           $expected_machine" ||
            die "$abi library has wrong machine architecture: $(basename "$library")"

        dynamic=$($readelf_tool -d "$library") || die "unable to read dynamic table: $library"
        soname=$(printf '%s\n' "$dynamic" | sed -n 's/.*Library soname: \[\([^]]*\)\].*/\1/p' | head -1)
        [[ -n "$soname" ]] || die "missing SONAME: $abi/$(basename "$library")"
        [[ "$soname" == "$(basename "$library")" ]] ||
            die "SONAME mismatch for $abi/$(basename "$library"): $soname"

        while IFS= read -r dependency; do
            [[ -n "$dependency" ]] || continue
            if ! is_system_library "$dependency" && [[ ! -f "$abi_dir/$dependency" ]]; then
                die "unresolved DT_NEEDED $dependency required by $abi/$(basename "$library")"
            fi
        done < <(needed_libraries "$library")
    done < <(find "$abi_dir" -maxdepth 1 -type f -name '*.so' -print | sort)

    symbols=$($readelf_tool -Ws "$abi_dir/libSwiftGodotEmbed.so") ||
        die "unable to read symbols: $abi/libSwiftGodotEmbed.so"
    printf '%s\n' "$symbols" | grep -Eq '[[:space:]]swift_godot_embed_entry_point$' ||
        die "$abi/libSwiftGodotEmbed.so does not export swift_godot_embed_entry_point"
done

for consumer in "$@"; do
    [[ -f "$consumer" ]] || die "consumer library does not exist: $consumer"
    needed_libraries "$consumer" | grep -Fxq 'libSwiftGodot.so' ||
        die "consumer does not declare libSwiftGodot.so in DT_NEEDED: $consumer"
done

echo "Android ELF validation passed: $jni_root"
