[configuration]

entry_symbol = "swift_godot_embed_entry_point"
compatibility_minimum = 4.7
android_aar_plugin = true

[libraries]

android.debug.arm64 = "res://addons/SwiftGodot/bin/arm64-v8a/libSwiftGodotEmbed.so"
android.release.arm64 = "res://addons/SwiftGodot/bin/arm64-v8a/libSwiftGodotEmbed.so"
android.debug.x86_64 = "res://addons/SwiftGodot/bin/x86_64/libSwiftGodotEmbed.so"
android.release.x86_64 = "res://addons/SwiftGodot/bin/x86_64/libSwiftGodotEmbed.so"
